# ============================================================================
#  .env de PRODUCCION - se CONSTRUYE en el server (docker compose up --build)
#  con BD EXTERNA por DNS. Copielo como .env junto al compose.
#  NO lo suba a git (contiene secretos). Permisos recomendados: chmod 600 .env
#
#  Compose:  docker-compose.deploy.external-db.yml
#  Arranque: docker compose -f docker-compose.deploy.external-db.yml up -d --build
# ============================================================================

# --- Base de datos EXTERNA (por DNS). La base YA existe: no se toca. ---
POSTGRES_HOST=db-prod.tu-dominio.net
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__cambiar__
POSTGRES_DB=afiliaciones

COMPAT_POSTGRES_HOST=db-prod.tu-dominio.net
COMPAT_POSTGRES_PORT=5432
COMPAT_POSTGRES_USER=postgres
COMPAT_POSTGRES_PASSWORD=__cambiar__

# --- Archivado fisico de documentos en el HOST (confirmar disco de PRODUCCION) ---
# OJO: en pruebas es img10; produccion puede usar OTRO disco (img11, etc.).
# LEGACY_IMG_EXPECTED_NDISCO debe coincidir con server.ndisco de img004 o el
# archivado lanza 500 (guarda de seguridad).
LEGACY_IMG_EXPECTED_NDISCO=img10
LEGACY_IMG_HOST_MOUNT=/imagenes3/img10

# --- Puertos publicados en el host (detras de un reverse-proxy con TLS) ---
FRONTEND_PORT=8105
BACKEND_PORT=8000
COMPAT_BACKEND_PORT=8011

# --- Dominio publico (enlaces de notificaciones/correo) ---
FRONTEND_URL=https://afiliaciones.tu-dominio.net

# --- Correo real (en pruebas iba deshabilitado) ---
NOTIFICATION_ENABLED=true
NOTIFICATION_SENDER_EMAIL=no-reply@tu-dominio.net
NOTIFICATION_SENDER_NAME=Imagine S.A.S.
SMTP_HOST=smtp.tu-dominio.net
SMTP_PORT=587
SMTP_USERNAME=__cambiar__
SMTP_PASSWORD=__cambiar__
SMTP_USE_TLS=true
