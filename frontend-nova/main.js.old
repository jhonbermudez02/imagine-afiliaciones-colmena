function toggleSection(section, shouldShow) {
    if (!section) return;
    section.classList.toggle('hidden', !shouldShow);
}

function syncProcessDashboardPanels(hasActiveCase = false) {
    const showDashboardPanels = !hasActiveCase;
    toggleSection(queueSection, showDashboardPanels);
    toggleSection(recover926Section, showDashboardPanels);
    toggleSection(failedPrecheckSection, showDashboardPanels);
}

if (buildStatus) {
    buildStatus.textContent = FRONTEND_BUILD_ID;
    buildStatus.title = `Versión publicada del frontend: ${FRONTEND_BUILD_ID}`;
}

function describeCity(code) {
    const digits = String(code || '').replace(/\D/g, '');
    if (!digits) return 'n/d';
    const padded = digits.padStart(5, '0');
    return cityNames[padded] ? `${digits} · ${cityNames[padded]}` : digits;
}

function formatDurationMs(value) {
    const ms = Number(value);
    if (!Number.isFinite(ms) || ms < 0) return 'n/d';
    if (ms < 1000) return `${ms} ms`;
    const seconds = ms / 1000;
    if (seconds < 60) return `${seconds.toFixed(1)} s`;
    const minutes = Math.floor(seconds / 60);
    const remSeconds = Math.round(seconds % 60);
    return `${minutes} min ${remSeconds} s`;
}

function localizeStatusLabel(value) {
    const normalized = String(value || '').trim().toLowerCase();
    const mapping = {
        uploaded: 'cargado',
        completed: 'completado',
        blocked: 'bloqueado',
        failed: 'fallido',
        pending: 'pendiente',
        analyzed: 'analizado',
        stopped_prevalidacion: 'No Paso La Prevalidacion',
        ok: 'ok',
        degraded: 'degradado',
    };
    return mapping[normalized] || String(value || 'n/d');
}

function escapeHtml(value) {
    return String(value || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
}

function readTesterIdentity() {
    try {
        const payload = JSON.parse(window.localStorage.getItem(TESTER_IDENTITY_KEY) || '{}');
        return {
            email: String(payload?.email || '').trim().toLowerCase(),
            name: String(payload?.name || '').trim(),
        };
    } catch (error) {
        return { email: '', name: '' };
    }
}

function readActiveProfile() {
    try {
        const value = String(window.localStorage.getItem(PROFILE_KEY) || '').trim().toLowerCase();
        return value === 'colmena' ? 'colmena' : (value === 'imagine' ? 'imagine' : '');
    } catch (error) {
        return '';
    }
}

function persistActiveProfile(profile = '') {
    const normalized = String(profile || '').trim().toLowerCase();
    try {
        if (normalized === 'imagine' || normalized === 'colmena') {
            window.localStorage.setItem(PROFILE_KEY, normalized);
        } else {
            window.localStorage.removeItem(PROFILE_KEY);
        }
    } catch (error) {
        console.error('No pude persistir el perfil activo:', error);
    }
}

function getProfileLabel(profile = '') {
    return String(profile || '').toLowerCase() === 'colmena' ? 'Colmena' : (String(profile || '').toLowerCase() === 'imagine' ? 'Imagine' : 'Sin perfil');
}

function getPreferredHomeView(profile = readActiveProfile()) {
    return String(profile || '').toLowerCase() === 'colmena' ? 'productionView' : 'processView';
}

function normalizeCaseFinalStatus(value = '') {
    return normalizeClientText(String(value || ''));
}

function isCaseReadyForColmena(item = {}) {
    const meta = item && typeof item === 'object' && !item.analysis ? {
        status: item.status || 'n/d',
        finalStatus: item.final_status || localizeStatusLabel(item.status),
        has926: Boolean(item.has_926),
    } : resolveProductionCaseSummary(item);
    const workflowStatus = normalizeClientText(meta.status || '');
    const finalStatus = normalizeCaseFinalStatus(meta.finalStatus || '');
    return workflowStatus === 'completed'
        && (
            finalStatus === 'aprobado'
            || finalStatus === 'aprobada'
            || finalStatus === 'completado'
            || finalStatus === 'ok'
        );
}

function persistTesterIdentity(identity = {}) {
    const payload = {
        email: String(identity.email || '').trim().toLowerCase(),
        name: String(identity.name || '').trim(),
    };
    try {
        window.localStorage.setItem(TESTER_IDENTITY_KEY, JSON.stringify(payload));
    } catch (error) {
        console.error('No pude persistir el tester activo:', error);
    }
}

function openTesterLogin() {
    testerLoginScreen?.classList.remove('hidden');
}

function closeTesterLogin() {
    testerLoginScreen?.classList.add('hidden');
}

function renderTesterLoginOptions() {
    if (!testerLoginGrid) return;
    if (!testerRoster.length) {
        testerLoginGrid.innerHTML = '<div class="source-item">No pude cargar la lista de testers.</div>';
        return;
    }
    const activeProfile = readActiveProfile();
    testerLoginGrid.innerHTML = testerRoster.map((item) => `
        <button class="tester-login-option ${activeProfile ? '' : 'is-disabled'}" type="button" data-tester-email="${escapeHtml(item.email)}" aria-label="Ingresar como ${escapeHtml(item.name || item.email)}">
            <strong>${escapeHtml(item.name || item.email)}</strong>
            <span>${escapeHtml(item.email || '')}</span>
        </button>
    `).join('');
}

function renderProfileOptions() {
    if (!testerRoleGrid) return;
    const activeProfile = readActiveProfile();
    testerRoleGrid.querySelectorAll('[data-profile]').forEach((button) => {
        button.classList.toggle('is-active', button.getAttribute('data-profile') === activeProfile);
    });
}

function syncFeedbackNameFromTester() {
    const tester = readTesterIdentity();
    if (feedbackNameInput && tester.name) {
        feedbackNameInput.value = tester.name;
    }
}

function hasCompleteSession() {
    const tester = readTesterIdentity();
    const profile = readActiveProfile();
    return Boolean(tester.email && tester.name && profile);
}

function updateTesterStatus() {
    const tester = readTesterIdentity();
    const profile = readActiveProfile();
    if (profileStatus) {
        profileStatus.textContent = getProfileLabel(profile);
    }
    if (testerStatus) {
        testerStatus.textContent = tester.name ? tester.name : 'Sin identificar';
    }
    if (testerSelect) {
        testerSelect.value = tester.email || '';
    }
    syncFeedbackNameFromTester();
    renderProfileOptions();
    renderTesterLoginOptions();
    if (testerLoginGrid) {
        testerLoginGrid.classList.toggle('hidden', !profile);
    }
    if (testerLoginNote) {
        if (!profile) {
            testerLoginNote.textContent = 'Paso 1: selecciona el perfil con el que vas a trabajar.';
        } else if (!tester.email) {
            testerLoginNote.textContent = `Paso 2: perfil ${getProfileLabel(profile)} seleccionado. Ahora elige tu tarjeta de usuario para entrar.`;
        } else {
            testerLoginNote.textContent = `Sesión lista: ${getProfileLabel(profile)} · ${tester.name || tester.email}.`;
        }
    }
    if (testerKeepSessionButton) {
        testerKeepSessionButton.classList.toggle('hidden', !hasCompleteSession());
    }
    applyProfileMode();
    applyProfileNavigation();
    const productionViewActive = document.getElementById('productionView')?.classList.contains('active');
    if (productionCasesContent && hasBootstrappedProductionView && productionViewActive) {
        loadProductionCases();
    }
}

function clearSessionIdentity() {
    activeCaseId = null;
    activeCasePayload = null;
    selectedColmenaCaseIds = new Set();
    clearProcessState();
    persistTesterIdentity({ email: '', name: '' });
    persistActiveProfile('');
    updateTesterStatus();
    openTesterLogin();
}

async function logTesterActivity(action, metadata = {}) {
    const tester = readTesterIdentity();
    if (!tester.email || !action) return;
    const profile = readActiveProfile();
    try {
        await fetch(`${API_URL}/api/test-activity`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                tester_email: tester.email,
                tester_name: tester.name,
                action,
                metadata: { ...metadata, profile },
            }),
        });
    } catch (error) {
        console.error('No pude registrar actividad del tester:', error);
    }
}

function ensureTesterSelected(contextLabel = 'continuar') {
    const tester = readTesterIdentity();
    const profile = readActiveProfile();
    if (tester.email && tester.name && profile) return { ...tester, profile };
    const message = 'Selecciona primero el perfil y luego la tarjeta del tester antes de continuar.';
    if (caseStatusLine && ['cargar contrato', 'ejecutar proceso'].includes(String(contextLabel).toLowerCase())) {
        stopCaseProgress(message, true);
    } else {
        addMessage(message, 'nova');
    }
    openTesterLogin();
    return null;
}

function applyProfileMode() {
    const profile = readActiveProfile();
    const isColmena = profile === 'colmena';
    if (runWorkflowInlineButton) {
        runWorkflowInlineButton.disabled = isColmena;
        runWorkflowInlineButton.title = isColmena ? 'El perfil Colmena no ejecuta la carga inicial del contrato.' : '';
    }
    if (packageFilesInput) {
        packageFilesInput.disabled = isColmena;
    }
    if (colmenaBatchSection) {
        colmenaBatchSection.classList.toggle('hidden', !isColmena);
    }
    const processActions = document.querySelector('.portal-band-summary .dossier-actions');
    processActions?.classList.toggle('is-colmena', isColmena);
    if (caseStatusLine && isColmena && !activeCaseId) {
        caseStatusLine.textContent = 'Perfil Colmena: entra a Producción para ver los contratos procesados por Imagine pendientes por revisar, validar y generar plano.';
    } else if (caseStatusLine && !activeCaseId) {
        caseStatusLine.textContent = defaultProcessStatusText();
    }
}

function syncSessionLandingView() {
    if (!hasCompleteSession() || activeCaseId) return;
    switchView(getPreferredHomeView());
}

function applyProfileNavigation() {
    const profile = readActiveProfile();
    const hiddenForColmena = new Set(['processView', 'classificationView', 'reportView', 'adminView']);
    viewSwitcher?.querySelectorAll('[data-view]').forEach((button) => {
        const viewId = String(button.dataset.view || '');
        const shouldHide = profile === 'colmena' && hiddenForColmena.has(viewId);
        button.classList.toggle('hidden', shouldHide);
    });
    const activeView = Array.from(workspaceViews).find((section) => section.classList.contains('active'))?.id || '';
    if (profile === 'colmena' && hiddenForColmena.has(activeView) && !activeCaseId) {
        switchView('productionView');
    }
}

async function loadTesterRoster() {
    try {
        const response = await fetch(`${API_URL}/api/testers`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        testerRoster = Array.isArray(data.items) ? data.items : [];
        if (testerSelect) {
            testerSelect.innerHTML = '<option value="">Selecciona tu nombre</option>' + testerRoster.map((item) => (
                `<option value="${escapeHtml(item.email)}">${escapeHtml(item.name || item.email)}</option>`
            )).join('');
        }
        renderTesterLoginOptions();
        updateTesterStatus();
        const tester = readTesterIdentity();
        const profile = readActiveProfile();
        if (!tester.email || !profile) {
            openTesterLogin();
        }
    } catch (error) {
        console.error('No pude cargar el roster de testers:', error);
    }
}

function renderTesterSummary(summary) {
    if (!testerSummaryContent) return;
    const items = Array.isArray(summary?.items) ? summary.items : [];
    if (!items.length) {
        testerSummaryContent.innerHTML = '<div class="source-item">No hay actividad registrada para hoy.</div>';
        return;
    }
    testerSummaryContent.innerHTML = `
        <div class="tester-summary-grid">
            <div class="tester-summary-stat"><strong>${summary.total_events || 0}</strong><span>Total eventos</span></div>
            <div class="tester-summary-stat"><strong>${summary.active_testers || 0}</strong><span>Testers activos</span></div>
            <div class="tester-summary-stat"><strong>${summary.inactive_count || 0}</strong><span>Sin actividad</span></div>
        </div>
        <div class="tester-summary-list">
            ${items.map((item) => `
                <article class="tester-summary-row ${Number(item.total_actions || 0) === 0 ? 'is-inactive' : ''}">
                    <div class="tester-summary-name">
                        <strong>${escapeHtml(item.name || item.email)}</strong>
                        <span>${escapeHtml(item.email || '')}${item.last_activity ? ` · Última: ${escapeHtml(formatUiDateTime(item.last_activity))}` : ''}</span>
                    </div>
                    <div class="tester-summary-metric"><strong>${item.total_actions || 0}</strong><span>Eventos</span></div>
                    <div class="tester-summary-metric"><strong>${item.cases_created || 0}</strong><span>Contratos</span></div>
                    <div class="tester-summary-metric"><strong>${item.workflow_started || 0}</strong><span>Ejecuciones</span></div>
                    <div class="tester-summary-metric"><strong>${item.searches || 0}</strong><span>Búsquedas</span></div>
                    <div class="tester-summary-metric"><strong>${item.feedback_notes || 0}</strong><span>Comentarios</span></div>
                    <div class="tester-summary-metric"><strong>${item.reports_opened || 0}</strong><span>Reportes</span></div>
                </article>
            `).join('')}
        </div>
    `;
}

async function loadTesterSummary() {
    if (!testerSummaryContent) return;
    testerSummaryContent.innerHTML = '<div class="source-item">Cargando actividad...</div>';
    try {
        const response = await fetch(`${API_URL}/api/test-activity/summary`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        renderTesterSummary(data);
    } catch (error) {
        console.error('No pude cargar el resumen de testers:', error);
        testerSummaryContent.innerHTML = '<div class="source-item">No pude cargar el resumen de actividad.</div>';
    }
}

async function sendTesterSummary() {
    if (!sendTesterSummaryButton) return;
    const original = sendTesterSummaryButton.textContent;
    sendTesterSummaryButton.disabled = true;
    sendTesterSummaryButton.textContent = 'Enviando...';
    try {
        const response = await fetch(`${API_URL}/api/test-activity/send-summary`, { method: 'POST' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        sendTesterSummaryButton.textContent = data.delivery === 'sent' ? 'Enviado' : String(data.delivery || 'Procesado');
        await loadTesterSummary();
    } catch (error) {
        console.error('No pude enviar el resumen diario:', error);
        sendTesterSummaryButton.textContent = 'Error';
    } finally {
        setTimeout(() => {
            sendTesterSummaryButton.disabled = false;
            sendTesterSummaryButton.textContent = original;
        }, 1400);
    }
}

function updatePackageFilesLabel(files = []) {
    if (!packageFilesLabel) return;
    if (!files.length) {
        packageFilesLabel.textContent = 'Ningún archivo seleccionado.';
        return;
    }
    if (files.length === 1) {
        packageFilesLabel.textContent = `Archivo seleccionado: ${files[0].name}`;
        return;
    }
    packageFilesLabel.textContent = `${files.length} archivos seleccionados. Último archivo: ${files[files.length - 1].name}`;
}

function isConnectionErrorMessage(value) {
    const text = String(value || '').trim().toLowerCase();
    return text.includes('failed to fetch')
        || text.includes('networkerror')
        || text.includes('load failed')
        || text.includes('network request failed')
        || text.includes('the network connection was lost');
}

function getFriendlyConnectionMessage(context) {
    const base = 'Se perdió la conexión con la plataforma.';
    if (context === 'queue') return `${base} No pude refrescar la cola de ejecución en este momento.`;
    if (context === 'production') return `${base} No pude refrescar la lista de contratos en este momento.`;
    if (context === 'precheck-failed') return `${base} No pude refrescar los contratos no aprobados en este momento.`;
    if (context === 'upload') return `${base} No pude confirmar el cargue del contrato.`;
    if (context === 'workflow') return `${base} La prevalidación pudo seguir corriendo en segundo plano.`;
    return base;
}

function getFriendlyRequestError(detail, context = '') {
    const normalized = String(detail || '').trim();
    const lower = normalized.toLowerCase();
    if (isConnectionErrorMessage(lower)) {
        return context ? getFriendlyConnectionMessage(context) : 'Se perdió la conexión con la plataforma.';
    }
    if (lower.includes('request entity too large') || lower.includes('413')) {
        return 'El paquete supera el tamaño máximo permitido por la plataforma. Divide los archivos o reduce el peso del paquete e inténtalo de nuevo.';
    }
    if (lower === 'not found' || lower === '404' || lower === 'http 404') {
        return 'La plataforma respondió con una ruta no encontrada. Recarga la página e inténtalo de nuevo.';
    }
    if (lower.includes('502') || lower.includes('bad gateway')) {
        return 'La plataforma no logró comunicarse con el servicio de validación en ese momento. Inténtalo de nuevo en unos segundos.';
    }
    if (lower.includes('503') || lower.includes('service unavailable')) {
        return 'La plataforma está ocupada o reiniciándose. Inténtalo de nuevo en unos segundos.';
    }
    return normalized;
}

function buildExecutiveReportText(estado, empresa, nit, trabajadores, sedes) {
    return [
        `Estado final: ${estado || 'n/d'}`,
        `Afiliado: ${empresa || 'n/d'}`,
        `NIT: ${nit || 'n/d'}`,
        `Trabajadores: ${trabajadores ?? 'n/d'}`,
        `Sedes: ${sedes ?? 'n/d'}`,
    ].join('\n');
}

function formatUiDateTime(value) {
    if (!value) return 'n/d';
    const parsed = new Date(value);
    if (Number.isNaN(parsed.getTime())) return String(value);
    return parsed.toLocaleString('es-CO', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
    });
}

async function fetchWithRetry(url, options = {}, attempts = 3, delayMs = 350) {
    let lastError = null;
    for (let attempt = 1; attempt <= attempts; attempt += 1) {
        const controller = new AbortController();
        const externalSignal = options.signal;
        const timeoutMs = Number(options.timeoutMs || 12000);
        const timer = setTimeout(() => controller.abort(new DOMException('La solicitud tardó demasiado.', 'AbortError')), timeoutMs);
        const abortFromExternalSignal = () => {
            const reason = externalSignal?.reason instanceof Error
                ? externalSignal.reason
                : new DOMException('La solicitud fue cancelada.', 'AbortError');
            controller.abort(reason);
        };
        try {
            if (externalSignal?.aborted) {
                abortFromExternalSignal();
            } else if (externalSignal) {
                externalSignal.addEventListener('abort', abortFromExternalSignal, { once: true });
            }
            const response = await fetch(url, {
                ...options,
                signal: controller.signal,
            });
            clearTimeout(timer);
            if (externalSignal) {
                externalSignal.removeEventListener('abort', abortFromExternalSignal);
            }
            if (!response.ok) {
                const detail = await extractErrorDetail(response);
                throw new Error(detail || `HTTP ${response.status}`);
            }
            return response;
        } catch (error) {
            clearTimeout(timer);
            if (externalSignal) {
                externalSignal.removeEventListener('abort', abortFromExternalSignal);
            }
            lastError = error;
            if (attempt >= attempts) break;
            await new Promise((resolve) => setTimeout(resolve, delayMs * attempt));
        }
    }
    throw lastError || new Error('No pude completar la solicitud.');
}

async function extractErrorDetail(response) {
    if (!response) return '';
    const contentType = String(response.headers?.get?.('content-type') || '').toLowerCase();
    try {
        if (contentType.includes('application/json')) {
            const payload = await response.json();
            const detail = payload?.detail;
            if (detail && typeof detail === 'object') {
                const parts = [];
                if (detail.message) parts.push(String(detail.message).trim());
                const rejected = Array.isArray(detail.rejected_files) ? detail.rejected_files : [];
                if (rejected.length) {
                    parts.push(
                        'Archivos omitidos: ' + rejected.map((item) => {
                            const filename = String(item?.filename || 'archivo');
                            const reason = String(item?.reason || 'sin detalle');
                            return `${filename} (${reason})`;
                        }).join('; ')
                    );
                }
                const accepted = Array.isArray(detail.accepted_files) ? detail.accepted_files : [];
                if (accepted.length) {
                    parts.push(`Archivos válidos detectados: ${accepted.join(', ')}`);
                }
                return parts.join(' ').trim();
            }
            return String(detail || payload?.message || payload?.error || '').trim();
        }
        return String(await response.text()).trim();
    } catch {
        return '';
    }
}

function normalizeClientText(value = '') {
    return String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
}

function normalizeReviewLabel(text = '') {
    const raw = String(text || '').trim();
    const normalized = normalizeClientText(raw);
    if (!raw) return '';
    if (/^prueba rpa \d+$/i.test(raw) || normalized.startsWith('rpa test ') || normalized === 'rpa test') {
        return 'Prueba automatizada de interfaz';
    }
    if (normalized.includes('servicios demo')) {
        return raw.replace(/Servicios Demo/gi, 'Caso de prueba');
    }
    return raw.replace(/\btest\b/gi, 'prueba');
}

function resolvePrecheckDisplayStatus(casePayload = activeCasePayload, report = null) {
    const analysis = casePayload?.analysis || {};
    const workflow = analysis.workflow_run || {};
    const decision = analysis.decision || {};
    if (String(workflow.status || '').toLowerCase() === 'stopped_prevalidacion') {
        return 'NO APROBADA';
    }
    if (String(decision.recommended_status || '').toLowerCase() === 'aprobable') {
        return 'APROBADA';
    }
    if (String(decision.recommended_status || '').toLowerCase() === 'observado') {
        return 'NO APROBADA';
    }
    const reportState = String(report?.resumen_ejecutivo?.estado || report?.estado_final || '').trim();
    return reportState || 'n/d';
}

function buildCaseFileUrl(caseId, filename) {
    return `${API_URL}/api/cases/${encodeURIComponent(caseId)}/files/${filename.split('/').map(encodeURIComponent).join('/')}`;
}

function buildCaseFileRequestUrl(caseId, filename, downloadName = '', inlineView = false) {
    const url = new URL(buildCaseFileUrl(caseId, filename), window.location.origin);
    if (downloadName) {
        url.searchParams.set('download_name', downloadName);
    }
    if (inlineView) {
        url.searchParams.set('inline', '1');
    }
    return url.toString();
}

function buildCase926Url(caseId) {
    return `${API_URL}/api/cases/${encodeURIComponent(caseId)}/926`;
}

function formatCaseHandle(caseId = '', label = '') {
    const normalizedId = String(caseId || '').trim();
    const normalizedLabel = String(label || '').trim();
    if (!normalizedId) return 'Caso n/d';
    const visibleId = normalizedId.replace(/^case-/, '');
    const prefix = /\.(xlsx|xls|xlsm|pdf|zip)$/i.test(normalizedLabel) || normalizedLabel
        ? 'Lote'
        : 'Caso';
    return `${prefix} ${visibleId}`;
}

function resolveContractIdentifier(profile = {}, fallbackCaseId = '') {
    const nit = String(profile?.nit || '').trim();
    const documento = String(profile?.documento || '').trim();
    if (nit && nit.toLowerCase() !== 'n/d') return nit;
    if (documento && documento.toLowerCase() !== 'n/d') return documento;
    return String(fallbackCaseId || '').replace(/^case-/, '') || 'n/d';
}

function resolveContractDisplayName(casePayload = null) {
    const payload = casePayload || activeCasePayload || {};
    const analysis = payload.analysis || {};
    const profile = ((analysis.xlsx_profile || {}).profile || {});
    const empresa = String(profile.empresa || payload.label || payload.id || 'Contrato').trim();
    const identifier = resolveContractIdentifier(profile, payload.id || '');
    return {
        empresa,
        identifier,
        shortLabel: `Contrato ${identifier}`,
        fullLabel: `Contrato ${identifier} · ${empresa}`,
    };
}

function extractCaseIdFromSourceUrl(url = '') {
    const match = String(url || '').match(/\/api\/cases\/([^/]+)\//);
    return match ? decodeURIComponent(match[1]) : '';
}

function buildQuickSourceGroups(sources = []) {
    const priority = ['cedula', 'rut', 'camara_comercio', 'formulario_afiliacion'];
    const labels = {
        cedula: 'Abrir cédula',
        rut: 'Abrir RUT',
        camara_comercio: 'Abrir cámara',
        formulario_afiliacion: 'Abrir formulario',
    };
    const firstByType = new Map();
    for (const source of sources) {
        const type = String(source?.document_type || '').trim();
        if (!type || firstByType.has(type)) continue;
        firstByType.set(type, source);
    }
    return priority
        .filter((type) => firstByType.has(type))
        .map((type) => ({
            type,
            label: labels[type] || `Abrir ${type}`,
            source: firstByType.get(type),
        }));
}

async function openCaseFromSourceUrl(url = '') {
    const caseId = extractCaseIdFromSourceUrl(url);
    if (!caseId) return;
    activeCaseId = caseId;
    persistProcessState({ activeCaseId: caseId, processing: false, error: false, statusText: `${formatCaseHandle(caseId)} recuperado desde búsqueda` });
    await loadActiveCase(caseId);
    switchView('processView');
}

function defaultProcessStatusText() {
    return 'Carga el paquete completo y ejecuta el proceso. Imagine hará la prevalidación y, si pasa, continuará hasta el 926.';
}

function summarizeFeedbackText(value = '') {
    const text = String(value || '').trim().replace(/\s+/g, ' ');
    if (!text) return '';
    return text.length > 140 ? `${text.slice(0, 137)}...` : text;
}

function resetProcessPanels() {
    renderCaseDossier(null);
    renderCaseChecklist(null);
    renderWorkflowDecision(null);
    renderPrecheckReport(null);
    renderExecutiveReport(null);
    renderWorkflowRun(null);
    renderColmenaWorkbench(null);
    updateReviewWorkspaceState(null);
}

async function loadRecoverable926Cases() {
    if (!recover926Content) return;
    recover926Content.innerHTML = '<div class="source-item">Cargando procesos con 926...</div>';
    try {
        const response = await fetch(`${API_URL}/api/cases`);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        const cases = Array.isArray(data.cases) ? data.cases : [];
        const recoverable = cases
            .filter((item) => {
                const workflow = (item.analysis || {}).workflow_run || {};
                const output926 = workflow.output_926 || (item.analysis || {}).output_926 || {};
                const integrated = output926.legacy || {};
                return (workflow.status === 'completed' || item.status === 'analyzed') && Boolean(integrated.ok);
            })
            .sort((a, b) => String(b.updated_at || '').localeCompare(String(a.updated_at || '')))
            .slice(0, 12);
        if (!recoverable.length) {
            recover926Content.innerHTML = '<div class="source-item">Aún no hay procesos terminados con 926 disponible.</div>';
            return;
        }
        recover926Content.innerHTML = recoverable.map((item) => {
            const analysis = item.analysis || {};
            const workflow = analysis.workflow_run || {};
            const report = workflow.executive_report_final || workflow.executive_report_precheck || analysis.reporte_ejecutivo || {};
            const resumen = report.resumen_ejecutivo || {};
            const empresa = resumen.empresa || ((analysis.xlsx_profile || {}).profile || {}).empresa || item.label || item.id;
            const nit = resumen.nit || ((analysis.xlsx_profile || {}).profile || {}).nit || 'n/d';
            const fecha = resumen.fecha_proceso_human || report.fecha_proceso_human || item.updated_at?.slice(0, 10) || 'n/d';
            const output926 = workflow.output_926 || analysis.output_926 || {};
            const filename = (output926.legacy || {}).filename || 'archivo_926.txt';
            const contractLabel = `Contrato ${nit !== 'n/d' ? nit : String(item.id || '').replace(/^case-/, '')}`;
            return `
                <article class="workflow-card">
                    <div class="workflow-topline">
                        <div>
                            <div class="panel-label">${contractLabel}</div>
                            <strong>${empresa}</strong>
                        </div>
                        <div class="workflow-badges">
                            <span class="source-chip">${fecha}</span>
                        </div>
                    </div>
                    <p class="workflow-summary">NIT: ${nit}</p>
                    <div class="case-head-actions report-actions">
                        <button class="search-button secondary compact-button" type="button" data-recover-case="${item.id}" data-recover-company="${empresa.replace(/"/g, '&quot;')}" data-recover-nit="${String(nit).replace(/"/g, '&quot;')}">Recuperar</button>
                        <button class="search-button secondary compact-button" type="button" data-open-executive-case="${item.id}">Reporte ejecutivo</button>
                        <button class="search-button secondary compact-button" type="button" data-open-case-docs="${item.id}">Clasificación</button>
                        <button class="search-button secondary compact-button" type="button" data-open-926-case="${item.id}" data-open-926-file="${filename}" data-open-926-with-docs="true">Ver 926 y documentos</button>
                        <button class="search-button secondary compact-button" type="button" data-download-case-package="${item.id}">Descargar documentos</button>
                        <button class="search-button secondary compact-button" type="button" data-open-926-case="${item.id}" data-open-926-file="${filename}">Abrir 926</button>
                        <button class="search-button compact-button" type="button" data-download-926-case="${item.id}" data-download-926-file="${filename}">Descargar 926</button>
                    </div>
                </article>
            `;
        }).join('');
        recover926Content.querySelectorAll('[data-recover-case]').forEach((button) => {
            button.addEventListener('click', async () => {
                const caseId = button.dataset.recoverCase || '';
                if (!caseId) return;
                activeCaseId = caseId;
                const company = String(button.dataset.recoverCompany || button.closest('article')?.querySelector('strong')?.textContent || caseId).trim();
                const nit = String(button.dataset.recoverNit || '').trim();
                const contractLabel = `Contrato ${nit && nit !== 'n/d' ? nit : caseId.replace(/^case-/, '')}`;
                const shouldReprocess = window.confirm(`¿Quieres reprocesar este contrato?\n\n${contractLabel}\n${company}\n\nSi aceptas, Imagine volverá a ejecutar toda la validación y te mostrará el avance completo.`);
                // Parar cualquier timer que este corriendo
                if (caseProgressTimer) { clearInterval(caseProgressTimer); caseProgressTimer = null; }
                if (caseStatusLine) {
                    caseStatusLine.classList.remove('processing', 'error');
                    caseStatusLine.textContent = shouldReprocess
                        ? `Preparando reproceso de ${contractLabel} · ${company}...`
                        : `Cargando ${contractLabel} · ${company}...`;
                }
                try {
                    await loadActiveCase(caseId);
                    switchView('processView');
                    if (shouldReprocess) {
                        const display = resolveContractDisplayName(activeCasePayload);
                        startCaseProgress(buildWorkflowProgressMessages(activeCaseId, activeCasePayload?.files || [], display.fullLabel));
                        await runWorkflow();
                        return;
                    }
                } catch(e) {
                    console.error('Error recuperando caso:', e);
                }
                switchView('processView');
            });
        });
        recover926Content.querySelectorAll('[data-open-926-case]').forEach((button) => {
            button.addEventListener('click', () => openCase926Viewer(
                button.getAttribute('data-open-926-case') || '',
                button.getAttribute('data-open-926-file') || 'archivo_926.txt',
                button
            ));
        });
        recover926Content.querySelectorAll('[data-download-926-case]').forEach((button) => {
            button.addEventListener('click', () => downloadCase926(
                button.getAttribute('data-download-926-case') || '',
                button.getAttribute('data-download-926-file') || 'archivo_926.txt',
                button
            ));
        });
        recover926Content.querySelectorAll('[data-open-case-docs]').forEach((button) => {
            button.addEventListener('click', async () => {
                await openCaseDocumentsFlow(button.getAttribute('data-open-case-docs') || '');
            });
        });
    } catch (error) {
        console.error('No pude cargar procesos con 926:', error);
        recover926Content.innerHTML = '<div class="source-item">No pude cargar la lista de procesos con 926.</div>';
    }
}

function resolveProductionCaseSummary(item = {}) {
    const analysis = item.analysis || {};
    const workflow = analysis.workflow_run || {};
    const report = workflow.executive_report_final || workflow.executive_report_precheck || analysis.reporte_ejecutivo || {};
    const resumen = report.resumen_ejecutivo || {};
    const profile = ((analysis.xlsx_profile || {}).profile || {});
    const empresa = resumen.empresa || profile.empresa || item.label || item.id;
    const nit = resumen.nit || profile.nit || 'n/d';
    const fecha = resumen.fecha_proceso_human || report.fecha_proceso_human || item.updated_at?.slice(0, 10) || 'n/d';
    const output926 = workflow.output_926 || analysis.output_926 || {};
    const legacy = output926.legacy || {};
    const draft = output926.draft || {};
    const status = workflow.status || item.status || 'n/d';
    const finalStatus = resumen.estado || report.estado_final || localizeStatusLabel(status);
    const summary = (analysis.decision || {}).summary || '';
    return {
        empresa,
        nit,
        fecha,
        status,
        finalStatus,
        summary,
        filename: legacy.filename || draft.filename || 'archivo_core.txt',
        has926: Boolean(legacy.ok || legacy.available || draft.content),
    };
}

function renderColmenaBatchSummary(cases = []) {
    if (!colmenaBatchContent) return;
    const selectedItems = cases.filter((item) => selectedColmenaCaseIds.has(item.id) && item.has_926);
    if (!selectedItems.length) {
        colmenaBatchContent.innerHTML = '<div class="source-item">Selecciona uno o más contratos con 926 listo para armar el lote consolidado.</div>';
        return;
    }
    colmenaBatchContent.innerHTML = `
        <div class="workflow-card">
            <div class="workflow-topline">
                <div>
                    <div class="panel-label">Contratos seleccionados</div>
                    <strong>${selectedItems.length} contrato(s)</strong>
                </div>
                <div class="workflow-badges">
                    <span class="source-chip">${selectedItems.filter((item) => item.has_926).length} con 926</span>
                </div>
            </div>
            <div class="report-detail-list">
                ${selectedItems.map((item) => `
                    <div class="report-detail-row">
                        <strong>${escapeHtml(item.empresa || item.label || item.id)}</strong>
                        <div class="service-role">Contrato ${escapeHtml(item.nit || String(item.id || '').replace(/^case-/, ''))} · ${escapeHtml(item.filename || 'archivo_core.txt')}</div>
                    </div>
                `).join('')}
            </div>
        </div>
    `;
}

async function renderColmenaWorkbench(casePayload = activeCasePayload, focusFile = '') {
    if (!colmenaWorkbenchContent || !colmenaWorkbenchSection) return;
    const isColmena = readActiveProfile() === 'colmena';
    const hasCase = Boolean(casePayload?.id);
    const readyForColmena = hasCase ? isCaseReadyForColmena(casePayload) : false;
    const shouldShowWorkbench = isColmena
        && hasCase
        && readyForColmena
        && activeColmenaWorkbenchCaseId === String(casePayload?.id || '');
    toggleSection(colmenaWorkbenchSection, shouldShowWorkbench);
    if (!shouldShowWorkbench) {
        colmenaWorkbenchContent.innerHTML = '';
        return;
    }
    const analysis = casePayload.analysis || {};
    const profile = analysis.xlsx_profile?.profile || {};
    const formFields = analysis.xlsx_profile?.form_fields || {};
    const workflowRun = analysis.workflow_run || {};
    const report = workflowRun.executive_report_final || workflowRun.executive_report_precheck || analysis.reporte_ejecutivo || {};
    const resumen = report.resumen_ejecutivo || {};
    const display = resolveContractDisplayName(casePayload);
    const items = buildClassificationItems(casePayload);
    const selected = items.find((item) => item.file === focusFile)
        || items.find((item) => item.file === activeColmenaWorkbenchFile)
        || items[0]
        || null;
    activeColmenaWorkbenchFile = selected?.file || '';
    const empresa = resumen.empresa || profile.empresa || casePayload.label || 'n/d';
    const nit = resumen.nit || profile.nit || 'n/d';
    const documento = resumen.documento || profile.documento || 'n/d';
    const trabajadores = resumen.numero_trabajadores ?? profile.numero_trabajadores ?? 'n/d';
    const sedes = resumen.numero_sedes ?? profile.numero_sedes ?? 'n/d';
    const nomina = formatCurrencyCop(resumen.nomina_total ?? profile.nomina_total ?? 'n/d');
    const afiliacion = formFields.b_tipo_afiliacion || formFields.a_tipo_afiliacion || profile.tipo_afiliacion || 'n/d';
    const tipoPersona = formFields.a_tipo_persona || formFields.b_tipo_persona || profile.tipo_persona || 'n/d';
    const ciudad = describeCity(profile.ciudad || formFields.a_ciudad || formFields.b_ciudad || '');
    const responsable = [
        profile.responsable_sede_principal_primer_nombre,
        profile.responsable_sede_principal_segundo_nombre,
        profile.responsable_sede_principal_primer_apellido,
        profile.responsable_sede_principal_segundo_apellido,
    ].filter(Boolean).join(' ') || 'n/d';
    const actEconomica = formFields.b_codigo_actividad_economica_principal || formFields.a_codigo_actividad_economica_principal || profile.codigo_actividad_economica_principal || 'n/d';
    const output926 = workflowRun.output_926 || analysis.output_926 || {};
    const legacy926 = output926.legacy || {};
    const draft926 = output926.draft || {};
    const has926 = Boolean(legacy926.ok || legacy926.available || draft926.content);
    const filename926 = legacy926.filename || draft926.filename || 'archivo_core.txt';

    let previewHtml = '<div class="source-item">Este contrato no tiene documentos disponibles para mostrar en la mesa.</div>';
    if (selected) {
        if (selected.kind === 'xlsx') {
            previewHtml = buildClassificationXlsxPreview(casePayload, selected);
        } else {
            previewHtml = '<div class="source-item">Cargando documento...</div>';
        }
    }

    colmenaWorkbenchContent.innerHTML = `
        <article class="workflow-card colmena-workbench-card">
            <div class="classification-workspace-head">
                <div>
                    <div class="panel-label">${escapeHtml(display.shortLabel)}</div>
                    <strong>${escapeHtml(empresa)}</strong>
                    <p class="service-role">Mesa operativa de Colmena: revisa la información consolidada por Imagine, valida el soporte documental y continúa con el plano.</p>
                </div>
                <div class="workflow-badges">
                    <span class="source-chip">Estado: ${escapeHtml(String(resumen.estado || report.estado_final || 'APROBADO'))}</span>
                    <span class="source-chip">Corrida: ${escapeHtml(formatUiDateTime(casePayload.updated_at || ''))}</span>
                </div>
            </div>
            <div class="colmena-summary-strip">
                <span class="source-chip dossier-chip"><strong>NIT:</strong> ${escapeHtml(String(nit))}</span>
                <span class="source-chip dossier-chip"><strong>Documento:</strong> ${escapeHtml(String(documento))}</span>
                <span class="source-chip dossier-chip"><strong>Trabajadores:</strong> ${escapeHtml(String(trabajadores))}</span>
                <span class="source-chip dossier-chip"><strong>Sedes:</strong> ${escapeHtml(String(sedes))}</span>
                <span class="source-chip dossier-chip"><strong>Nómina:</strong> ${escapeHtml(String(nomina))}</span>
            </div>
            <div class="colmena-workbench-grid">
                <section class="classification-preview-pane colmena-preview-pane">
                    <div class="classification-preview-head">
                        <div>
                            <div class="panel-label">Documento de apoyo</div>
                            <strong>${escapeHtml(selected?.displayName || 'Sin documento seleccionado')}</strong>
                        </div>
                        <div class="classification-preview-meta">
                            ${selected ? `<span class="source-chip">${escapeHtml(selected.effectiveTypeLabel)}</span>` : ''}
                        </div>
                    </div>
                    <div class="classification-preview-body" id="colmenaWorkbenchPreviewBody">${previewHtml}</div>
                </section>
                <aside class="classification-side-pane colmena-side-pane">
                    <div class="workflow-block">
                        <div class="panel-label">Datos de la afiliación</div>
                        <div class="classification-kv-grid">
                            <div class="classification-kv-item"><span>Empresa</span><strong>${escapeHtml(String(empresa))}</strong></div>
                            <div class="classification-kv-item"><span>NIT</span><strong>${escapeHtml(String(nit))}</strong></div>
                            <div class="classification-kv-item"><span>Tipo afiliación</span><strong>${escapeHtml(String(afiliacion))}</strong></div>
                            <div class="classification-kv-item"><span>Tipo persona</span><strong>${escapeHtml(String(tipoPersona))}</strong></div>
                            <div class="classification-kv-item"><span>Responsable sede</span><strong>${escapeHtml(String(responsable))}</strong></div>
                            <div class="classification-kv-item"><span>Ciudad</span><strong>${escapeHtml(String(ciudad))}</strong></div>
                            <div class="classification-kv-item"><span>Actividad económica</span><strong>${escapeHtml(String(actEconomica))}</strong></div>
                            <div class="classification-kv-item"><span>Archivo plano</span><strong>${has926 ? escapeHtml(filename926) : 'Pendiente'}</strong></div>
                        </div>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Documentos del contrato</div>
                        <div class="classification-doc-list">
                            ${items.length ? items.map((item, index) => `
                                <article class="classification-doc-card ${item.file === selected?.file ? 'is-active' : ''}">
                                    <button class="classification-doc-select" type="button" data-colmena-open="${escapeHtml(item.file)}">
                                        <span class="classification-doc-index">${index + 1}</span>
                                        <span class="classification-doc-copy">
                                            <strong>${escapeHtml(item.effectiveTypeLabel)}</strong>
                                            <span>${escapeHtml(item.displayName || item.file)}</span>
                                        </span>
                                    </button>
                                </article>
                            `).join('') : '<div class="service-role">Sin documentos clasificados.</div>'}
                        </div>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Acciones</div>
                        <div class="case-head-actions report-actions">
                            <button class="search-button secondary compact-button" type="button" data-open-executive-case="${casePayload.id}">Validar contrato</button>
                            ${has926 ? `<button class="search-button secondary compact-button" type="button" data-open-926-case="${casePayload.id}" data-open-926-file="${filename926}">Abrir plano</button>` : ''}
                            ${has926 ? `<button class="search-button compact-button" type="button" data-download-926-case="${casePayload.id}" data-download-926-file="${filename926}">Generar plano</button>` : '<button class="search-button compact-button" type="button" disabled>Plano pendiente</button>'}
                        </div>
                    </div>
                </aside>
            </div>
        </article>
    `;

    colmenaWorkbenchContent.querySelectorAll('[data-colmena-open]').forEach((button) => {
        button.addEventListener('click', async () => {
            const nextFile = button.getAttribute('data-colmena-open') || '';
            await renderColmenaWorkbench(casePayload, nextFile);
        });
    });

    const previewBody = document.getElementById('colmenaWorkbenchPreviewBody');
    if (previewBody && selected?.kind === 'document') {
        try {
            const response = await fetch(buildCaseFileRequestUrl(casePayload.id, selected.file, selected.displayName || selected.file, true));
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const blob = await response.blob();
            const previewUrl = URL.createObjectURL(blob);
            const lower = String(selected.file || '').toLowerCase();
            if (lower.endsWith('.pdf')) {
                previewBody.innerHTML = `<object class="classification-preview-frame" data="${previewUrl}" type="application/pdf"><div class="source-item">No pude mostrar el PDF en el visor.</div></object>`;
            } else if (/\.(png|jpg|jpeg|webp|bmp|tif|tiff)$/i.test(lower)) {
                previewBody.innerHTML = `<img class="classification-preview-image" src="${previewUrl}" alt="${escapeHtml(selected.displayName || selected.file)}">`;
            } else {
                previewBody.innerHTML = `<div class="source-item">No hay visor embebido para este archivo. <a class="source-link" href="${previewUrl}" download="${escapeHtml(selected.displayName || selected.file)}">Descargar archivo</a></div>`;
            }
        } catch (error) {
            console.error('No pude cargar la vista previa de la mesa Colmena:', error);
            previewBody.innerHTML = '<div class="source-item">No pude mostrar este documento en el visor.</div>';
        }
    }
}

async function downloadColmenaBatch() {
    const caseIds = Array.from(selectedColmenaCaseIds);
    if (!caseIds.length) {
        addMessage('Selecciona al menos un contrato con 926 para generar el lote consolidado.', 'nova');
        return;
    }
    const original = downloadColmenaBatchButton?.textContent || 'Descargar lote consolidado';
    if (downloadColmenaBatchButton) {
        downloadColmenaBatchButton.disabled = true;
        downloadColmenaBatchButton.textContent = 'Generando...';
    }
    try {
        const response = await fetch(`${API_URL}/api/926/consolidated`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ case_ids: caseIds }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const blob = await response.blob();
        const disposition = response.headers.get('Content-Disposition') || '';
        const filenameMatch = disposition.match(/filename=\"?([^"]+)\"?/i);
        const filename = filenameMatch?.[1] || 'lote_colmena.txt';
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
        logTesterActivity('download_colmena_batch', { cases: caseIds.length });
        if (downloadColmenaBatchButton) {
            downloadColmenaBatchButton.textContent = 'Descargado';
        }
    } catch (error) {
        console.error('No pude generar el lote consolidado:', error);
        addMessage('No pude generar el lote consolidado de Colmena.', 'nova');
        if (downloadColmenaBatchButton) {
            downloadColmenaBatchButton.textContent = 'Error';
        }
    } finally {
        setTimeout(() => {
            if (downloadColmenaBatchButton) {
                downloadColmenaBatchButton.disabled = false;
                downloadColmenaBatchButton.textContent = original;
            }
        }, 1600);
    }
}

async function loadProductionCases() {
    if (!productionCasesContent) return;
    const requestId = ++productionLoadSequence;
    if (productionLoadController) {
        try { productionLoadController.abort(); } catch {}
    }
    productionLoadController = new AbortController();
    productionCasesContent.innerHTML = '<div class="source-item">Cargando contratos...</div>';
    const loadingWatchdog = window.setTimeout(() => {
        if (!productionCasesContent || requestId !== productionLoadSequence) return;
        if (productionCasesContent.textContent?.includes('Cargando contratos')) {
            productionCasesContent.innerHTML = '<div class="source-item">La vista de Producción está tardando más de lo normal. Pulsa <strong>Actualizar</strong> para reintentar.</div>';
        }
    }, 12000);
    try {
        try {
            renderColmenaWorkbench(readActiveProfile() === 'colmena' ? activeCasePayload : null);
        } catch (renderError) {
            console.warn('No pude preparar la mesa Colmena antes de cargar Producción:', renderError);
            renderColmenaWorkbench(null);
        }
        const response = await fetchWithRetry(`${API_URL}/api/cases/production-summary`, {
            signal: productionLoadController.signal,
            timeoutMs: 20000,
        }, 2, 500);
        const data = await response.json();
        let cases = Array.isArray(data.cases) ? data.cases.slice() : [];
        if (readActiveProfile() === 'colmena') {
            cases = cases.filter((item) => isCaseReadyForColmena(item));
        }
        cases.sort((a, b) => String(b.updated_at || '').localeCompare(String(a.updated_at || '')));
        if (!cases.length) {
            activeColmenaWorkbenchCaseId = '';
            activeColmenaWorkbenchFile = '';
            renderColmenaWorkbench(null);
            productionCasesContent.innerHTML = `<div class="source-item">${
                readActiveProfile() === 'colmena'
                    ? 'Aún no hay contratos aprobados y listos para Colmena.'
                    : 'Aún no hay contratos registrados.'
            }</div>`;
            renderColmenaBatchSummary([]);
            return;
        }
        renderColmenaBatchSummary(cases);
        productionCasesContent.innerHTML = cases.map((item) => {
            const meta = item && typeof item === 'object' && !item.analysis ? {
                empresa: item.empresa || item.label || item.id || 'n/d',
                nit: item.nit || 'n/d',
                fecha: item.fecha || item.updated_at?.slice?.(0, 10) || 'n/d',
                fechaHora: formatUiDateTime(item.updated_at || item.fecha || ''),
                status: item.status || 'n/d',
                finalStatus: item.final_status || localizeStatusLabel(item.status),
                summary: item.summary || '',
                filename: item.filename || 'archivo_core.txt',
                has926: Boolean(item.has_926),
            } : resolveProductionCaseSummary(item);
            const contractLabel = `Contrato ${meta.nit !== 'n/d' ? meta.nit : String(item.id || '').replace(/^case-/, '')}`;
            const statusClass = String(meta.status).toLowerCase() === 'completed' ? 'ok' : (String(meta.status).toLowerCase() === 'stopped_prevalidacion' ? 'degraded' : '');
            return `
                <article class="workflow-card">
                    <div class="workflow-topline">
                        <div>
                            <div class="panel-label">${contractLabel}</div>
                            <strong>${meta.empresa}</strong>
                            <div class="service-role">Corrida vigente: ${meta.fechaHora || meta.fecha}</div>
                        </div>
                        <div class="workflow-badges">
                            <span class="status-badge ${statusClass}">${localizeStatusLabel(meta.status)}</span>
                            <span class="source-chip">${meta.fecha}</span>
                        </div>
                    </div>
                    <p class="workflow-summary">Estado final: ${meta.finalStatus}${meta.summary ? ` · ${meta.summary}` : ''}</p>
                    <div class="case-head-actions report-actions">
                        ${readActiveProfile() === 'colmena' && meta.has926 ? `<label class="source-chip selection-chip"><input type="checkbox" data-colmena-case="${item.id}" ${selectedColmenaCaseIds.has(item.id) ? 'checked' : ''}> Incluir en lote</label>` : ''}
                        ${readActiveProfile() === 'colmena' ? `<button class="search-button compact-button" type="button" data-open-colmena-workbench="${item.id}">Abrir mesa Colmena</button>` : ''}
                        <button class="search-button secondary compact-button" type="button" data-recover-case="${item.id}" data-recover-company="${String(meta.empresa).replace(/"/g, '&quot;')}" data-recover-nit="${String(meta.nit).replace(/"/g, '&quot;')}">Recuperar</button>
                        <button class="search-button secondary compact-button" type="button" data-open-executive-case="${item.id}">Reporte ejecutivo</button>
                        <button class="search-button secondary compact-button" type="button" data-open-case-docs="${item.id}">Clasificación</button>
                        <button class="search-button secondary compact-button" type="button" data-open-926-case="${item.id}" data-open-926-file="${meta.filename}" data-open-926-with-docs="true">Ver 926 y documentos</button>
                        <button class="search-button secondary compact-button" type="button" data-download-case-package="${item.id}">Descargar documentos</button>
                        ${meta.has926 ? `<button class="search-button secondary compact-button" type="button" data-open-926-case="${item.id}" data-open-926-file="${meta.filename}">Abrir 926</button>` : ''}
                        ${meta.has926 ? `<button class="search-button compact-button" type="button" data-download-926-case="${item.id}" data-download-926-file="${meta.filename}">Descargar 926</button>` : ''}
                    </div>
                </article>
            `;
        }).join('');
        productionCasesContent.querySelectorAll('[data-colmena-case]').forEach((input) => {
            input.addEventListener('change', () => {
                const caseId = input.getAttribute('data-colmena-case') || '';
                if (!caseId) return;
                if (input.checked) {
                    selectedColmenaCaseIds.add(caseId);
                } else {
                    selectedColmenaCaseIds.delete(caseId);
                }
                renderColmenaBatchSummary(cases);
            });
        });
    } catch (error) {
        if (String(error?.name || '') === 'AbortError') {
            return;
        }
        console.error('No pude cargar la vista de Producción:', error);
        activeColmenaWorkbenchCaseId = '';
        activeColmenaWorkbenchFile = '';
        renderColmenaWorkbench(null);
        const detail = String(error?.message || '').trim();
        productionCasesContent.innerHTML = `<div class="source-item">${escapeHtml(
            getFriendlyRequestError(detail, 'production') || 'No pude cargar la lista de contratos.'
        )}</div>`;
        renderColmenaBatchSummary([]);
    } finally {
        clearTimeout(loadingWatchdog);
        if (requestId === productionLoadSequence) {
            productionLoadController = null;
        }
    }
}

async function downloadCasePackage(caseId, trigger = null) {
    if (!caseId) return;
    const original = trigger?.textContent || 'Descargar paquete';
    if (trigger) trigger.textContent = 'Descargando...';
    try {
        const response = await fetch(`${API_URL}/api/cases/${encodeURIComponent(caseId)}/package`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const blob = await response.blob();
        const disposition = response.headers.get('Content-Disposition') || '';
        const filenameMatch = disposition.match(/filename=\"?([^"]+)\"?/i);
        const filename = filenameMatch?.[1] || `paquete_${caseId}.zip`;
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
        if (trigger) trigger.textContent = 'Descargado';
    } catch (error) {
        console.error('No pude descargar el paquete:', error);
        if (trigger) trigger.textContent = 'Error';
    } finally {
        if (trigger) {
            setTimeout(() => {
                trigger.textContent = original;
            }, 1500);
        }
    }
}

async function loadFailedPrecheckCases() {
    if (!failedPrecheckContent) return;
    failedPrecheckContent.innerHTML = '<div class="source-item">Cargando contratos con prevalidación no aprobada...</div>';
    try {
        const response = await fetchWithRetry(`${API_URL}/api/cases/precheck-failed`);
        const data = await response.json();
        const cases = Array.isArray(data.cases) ? data.cases : [];
        if (!cases.length) {
            failedPrecheckContent.innerHTML = '<div class="source-item">No hay contratos con prevalidación no aprobada.</div>';
            return;
        }
        failedPrecheckContent.innerHTML = cases.map((item) => {
            const company = item.empresa || item.label || item.id;
            const nit = item.nit || 'n/d';
            const fecha = item.fecha || 'n/d';
            const status = item.estado || 'RECHAZADO';
            const blockers = Array.isArray(item.blockers) ? item.blockers.slice(0, 3) : [];
            const contractLabel = `Contrato ${nit !== 'n/d' ? nit : String(item.id || '').replace(/^case-/, '')}`;
            return `
                <article class="workflow-card">
                    <div class="workflow-topline">
                        <div>
                            <div class="panel-label">${contractLabel}</div>
                            <strong>${company}</strong>
                        </div>
                        <div class="workflow-badges">
                            <span class="status-badge degraded">${status}</span>
                            <span class="source-chip">${fecha}</span>
                        </div>
                    </div>
                    <p class="workflow-summary">${item.summary || 'La prevalidación no fue aprobada.'}</p>
                    <div class="workflow-block">
                        <div class="panel-label">Motivos principales</div>
                        ${blockers.length
                            ? `<ul class="workflow-bullets">${blockers.map((reason) => `<li>${reason}</li>`).join('')}</ul>`
                            : '<div class="service-role">Sin detalle adicional registrado.</div>'}
                    </div>
                    <div class="case-head-actions report-actions">
                        <button class="search-button secondary compact-button" type="button" data-open-precheck-case="${item.id}">Ver resumen</button>
                        <button class="search-button secondary compact-button" type="button" data-open-case-docs="${item.id}">Ver documentos</button>
                        <button class="search-button compact-button" type="button" data-recover-case="${item.id}" data-recover-company="${String(company).replace(/"/g, '&quot;')}" data-recover-nit="${String(nit).replace(/"/g, '&quot;')}">Recuperar</button>
                    </div>
                </article>
            `;
        }).join('');
    } catch (error) {
        console.error('No pude cargar contratos con prevalidación no aprobada:', error);
        const detail = String(error?.message || '').trim();
        failedPrecheckContent.innerHTML = `<div class="source-item">${escapeHtml(
            getFriendlyRequestError(detail, 'precheck-failed') || 'No pude cargar los contratos con prevalidación no aprobada.'
        )}</div>`;
    }
}

async function loadWorkflowQueueStatus() {
    if (!queueContent) return;
    if (queueLoadController) {
        try { queueLoadController.abort(); } catch {}
    }
    queueLoadController = new AbortController();
    queueContent.innerHTML = '<div class="source-item">Cargando cola de ejecución...</div>';
    try {
        const response = await fetchWithRetry(`${API_URL}/api/workflow-queue`, {
            signal: queueLoadController.signal,
            timeoutMs: 12000,
        }, 1, 0);
        const data = await response.json();
        const active = data.active || null;
        const queue = Array.isArray(data.queue) ? data.queue : [];
        const activeHtml = active
            ? `
                <article class="workflow-card">
                    <div class="workflow-topline">
                        <div>
                            <div class="panel-label">Contrato en ejecución</div>
                            <strong>${active.empresa || active.label || active.case_id}</strong>
                        </div>
                        <div class="workflow-badges">
                            <span class="source-chip">${active.nit || 'n/d'}</span>
                        </div>
                    </div>
                    <p class="workflow-summary">Se está procesando ahora mismo. Cuando termine, la cola seguirá automáticamente.</p>
                </article>
            `
            : '<div class="source-item">No hay contratos en ejecución en este momento.</div>';
        const queueHtml = queue.length
            ? queue.map((item, index) => `
                <article class="workflow-card">
                    <div class="workflow-topline">
                        <div>
                            <div class="panel-label">En espera #${index + 1}</div>
                            <strong>${item.empresa || item.label || item.case_id}</strong>
                        </div>
                        <div class="workflow-badges">
                            <span class="source-chip">${item.nit || 'n/d'}</span>
                        </div>
                    </div>
                    <p class="workflow-summary">Este contrato se procesará cuando termine el actual.</p>
                </article>
            `).join('')
            : '<div class="source-item">No hay contratos en espera.</div>';
        queueContent.innerHTML = `
            <div class="workflow-grid">
                <div class="workflow-block">
                    <div class="panel-label">Ejecución actual</div>
                    ${activeHtml}
                </div>
                <div class="workflow-block">
                    <div class="panel-label">En cola</div>
                    ${queueHtml}
                </div>
            </div>
        `;
        toggleSection(queueSection, true);
    } catch (error) {
        if (String(error?.name || '') === 'AbortError') {
            return;
        }
        console.error('No pude cargar la cola de ejecución:', error);
        const detail = String(error?.message || '').trim();
        queueContent.innerHTML = `<div class="source-item">${escapeHtml(
            getFriendlyRequestError(detail, 'queue') || 'No pude cargar la cola de ejecución.'
        )}</div>`;
    } finally {
        queueLoadController = null;
    }
}

function setRecover926Expanded(shouldExpand) {
    recover926Expanded = Boolean(shouldExpand);
    recover926Content?.classList.toggle('hidden', !recover926Expanded);
    if (toggleRecover926Button) {
        toggleRecover926Button.textContent = recover926Expanded ? 'Ocultar' : 'Mostrar';
    }
    if (recover926Expanded) {
        loadRecoverable926Cases();
    }
}

function setFailedPrecheckExpanded(shouldExpand) {
    failedPrecheckExpanded = Boolean(shouldExpand);
    failedPrecheckContent?.classList.toggle('hidden', !failedPrecheckExpanded);
    if (toggleFailedPrecheckButton) {
        toggleFailedPrecheckButton.textContent = failedPrecheckExpanded ? 'Ocultar' : 'Mostrar';
    }
    if (failedPrecheckExpanded) {
        loadFailedPrecheckCases();
    }
}

function clearProcessState() {
    try {
        window.localStorage.removeItem(PROCESS_STATE_KEY);
    } catch (error) {
        console.error('No pude limpiar el estado del proceso:', error);
    }
    persistChatContext({
        active_case_id: '',
        active_company: '',
        active_nit: '',
        active_document: '',
    });
    activeColmenaWorkbenchCaseId = '';
    activeColmenaWorkbenchFile = '';
    renderColmenaWorkbench(null);
    syncProcessDashboardPanels(false);
}

function getManualReviewEntry(manualReview = {}, kind, filename) {
    const bucketName = kind === 'xlsx' ? 'xlsx' : 'documents';
    return ((manualReview || {})[bucketName] || {})[filename] || null;
}

function collectReviewStats(casePayload = activeCasePayload) {
    const checklist = casePayload?.analysis?.checklist || null;
    const manualReview = casePayload?.analysis?.manual_review || {};
    const xlsxFiles = collectXlsxFiles(casePayload);
    const pending = [];
    const reviewed = [];
    const pushFile = (kind, filename, label) => {
        const entry = getManualReviewEntry(manualReview, kind, filename);
        // Si el sistema clasificó el documento, el veredicto por defecto es correcto.
        // Solo se marca como pendiente si el usuario guardó una corrección explícita con "no".
        const verdict = entry?.verdict || 'si';
        const item = { kind, filename, label, verdict };
        if (entry?.verdict === 'no') {
            // Tiene corrección pendiente del usuario
            pending.push(item);
        } else {
            // Clasificado bien por el sistema (o ya confirmado)
            reviewed.push(item);
        }
    };
    xlsxFiles.forEach((filename) => pushFile('xlsx', filename, 'XLSX'));
    for (const item of checklist?.received_summary || []) {
        for (const filename of item.files || []) {
            pushFile('document', filename, item.label || 'Documento');
        }
    }
    return {
        hasChecklist: Boolean(checklist),
        pending,
        reviewed,
        total: pending.length + reviewed.length,
    };
}

function updateReviewWorkspaceState(casePayload = activeCasePayload) {
    const stats = collectReviewStats(casePayload);
    const pendingCount = stats.pending.length;
    if (reviewViewButton) {
        reviewViewButton.textContent = pendingCount > 0 ? `Revisión (${pendingCount})` : 'Revisión';
    }
    if (reviewGuideSection) {
        reviewGuideSection.classList.toggle('hidden', stats.hasChecklist);
    }
    if (checklistSection) {
        checklistSection.classList.toggle('hidden', !stats.hasChecklist);
    }
    if (reviewGuideSummary) {
        if (pendingCount > 0) {
            reviewGuideSummary.textContent = `Hay ${pendingCount} documento(s) pendiente(s) por validar. Desde aquí puedes abrir la bandeja de revisión y trabajar directamente sobre ellos.`;
        } else if (stats.hasChecklist) {
            reviewGuideSummary.textContent = 'No hay documentos pendientes por revisar en este momento. Si ya validaste todo, no necesitas hacer nada más aquí.';
        } else {
            reviewGuideSummary.textContent = 'Si hay documentos pendientes, desde aquí puedes abrir la bandeja de revisión y validarlos. Si no hay documentos por revisar, el sistema te lo indicará aquí mismo.';
        }
    }
    if (reviewGuideCardSummary) {
        if (pendingCount > 0) {
            reviewGuideCardSummary.textContent = `Abre la bandeja de revisión del lote activo. Hay ${pendingCount} documento(s) pendiente(s).`;
        } else if (stats.hasChecklist) {
            reviewGuideCardSummary.textContent = 'Este lote no tiene documentos pendientes por revisar.';
        } else {
            reviewGuideCardSummary.textContent = 'No hay documentos para revisar todavía. Primero debes cargar o recuperar un lote.';
        }
    }
    if (reviewGuidePrimaryButton) {
        reviewGuidePrimaryButton.disabled = !stats.hasChecklist || pendingCount === 0;
        reviewGuidePrimaryButton.textContent = pendingCount > 0 ? `Validar documentos (${pendingCount})` : 'No hay documentos para revisar';
    }
    return stats;
}

function formatManualReviewState(entry) {
    if (!entry?.verdict) return 'Pendiente';
    const base = entry.verdict === 'si' ? 'Marcado: sí' : 'Marcado: no';
    if (entry.expected_type) {
        const option = REVIEW_TYPE_OPTIONS.find(([value]) => value === entry.expected_type);
        return `${base} · corregir a ${option ? option[1] : entry.expected_type}`;
    }
    return base;
}

function formatConfidenceValue(value) {
    const num = Number(value);
    if (!Number.isFinite(num)) return 'n/d';
    return `${Math.round(num * 100)}%`;
}

function buildDocumentMetaMap(casePayload = null) {
    const docs = Array.isArray(casePayload?.analysis?.documents) ? casePayload.analysis.documents : [];
    return Object.fromEntries(docs.map((doc) => [doc.filename, doc]));
}

function getDisplayFilename(file, meta = null) {
    return meta?.display_filename || meta?.download_filename || file;
}

function buildXlsxMeta(casePayload = null, filename = '') {
    const profile = casePayload?.analysis?.xlsx_profile?.profile || {};
    if (!filename) return null;
    return {
        document_type: 'xlsx',
        classification_confidence: 1,
        ocr_quality_score: null,
        key_fields: {
            nit: profile.nit || '',
            documento: profile.documento || '',
            empresa: profile.empresa || '',
            trabajadores: profile.numero_trabajadores ?? profile.empleados_total ?? '',
            sedes: profile.numero_sedes ?? profile.sedes_validas ?? '',
            nomina_total: profile.nomina_total ?? '',
        },
        signals_detected: ['xlsx_profile_loaded'],
        field_confidence: {},
    };
}

function getReviewTypeLabel(type = '') {
    const normalized = String(type || '').trim();
    if (!normalized) return 'Sin clasificar';
    if (normalized === 'xlsx') return 'Archivo de origen XLSX';
    const match = REVIEW_TYPE_OPTIONS.find(([value]) => value === normalized);
    if (match) return String(match[1]).replace(/\s*\(\d+\)\s*$/, '').trim();
    return normalized.replaceAll('_', ' ');
}

function getDocumentEffectiveType(item = {}, manualReview = {}) {
    const reviewEntry = getManualReviewEntry(manualReview, item.kind, item.file);
    if (reviewEntry?.verdict === 'no' && reviewEntry.expected_type) {
        return reviewEntry.expected_type;
    }
    return item.kind === 'xlsx' ? 'xlsx' : (item.meta?.document_type || item.groupLabel || 'pdf');
}

function cleanupClassificationPreviewUrl() {
    if (activeClassificationPreviewUrl) {
        URL.revokeObjectURL(activeClassificationPreviewUrl);
        activeClassificationPreviewUrl = null;
    }
}

function getDocumentWorkspace(casePayload = activeCasePayload) {
    return casePayload?.analysis?.document_workspace || {};
}

function readClassificationOrderMap() {
    try {
        return JSON.parse(window.localStorage.getItem(CLASSIFICATION_ORDER_KEY) || '{}');
    } catch (error) {
        console.error('No pude leer el orden de clasificación:', error);
        return {};
    }
}

function readClassificationOrder(caseId = '') {
    if (!caseId) return [];
    const map = readClassificationOrderMap();
    return Array.isArray(map[caseId]) ? map[caseId] : [];
}

function persistClassificationOrder(caseId = '', files = []) {
    if (!caseId) return;
    try {
        const map = readClassificationOrderMap();
        map[caseId] = files.slice();
        window.localStorage.setItem(CLASSIFICATION_ORDER_KEY, JSON.stringify(map));
    } catch (error) {
        console.error('No pude guardar el orden de clasificación:', error);
    }
}

function getEffectiveClassificationOrder(casePayload = activeCasePayload) {
    const workspaceOrder = getDocumentWorkspace(casePayload)?.order;
    if (Array.isArray(workspaceOrder) && workspaceOrder.length) {
        return workspaceOrder.slice();
    }
    return readClassificationOrder(casePayload?.id || '');
}

function buildClassificationItems(casePayload = activeCasePayload) {
    const payload = casePayload || {};
    const caseId = payload.id || '';
    const manualReview = payload?.analysis?.manual_review || {};
    const workspace = getDocumentWorkspace(payload);
    const removedFiles = new Set(Array.isArray(workspace?.removed_files) ? workspace.removed_files : []);
    const documentMeta = buildDocumentMetaMap(payload);
    const receivedSummary = Array.isArray(payload?.analysis?.checklist?.received_summary) ? payload.analysis.checklist.received_summary : [];
    const xlsxFiles = collectXlsxFiles(payload);
    const items = [];
    const seen = new Set();
    let index = 0;

    xlsxFiles.forEach((file) => {
        if (!file || seen.has(file) || removedFiles.has(file)) return;
        seen.add(file);
        items.push({
            file,
            kind: 'xlsx',
            meta: buildXlsxMeta(payload, file),
            groupLabel: 'XLSX',
            displayName: getDisplayFilename(file, buildXlsxMeta(payload, file)),
            originalIndex: index++,
        });
    });

    receivedSummary.forEach((group) => {
        (group.files || []).forEach((file) => {
            if (!file || seen.has(file) || removedFiles.has(file)) return;
            seen.add(file);
            items.push({
                file,
                kind: 'document',
                meta: documentMeta[file] || null,
                groupLabel: group.label || 'Documento',
                displayName: getDisplayFilename(file, documentMeta[file] || null),
                originalIndex: index++,
            });
        });
    });

    Object.values(documentMeta).forEach((meta) => {
        const file = String(meta?.filename || '').trim();
        if (!file || seen.has(file) || removedFiles.has(file)) return;
        seen.add(file);
        items.push({
            file,
            kind: 'document',
            meta,
            groupLabel: meta?.document_type || 'Documento',
            displayName: getDisplayFilename(file, meta),
            originalIndex: index++,
        });
    });

    const savedOrder = getEffectiveClassificationOrder(payload);
    const savedIndex = new Map(savedOrder.map((file, position) => [file, position]));
    items.sort((left, right) => {
        const leftPos = savedIndex.has(left.file) ? savedIndex.get(left.file) : Number.MAX_SAFE_INTEGER;
        const rightPos = savedIndex.has(right.file) ? savedIndex.get(right.file) : Number.MAX_SAFE_INTEGER;
        if (leftPos !== rightPos) return leftPos - rightPos;
        return left.originalIndex - right.originalIndex;
    });

    return items.map((item) => {
        const effectiveType = getDocumentEffectiveType(item, manualReview);
        const reviewEntry = getManualReviewEntry(manualReview, item.kind, item.file);
        return {
            ...item,
            effectiveType,
            effectiveTypeLabel: getReviewTypeLabel(effectiveType),
            classificationSource: reviewEntry?.verdict === 'no' ? 'Tipo corregido' : (item.kind === 'xlsx' ? 'Archivo base' : 'Clasificación actual'),
            correctionValue: item.kind === 'document' && reviewEntry?.verdict === 'no' ? reviewEntry.expected_type || '' : '',
        };
    });
}

function buildClassificationXlsxPreview(casePayload = activeCasePayload, item = null) {
    const profile = casePayload?.analysis?.xlsx_profile?.profile || {};
    const detailRows = [
        ['Empresa', profile.empresa || 'n/d'],
        ['NIT', profile.nit || 'n/d'],
        ['Documento', profile.documento || 'n/d'],
        ['Trabajadores', profile.numero_trabajadores ?? 'n/d'],
        ['Sedes', profile.numero_sedes ?? 'n/d'],
        ['Nómina', formatCurrencyCop(profile.nomina_total ?? 'n/d')],
    ];
    return `
        <div class="classification-xlsx-card">
            <div class="panel-label">Archivo de origen</div>
            <strong>${escapeHtml(item?.displayName || item?.file || 'XLSX')}</strong>
            <p class="service-role">Este archivo es la base del contrato. Aquí se leen empresa, NIT, documento principal, trabajadores, sedes y nómina.</p>
            <div class="classification-kv-grid">
                ${detailRows.map(([label, value]) => `
                    <div class="classification-kv-item">
                        <span>${escapeHtml(label)}</span>
                        <strong>${escapeHtml(String(value))}</strong>
                    </div>
                `).join('')}
            </div>
            <a class="search-button compact-button" href="${escapeHtml(buildCaseFileRequestUrl(casePayload?.id || '', item?.file || '', item?.displayName || item?.file || 'archivo.xlsx'))}" download="${escapeHtml(item?.displayName || item?.file || 'archivo.xlsx')}">Descargar XLSX</a>
        </div>
    `;
}

async function renderClassificationPreview(casePayload = activeCasePayload, item = null) {
    const previewBody = document.getElementById('classificationPreviewBody');
    const previewStage = document.getElementById('classificationPreviewStage');
    const previewTarget = previewStage || previewBody;
    if (!previewTarget) return;
    cleanupClassificationPreviewUrl();
    if (!casePayload?.id || !item?.file) {
        previewTarget.innerHTML = '<div class="source-item">Selecciona un documento del panel derecho para verlo aquí.</div>';
        return;
    }
    if (item.kind === 'xlsx') {
        previewTarget.innerHTML = buildClassificationXlsxPreview(casePayload, item);
        return;
    }
    previewTarget.innerHTML = '<div class="source-item">Cargando documento...</div>';
    try {
        const response = await fetch(buildCaseFileRequestUrl(casePayload.id, item.file, item.displayName || item.file, true));
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const blob = await response.blob();
        activeClassificationPreviewUrl = URL.createObjectURL(blob);
        const lower = String(item.file || '').toLowerCase();
        if (lower.endsWith('.pdf')) {
            previewTarget.innerHTML = `<object class="classification-preview-frame" data="${activeClassificationPreviewUrl}" type="application/pdf"><div class="source-item">No pude mostrar el PDF en el visor.</div></object>`;
            return;
        }
        if (/\.(png|jpg|jpeg|webp|bmp|tif|tiff)$/i.test(lower)) {
            previewTarget.innerHTML = `<img class="classification-preview-image" src="${activeClassificationPreviewUrl}" alt="${escapeHtml(item.displayName || item.file)}">`;
            return;
        }
        previewTarget.innerHTML = `<div class="source-item">No hay visor embebido para este archivo. <a class="source-link" href="${activeClassificationPreviewUrl}" download="${escapeHtml(item.displayName || item.file)}">Descargar archivo</a></div>`;
    } catch (error) {
        console.error('No pude cargar la vista previa de clasificación:', error);
        previewTarget.innerHTML = '<div class="source-item">No pude mostrar este documento en el visor.</div>';
    }
}

function moveClassificationItem(casePayload = activeCasePayload, file = '', direction = 0) {
    const caseId = casePayload?.id || '';
    const items = buildClassificationItems(casePayload);
    const index = items.findIndex((item) => item.file === file);
    if (!caseId || index < 0) return;
    const nextIndex = index + Number(direction || 0);
    if (nextIndex < 0 || nextIndex >= items.length) return;
    const ordered = items.slice();
    const [current] = ordered.splice(index, 1);
    ordered.splice(nextIndex, 0, current);
    persistClassificationOrder(caseId, ordered.map((item) => item.file));
    saveDocumentWorkspace(caseId, { action: 'set_order', order: ordered.map((item) => item.file) })
        .then((payload) => renderClassificationWorkspace(payload || casePayload, current.file))
        .catch(() => renderClassificationWorkspace(casePayload, current.file));
}

async function saveDocumentWorkspace(caseId, payload = {}) {
    if (!caseId) return null;
    const response = await fetch(`${API_URL}/api/cases/${encodeURIComponent(caseId)}/document-workspace`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
    });
    if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
    }
    const data = await response.json();
    if (data?.case) {
        activeCasePayload = data.case;
    } else if (activeCasePayload?.analysis) {
        activeCasePayload.analysis.document_workspace = data.document_workspace || {};
    }
    return data?.case || activeCasePayload;
}

async function duplicateClassificationItem(casePayload = activeCasePayload, file = '') {
    if (!casePayload?.id || !file) return;
    try {
        logTesterActivity('duplicate_document', { case_id: casePayload.id, filename: file });
        const payload = await saveDocumentWorkspace(casePayload.id, { action: 'duplicate', filename: file });
        await loadActiveCase(casePayload.id);
        const items = buildClassificationItems(payload || activeCasePayload);
        const duplicated = items.find((item) => item.file !== file && item.file.startsWith(file.replace(/\.[^.]+$/, '')) && item.file.includes('__dup'));
        renderClassificationWorkspace(activeCasePayload, duplicated?.file || file);
    } catch (error) {
        console.error('No pude duplicar el documento:', error);
        addMessage('No pude duplicar la imagen seleccionada.', 'nova');
    }
}

async function removeClassificationItem(casePayload = activeCasePayload, file = '') {
    if (!casePayload?.id || !file) return;
    try {
        logTesterActivity('remove_document', { case_id: casePayload.id, filename: file });
        const payload = await saveDocumentWorkspace(casePayload.id, { action: 'remove', filename: file });
        const items = buildClassificationItems(payload || activeCasePayload).filter((item) => item.file !== file);
        renderClassificationWorkspace(payload || activeCasePayload, items[0]?.file || '');
    } catch (error) {
        console.error('No pude retirar el documento:', error);
        addMessage('No pude retirar la imagen seleccionada.', 'nova');
    }
}

async function restoreClassificationItem(casePayload = activeCasePayload, file = '') {
    if (!casePayload?.id || !file) return;
    try {
        logTesterActivity('restore_document', { case_id: casePayload.id, filename: file });
        const payload = await saveDocumentWorkspace(casePayload.id, { action: 'restore', filename: file });
        renderClassificationWorkspace(payload || activeCasePayload, file);
    } catch (error) {
        console.error('No pude restaurar el documento:', error);
        addMessage('No pude restaurar la imagen retirada.', 'nova');
    }
}

function renderClassificationWorkspace(casePayload = activeCasePayload, focusFile = '') {
    if (!classificationContent) return;
    if (!casePayload?.id) {
        classificationContent.innerHTML = `
            <article class="workflow-card">
                <div class="panel-label">Sin contrato activo</div>
                <p class="workflow-summary">Primero carga o recupera un contrato. Luego entra aquí para ver el documento en grande, cambiar el tipo y ordenar el paquete.</p>
            </article>
        `;
        cleanupClassificationPreviewUrl();
        activeClassificationCaseId = '';
        activeClassificationFile = '';
        return;
    }
    const items = buildClassificationItems(casePayload);
    if (!items.length) {
        classificationContent.innerHTML = `
            <article class="workflow-card">
                <div class="panel-label">Sin documentos clasificados</div>
                <p class="workflow-summary">Este contrato todavía no tiene documentos listos para clasificar.</p>
            </article>
        `;
        cleanupClassificationPreviewUrl();
        activeClassificationCaseId = casePayload.id;
        activeClassificationFile = '';
        activeClassificationItems = [];
        return;
    }
    activeClassificationCaseId = casePayload.id;
    const workspace = getDocumentWorkspace(casePayload);
    const removedFiles = Array.isArray(workspace?.removed_files) ? workspace.removed_files : [];
    activeClassificationItems = items.slice();
    const selected = items.find((item) => item.file === focusFile)
        || items.find((item) => item.file === activeClassificationFile)
        || items[0];
    activeClassificationFile = selected.file;
    ensureClassificationKeyboardNavigation();
    const display = resolveContractDisplayName(casePayload);
    const selectedIndex = Math.max(0, items.findIndex((item) => item.file === selected.file));
    const canGoPrev = selectedIndex > 0;
    const canGoNext = selectedIndex < items.length - 1;
    const selectedLower = String(selected.file || '').toLowerCase();
    const isSelectedPdf = selected.kind === 'document' && selectedLower.endsWith('.pdf');
    classificationContent.innerHTML = `
        <article class="workflow-card classification-workspace-card">
            <div class="classification-workspace-head">
                <div>
                    <div class="panel-label">${escapeHtml(display.shortLabel)}</div>
                    <strong>${escapeHtml(display.empresa)}</strong>
                    <p class="service-role">Vista de clasificación operativa: documento grande a la izquierda, clasificación y orden a la derecha.</p>
                </div>
                <div class="workflow-badges">
                    <span class="source-chip">${items.length} archivo(s)</span>
                    <span class="source-chip">Corrida: ${escapeHtml(formatUiDateTime(casePayload.updated_at || ''))}</span>
                </div>
            </div>
            <div class="classification-workspace-grid">
                <section class="classification-preview-pane ${isSelectedPdf ? 'is-pdf-preview' : ''}">
                    <div class="classification-preview-head">
                        <div class="classification-preview-title">
                            <div class="panel-label">Visor documental</div>
                            <strong>${escapeHtml(selected.displayName || selected.file)}</strong>
                        </div>
                        <div class="classification-preview-meta">
                            <span class="source-chip">${escapeHtml(selected.effectiveTypeLabel)}</span>
                            <div class="classification-inline-nav">
                                <button class="search-button secondary compact-button classification-inline-nav-btn" type="button" title="Anterior (←)" data-classification-nav="-1" ${canGoPrev ? '' : 'disabled'}>&larr;</button>
                                <button class="search-button secondary compact-button classification-inline-nav-btn" type="button" title="Siguiente (→)" data-classification-nav="1" ${canGoNext ? '' : 'disabled'}>&rarr;</button>
                            </div>
                            <span class="classification-nav-counter">${selectedIndex + 1} / ${items.length}</span>
                            ${selected.kind === 'document' ? `<button class="search-button secondary compact-button" type="button" data-classification-duplicate="${escapeHtml(selected.file)}">Duplicar imagen</button>` : ''}
                            ${selected.kind === 'document' ? `<button class="search-button secondary compact-button danger-button" type="button" data-classification-remove="${escapeHtml(selected.file)}">Eliminar imagen</button>` : ''}
                        </div>
                    </div>
                    <div class="classification-preview-nav-layer" aria-hidden="true">
                        <button class="classification-nav-btn classification-nav-prev" type="button" title="Anterior (←)" data-classification-nav="-1" ${canGoPrev ? '' : 'disabled'}>&larr;</button>
                        <button class="classification-nav-btn classification-nav-next" type="button" title="Siguiente (→)" data-classification-nav="1" ${canGoNext ? '' : 'disabled'}>&rarr;</button>
                    </div>
                    <div class="classification-preview-body" id="classificationPreviewBody">
                        <div class="classification-preview-stage" id="classificationPreviewStage">
                            <div class="source-item">Cargando documento...</div>
                        </div>
                    </div>
                </section>
                <aside class="classification-side-pane">
                    <div class="panel-label">Clasificación y orden</div>
                    <p class="workflow-summary">Selecciona el documento para verlo en grande. Solo el activo expone reclasificación y orden.</p>
                    <div class="classification-doc-list">
                        ${items.map((item, index) => `
                            <article class="classification-doc-card ${item.file === selected.file ? 'is-active' : ''}">
                                <button class="classification-doc-select" type="button" data-classification-open="${escapeHtml(item.file)}">
                                    <span class="classification-doc-index">${index + 1}</span>
                                    <span class="classification-doc-copy">
                                        <strong>${escapeHtml(item.effectiveTypeLabel)}</strong>
                                        <span>${escapeHtml(item.displayName || item.file)}</span>
                                    </span>
                                </button>
                                <div class="classification-doc-tools">
                                    <div class="classification-order-tools">
                                        <button class="search-button secondary compact-button" type="button" data-classification-move="${escapeHtml(item.file)}" data-direction="-1" ${index === 0 ? 'disabled' : ''}>↑</button>
                                        <button class="search-button secondary compact-button" type="button" data-classification-move="${escapeHtml(item.file)}" data-direction="1" ${index === items.length - 1 ? 'disabled' : ''}>↓</button>
                                    </div>
                                    ${item.kind === 'document' ? `
                                        <label class="classification-type-wrap">
                                            <span class="service-role">Reclasificar a</span>
                                            <select class="doc-correction-select" data-classification-type="${escapeHtml(item.file)}">
                                                <option value="">Mantener clasificación actual</option>
                                                ${REVIEW_TYPE_OPTIONS.map(([value, optionLabel]) => `<option value="${value}" ${item.correctionValue === value ? 'selected' : ''}>${optionLabel}</option>`).join('')}
                                            </select>
                                        </label>
                                    ` : `
                                        <div class="service-role">Archivo base del contrato</div>
                                    `}
                                </div>
                            </article>
                        `).join('')}
                    </div>
                    ${removedFiles.length ? `
                        <div class="classification-removed-block">
                            <div class="panel-label">Imágenes retiradas</div>
                            <div class="classification-removed-list">
                                ${removedFiles.map((file) => `
                                    <div class="classification-removed-row">
                                        <span>${escapeHtml(file)}</span>
                                        <button class="search-button secondary compact-button" type="button" data-classification-restore="${escapeHtml(file)}">Restaurar</button>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    ` : ''}
                </aside>
            </div>
        </article>
    `;
    classificationContent.querySelectorAll('[data-classification-nav]').forEach((button) => {
        button.addEventListener('click', () => {
            navigateClassificationByOffset(Number(button.getAttribute('data-classification-nav') || '0'));
        });
    });
    classificationContent.querySelectorAll('[data-classification-open]').forEach((button) => {
        button.addEventListener('click', () => {
            const nextFile = button.getAttribute('data-classification-open') || '';
            persistChatContext({
                last_document_title: nextFile,
                last_document_intent: inferSourceIntent({ titulo: nextFile }),
                last_case_id: casePayload.id,
                active_case_id: casePayload.id,
            });
            renderClassificationWorkspace(casePayload, nextFile);
        });
    });
    classificationContent.querySelectorAll('[data-classification-move]').forEach((button) => {
        button.addEventListener('click', () => {
            moveClassificationItem(casePayload, button.getAttribute('data-classification-move') || '', Number(button.getAttribute('data-direction') || '0'));
        });
    });
    classificationContent.querySelectorAll('[data-classification-type]').forEach((select) => {
        select.addEventListener('change', async () => {
            const filename = select.getAttribute('data-classification-type') || '';
            const nextType = select.value || '';
            if (!filename || !nextType) return;
            await saveManualReview(casePayload.id, 'document', filename, 'no', null, { expectedType: nextType });
        });
    });
    classificationContent.querySelectorAll('[data-classification-duplicate]').forEach((button) => {
        button.addEventListener('click', async () => {
            await duplicateClassificationItem(casePayload, button.getAttribute('data-classification-duplicate') || '');
        });
    });
    classificationContent.querySelectorAll('[data-classification-remove]').forEach((button) => {
        button.addEventListener('click', async () => {
            await removeClassificationItem(casePayload, button.getAttribute('data-classification-remove') || '');
        });
    });
    classificationContent.querySelectorAll('[data-classification-restore]').forEach((button) => {
        button.addEventListener('click', async () => {
            await restoreClassificationItem(casePayload, button.getAttribute('data-classification-restore') || '');
        });
    });
    renderClassificationPreview(casePayload, selected);
}

function buildMetaEvidence(meta = null) {
    if (!meta) return '';
    const keyFields = meta.key_fields || {};
    const fieldConfidence = meta.field_confidence || {};
    const fieldRows = Object.entries(keyFields)
        .filter(([, value]) => value !== null && value !== undefined && String(value).trim() !== '')
        .map(([key, value]) => {
            const normalizedKey = key
                .replaceAll('_', ' ')
                .replace(/\b\w/g, (char) => char.toUpperCase());
            const displayValue = key.toLowerCase().includes('nomina')
                ? formatCurrencyCop(value)
                : String(value);
            const confidence = fieldConfidence[key];
            return `
                <div class="doc-meta-row">
                    <span>${normalizedKey}: ${displayValue}</span>
                    ${confidence !== undefined ? `<span class="doc-meta-chip subtle">conf. ${formatConfidenceValue(confidence)}</span>` : ''}
                </div>
            `;
        })
        .join('');
    const signals = Array.isArray(meta.signals_detected) ? meta.signals_detected.filter(Boolean).slice(0, 4) : [];
    const signalHtml = signals.length
        ? `<div class="doc-meta-signals">${signals.map((item) => `<span class="doc-meta-chip">${item}</span>`).join('')}</div>`
        : '';
    const confidenceHtml = `
        <div class="doc-meta-summary">
            <span class="doc-meta-chip">tipo ${formatConfidenceValue(meta.classification_confidence)}</span>
            ${meta.ocr_quality_score !== null && meta.ocr_quality_score !== undefined ? `<span class="doc-meta-chip">ocr ${formatConfidenceValue(meta.ocr_quality_score)}</span>` : ''}
        </div>
    `;
    if (!fieldRows && !signalHtml) {
        return confidenceHtml;
    }
    return `
        <div class="doc-meta-block">
            ${confidenceHtml}
            ${fieldRows ? `<div class="doc-meta-fields">${fieldRows}</div>` : ''}
            ${signalHtml}
        </div>
    `;
}

function collectXlsxFiles(casePayload = null) {
    const files = Array.isArray(casePayload?.files) ? casePayload.files : [];
    return files
        .map((item) => item?.filename)
        .filter((name) => /\.(xlsx|xls|xlsm)$/i.test(String(name || '')));
}

function buildDocumentReviewRow({ caseId, file, label, detail, kind = 'document', manualReview = {}, meta = null, compactCorrection = false }) {
    const reviewEntry = getManualReviewEntry(manualReview, kind, file);
    const expectedType = reviewEntry?.expected_type || '';
    const displayName = getDisplayFilename(file, meta);
    const correctionSelect = kind === 'document'
        ? `
            <label class="doc-correction-wrap">
                <span class="service-role">Si está mal, elige el tipo correcto</span>
                <select class="doc-correction-select" data-review-expected ${compactCorrection ? 'data-review-autosave="true"' : ''}>
                    <option value="">Selecciona el tipo correcto</option>
                    ${REVIEW_TYPE_OPTIONS.map(([value, optionLabel]) => `<option value="${value}" ${expectedType === value ? 'selected' : ''}>${optionLabel}</option>`).join('')}
                </select>
            </label>
        `
        : '';
    return `
        <div class="document-row">
            <div class="document-row-copy">
                <div class="panel-label">${label}</div>
                <div class="document-row-name">${displayName}</div>
                ${displayName !== file ? `<div class="service-role">origen: ${file}</div>` : ''}
            </div>
            <div class="document-row-actions">
                <button class="search-button secondary compact-button" type="button" data-case="${caseId}" data-file="${file}" data-display-name="${displayName}">Ver</button>
                ${correctionSelect}
                ${compactCorrection ? '' : `
                    <div class="document-review-actions">
                        <button class="search-button secondary compact-button ${!reviewEntry || reviewEntry?.verdict === 'si' ? 'review-selected review-yes' : ''}" type="button" data-review-case="${caseId}" data-review-kind="${kind}" data-review-file="${file}" data-review-verdict="si">✓ Correcto</button>
                        <button class="search-button secondary compact-button ${reviewEntry?.verdict === 'no' ? 'review-selected review-no' : ''}" type="button" data-review-case="${caseId}" data-review-kind="${kind}" data-review-file="${file}" data-review-verdict="no">Corregir</button>
                    </div>
                `}
            </div>
        </div>
    `;
}

async function saveManualReview(caseId, kind, filename, verdict, button = null, options = {}) {
    if (!caseId || !filename || !verdict) return;
    if (button) button.disabled = true;
    const row = button?.closest('.document-row');
    const expectedType = verdict === 'no'
        ? (options.expectedType || row?.querySelector('[data-review-expected]')?.value || '')
        : '';
    try {
        const response = await fetch(`${API_URL}/api/cases/${encodeURIComponent(caseId)}/manual-review`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind, filename, verdict, expected_type: expectedType })
        });
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        const analysis = activeCasePayload?.analysis || {};
        analysis.manual_review = data.manual_review || {};
        activeCasePayload = { ...(activeCasePayload || {}), analysis };
        renderCaseChecklist(analysis.checklist || null, analysis.validacion_resumen || null, activeCasePayload);
        renderPrecheckReport(analysis.workflow_run?.executive_report_precheck || analysis.reporte_ejecutivo || null);
        renderExecutiveReport(analysis.workflow_run?.executive_report_final || null, analysis.workflow_run?.output_926 || analysis.output_926 || null);
        renderClassificationWorkspace(activeCasePayload, filename);
        updateReviewWorkspaceState(activeCasePayload);
        queueMicrotask(() => {
            const openBlock = document.querySelector('[data-report-documents]:not(.hidden)');
            if (openBlock) {
                openBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    } catch (error) {
        console.error('No pude guardar la calificación manual:', error);
        addMessage('No pude guardar la calificación manual del documento.', 'nova');
    } finally {
        if (button) button.disabled = false;
    }
}

function persistProcessState(partial = {}) {
    try {
        const current = JSON.parse(window.localStorage.getItem(PROCESS_STATE_KEY) || '{}');
        window.localStorage.setItem(PROCESS_STATE_KEY, JSON.stringify({ ...current, ...partial }));
    } catch (error) {
        console.error('No pude guardar el estado del proceso:', error);
    }
}

function readChatContext() {
    try {
        return JSON.parse(window.localStorage.getItem(CHAT_CONTEXT_KEY) || '{}');
    } catch (error) {
        console.error('No pude leer el contexto del chat:', error);
        return {};
    }
}

function persistChatContext(partial = {}) {
    try {
        const current = readChatContext();
        window.localStorage.setItem(CHAT_CONTEXT_KEY, JSON.stringify({ ...current, ...partial }));
    } catch (error) {
        console.error('No pude guardar el contexto del chat:', error);
    }
}

function extractCaseIdFromSources(sources = []) {
    for (const source of sources || []) {
        const caseId = extractCaseIdFromSourceUrl(source?.source_url || '');
        if (caseId) return caseId;
    }
    return '';
}

function updateChatContextFromCasePayload(payload = null) {
    const analysis = payload?.analysis || {};
    const profile = (analysis.xlsx_profile || {}).profile || {};
    persistChatContext({
        active_case_id: payload?.id || activeCaseId || '',
        active_company: profile.empresa || payload?.label || '',
        active_nit: profile.nit || profile.documento_empleador || '',
        active_document: profile.documento || '',
        last_case_id: payload?.id || activeCaseId || '',
    });
}

function detectClientIntent(query = '') {
    const normalized = String(query || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    if (normalized.includes('reporte de prevalidacion') || normalized.includes('reporte prevalidacion')) return 'reporte_prevalidacion';
    if (normalized.includes('observaciones') || normalized.includes('observacion')) return 'observaciones';
    if (normalized.includes('formulario')) return 'formulario';
    if (['que documentos recibio', 'documentos recibidos', 'adjuntos recibidos', 'soportes recibidos'].some((token) => normalized.includes(token))) return 'documentos_recibidos';
    if (['cual es el nit', 'nit de', 'nit del expediente'].some((token) => normalized.includes(token))) return 'nit';
    if (['siguiente paso', 'que sigue', 'que hago ahora', 'proximo paso'].some((token) => normalized.includes(token))) return 'siguiente_paso';
    if (normalized.includes('926') || normalized.includes('bkcargue') || normalized.includes('archivo 926')) return '926';
    if (normalized.includes('bloqueantes') || normalized.includes('bloqueante')) return 'bloqueantes';
    if (['por que fue rechaz', 'porque fue rechaz', 'motivo del rechazo', 'duplicados'].some((token) => normalized.includes(token))) return 'rechazo';
    if (['prevalidacion', 'pre validacion', 'estado del expediente', 'estado operativo', 'aprobado', 'rechazado', 'observado', 'radicacion', 'radicar'].some((token) => normalized.includes(token))) return 'estado';
    if (['quien es el representante', 'representante de', 'representante legal', 'quien firma', 'firma'].some((token) => normalized.includes(token))) return 'representante';
    if (normalized.includes('nomina') || normalized.includes('nomina total') || normalized.includes('nómina')) return 'nomina';
    if (normalized.includes('trabajadores') || normalized.includes('cuantos trabajadores')) return 'trabajadores';
    if (normalized.includes('sedes') || normalized.includes('cuantas sedes') || normalized.includes('centros de trabajo')) return 'sedes';
    if (normalized.includes('cedula') || normalized.includes('cedula de') || normalized.includes('muestrame la cedula')) return 'cedula';
    if (normalized.includes('rut') || normalized.includes('muestrame el rut')) return 'rut';
    if (normalized.includes('camara') || normalized.includes('camara de comercio')) return 'camara';
    return 'general';
}

function inferSourceIntent(source = {}) {
    const type = String(source?.document_type || '').trim().toLowerCase();
    const title = String(source?.titulo || '').trim().toLowerCase();
    if (type.includes('rut') || title.includes('rut')) return 'rut';
    if (type.includes('camara') || title.includes('camara')) return 'camara';
    if (type.includes('cedula') || title.includes('cedula') || title.includes('cédula')) return 'cedula';
    if (type.includes('formulario') || type.includes('xlsx') || title.endsWith('.xlsx')) return 'formulario';
    if (title.includes('926') || title.includes('bkcargue')) return '926';
    return 'general';
}

function normalizeSourceMemory(sources = []) {
    return (sources || []).slice(0, 8).map((source) => ({
        title: String(source?.titulo || '').trim(),
        source_url: String(source?.source_url || '').trim(),
        document_type: String(source?.document_type || '').trim(),
        intent: inferSourceIntent(source),
    })).filter((item) => item.title || item.source_url);
}

function buildContextReference(chatContext = {}, profile = {}) {
    const domActiveTitle = String(
        document.querySelector('.case-active-card h2, .case-dossier-card h2, [data-active-company], h2')?.textContent || ''
    ).trim();
    return String(
        profile.empresa
        || domActiveTitle
        || chatContext.active_company
        || profile.nit
        || profile.documento_empleador
        || chatContext.active_nit
        || profile.documento
        || chatContext.active_document
        || ''
    ).trim();
}

function expandClientFollowupQuery(query = '') {
    const normalized = String(query || '').trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const chatContext = readChatContext();
    const profile = (activeCasePayload?.analysis?.xlsx_profile || {}).profile || {};
    const reference = buildContextReference(chatContext, profile);
    if (!reference) return String(query || '').trim();
    const lastIntent = String(chatContext.last_intent || '').trim();
    const lastDocumentIntent = String(chatContext.last_document_intent || '').trim();
    const sources = Array.isArray(chatContext.last_sources) ? chatContext.last_sources : [];
    const sourceIndex = Number.isFinite(Number(chatContext.last_source_index)) ? Number(chatContext.last_source_index) : 0;
    const currentSource = sources[Math.min(sourceIndex, Math.max(sources.length - 1, 0))] || null;
    const nextSource = sources[Math.min(sourceIndex + 1, Math.max(sources.length - 1, 0))] || null;
    const sourceIntent = String(currentSource?.intent || lastDocumentIntent || '').trim();
    const buildFromSource = (source, fallbackIntent = '') => {
        const sourceTitle = String(source?.title || '').trim();
        if (sourceTitle) return `abre el archivo ${sourceTitle} de ${reference}`;
        return buildFromIntent(fallbackIntent);
    };
    const buildFromIntent = (intent) => {
        if (intent === 'rut') return `rut de ${reference}`;
        if (intent === 'camara') return `camara de comercio de ${reference}`;
        if (intent === 'cedula') return `cedula de ${reference}`;
        if (intent === 'formulario') return `formulario de ${reference}`;
        if (intent === '926') return `926 de ${reference}`;
        if (intent === 'estado') return `estado del expediente ${reference}`;
        if (intent === 'observaciones') return `que observaciones tiene ${reference}`;
        if (intent === 'siguiente_paso') return `siguiente paso de ${reference}`;
        return '';
    };
    const explicitClientIntent = detectClientIntent(query);
    const genericAnchorlessIntents = new Set([
        'rut', 'camara', 'cedula', 'representante', '926', 'estado', 'observaciones',
        'bloqueantes', 'siguiente_paso', 'nomina', 'trabajadores', 'sedes',
        'formulario', 'documentos_recibidos', 'reporte_prevalidacion', 'rechazo'
    ]);
    const queryHasReference = /\d{4,}/.test(normalized) || reference.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/\s+/).some((part) => part && normalized.includes(part));
    if (genericAnchorlessIntents.has(explicitClientIntent) && !queryHasReference) {
        return buildFromIntent(explicitClientIntent) || String(query || '').trim();
    }
    if (['abralo', 'abrelo', 'abreme ese documento', 'ese documento', 'esa fuente', 'ese archivo'].includes(normalized)) {
        return buildFromSource(currentSource, sourceIntent || lastIntent) || String(query || '').trim();
    }
    if (['muestrame el siguiente', 'el siguiente', 'siguiente', 'abre el siguiente'].includes(normalized)) {
        const nextIntent = String(nextSource?.intent || sourceIntent || lastIntent || '').trim();
        return buildFromSource(nextSource, nextIntent) || String(query || '').trim();
    }
    if (['y ahora?', 'y ahora', 'ahora que sigue', 'ahora que hago'].includes(normalized)) {
        return `siguiente paso de ${reference}`;
    }
    if (normalized.startsWith('y ')) {
        const remainder = String(query || '').trim().slice(2).trim();
        if (!remainder) return String(query || '').trim();
        return `${remainder} de ${reference}`;
    }
    return String(query || '').trim();
}

function buildSearchRequestContext(query = '') {
    const chatContext = readChatContext();
    const profile = (activeCasePayload?.analysis?.xlsx_profile || {}).profile || {};
    return {
        topics: Array.from(selectedTopics),
        active_case_id: activeCaseId || chatContext.active_case_id || '',
        active_company: profile.empresa || chatContext.active_company || '',
        active_nit: profile.nit || profile.documento_empleador || chatContext.active_nit || '',
        active_document: profile.documento || chatContext.active_document || '',
        last_case_id: chatContext.last_case_id || activeCaseId || '',
        last_query: chatContext.last_query || '',
        last_intent: chatContext.last_intent || '',
        last_document_title: chatContext.last_document_title || '',
        last_document_intent: chatContext.last_document_intent || '',
        last_sources: Array.isArray(chatContext.last_sources) ? chatContext.last_sources.slice(0, 8) : [],
        last_source_index: Number.isFinite(Number(chatContext.last_source_index)) ? Number(chatContext.last_source_index) : 0,
        ui_view: 'search',
        query,
    };
}

function readProcessState() {
    try {
        return JSON.parse(window.localStorage.getItem(PROCESS_STATE_KEY) || '{}');
    } catch (error) {
        console.error('No pude leer el estado del proceso:', error);
        return {};
    }
}

function buildUploadProgressMessages(files) {
    const xlsx = files.find((file) => /\.(xlsx|xls|xlsm)$/i.test(file.name));
    const pdfs = files.filter((file) => /\.pdf$/i.test(file.name));
    const zips = files.filter((file) => /\.zip$/i.test(file.name));
    const messages = ['Subiendo paquete completo...'];
    if (xlsx) {
        messages.push(`Leyendo XLSX ${xlsx.name}...`);
    }
    if (zips.length) {
        messages.push(`Abriendo ZIP ${zips[0].name} y separando documentos...`);
    }
    if (pdfs.length) {
        messages.push(`Registrando PDF ${pdfs[0].name}...`);
        if (pdfs.length > 1) {
            messages.push(`Clasificando ${pdfs.length} PDF(s) del contrato...`);
        }
    }
    messages.push('Guardando empresa o independiente para ejecutar...');
    return messages;
}

function buildWorkflowProgressMessages(caseId, files, contractLabel = '') {
    const xlsx = files.find((file) => /\.(xlsx|xls|xlsm)$/i.test(file.name));
    const pdfs = files.filter((file) => /\.pdf$/i.test(file.name));
    const mainPdf = pdfs[0]?.name;
    const target = contractLabel || caseId;
    const messages = [
        `Ejecutando prevalidación para ${target}...`,
        xlsx ? `Validando estructura del XLSX ${xlsx.name} de ${target}...` : `Validando estructura del XLSX de ${target}...`,
        'Revisando obligatorios del formulario, sedes y trabajadores...',
        'Validando tipos de dato: fechas, números, correos y documentos...',
        mainPdf ? `Leyendo y clasificando ${mainPdf} de ${target}...` : `Leyendo y clasificando documentos PDF de ${target}...`,
        'Comparando documento principal del XLSX contra la cédula adjunta...',
        'Comparando documento del representante entre formulario y cédula...',
        'Comparando NIT del XLSX contra el RUT detectado...',
        'Verificando razón social entre cámara, RUT y formulario...',
        'Verificando vigencia de la cámara de comercio...',
        'Revisando clasificación documental: formulario, RUT, cédula, pagos, cartas y soportes...',
        'Cruzando nómina total del formulario contra salarios y sedes del XLSX...',
        'Revisando duplicados de documento en trabajadores...',
        'Validando número de trabajadores, sedes y centros de trabajo...',
        'Construyendo resumen ejecutivo de prevalidación...',
        `Preparando continuidad del flujo y salida al CORE para ${target}...`,
    ];
    return messages;
}

function renderProcessChecklist(steps = [], activeIndex = -1, finalState = '') {
    if (!processChecklist) return;
    if (!Array.isArray(steps) || !steps.length) {
        processChecklist.classList.add('hidden');
        processChecklist.innerHTML = '';
        return;
    }
    processChecklist.classList.remove('hidden');
    processChecklist.innerHTML = `
        <div class="process-checklist-head">
            <span class="panel-label">Seguimiento del proceso</span>
            <span class="process-checklist-legend">${finalState || 'Revisa qué ya terminó, qué se está ejecutando y qué falta.'}</span>
        </div>
        <div class="process-checklist-list">
            ${steps.map((step, index) => {
                const state = index < activeIndex ? 'done' : (index === activeIndex ? 'active' : 'pending');
                const icon = state === 'done' ? '✓' : (state === 'active' ? '•' : '○');
                return `
                    <div class="process-checklist-item is-${state}">
                        <span class="process-checklist-icon">${icon}</span>
                        <span class="process-checklist-text">${step}</span>
                    </div>
                `;
            }).join('')}
        </div>
    `;
}

function startCaseProgress(messages) {
    const steps = Array.isArray(messages) && messages.length ? messages : ['Procesando contrato...'];
    let index = 0;
    if (!caseStatusLine) return;
    if (caseProgressTimer) {
        clearInterval(caseProgressTimer);
    }
    caseStatusLine.classList.remove('error');
    caseStatusLine.classList.add('processing');
    caseStatusLine.textContent = steps[0];
    caseProgressSteps = steps.slice();
    caseProgressIndex = 0;
    renderProcessChecklist(caseProgressSteps, caseProgressIndex);
    persistProcessState({ activeCaseId, processing: true, error: false, statusText: steps[0] });
    caseProgressTimer = setInterval(() => {
        index = (index + 1) % steps.length;
        caseProgressIndex = index;
        caseStatusLine.textContent = steps[index];
        renderProcessChecklist(caseProgressSteps, caseProgressIndex);
        persistProcessState({ activeCaseId, processing: true, error: false, statusText: steps[index] });
    }, 1600);
}

function stopCaseProgress(message, isError = false) {
    if (!caseStatusLine) return;
    if (caseProgressTimer) {
        clearInterval(caseProgressTimer);
        caseProgressTimer = null;
    }
    caseStatusLine.classList.remove('processing', 'error');
    if (isError) {
        caseStatusLine.classList.add('error');
    }
    caseStatusLine.textContent = message;
    if (caseProgressSteps.length) {
        renderProcessChecklist(
            caseProgressSteps,
            isError ? Math.max(caseProgressIndex, 0) : caseProgressSteps.length,
            isError ? 'Proceso interrumpido. Revisa el motivo mostrado arriba.' : 'Proceso finalizado.'
        );
    } else {
        renderProcessChecklist([]);
    }
    persistProcessState({ activeCaseId: isError ? activeCaseId : null, processing: false, error: isError, statusText: message });
}

function clearCaseProgressDisplay(message = '') {
    if (caseProgressTimer) {
        clearInterval(caseProgressTimer);
        caseProgressTimer = null;
    }
    if (workflowStatusPollTimer) {
        clearInterval(workflowStatusPollTimer);
        workflowStatusPollTimer = null;
    }
    caseProgressSteps = [];
    caseProgressIndex = -1;
    renderProcessChecklist([]);
    if (caseStatusLine) {
        caseStatusLine.classList.remove('processing', 'error');
        caseStatusLine.textContent = message || defaultProcessStatusText();
    }
}

function startWorkflowStatusPolling(caseId) {
    if (!caseId) return;
    if (workflowStatusPollTimer) {
        clearInterval(workflowStatusPollTimer);
    }
    workflowStatusPollTimer = setInterval(async () => {
        try {
            const response = await fetchWithRetry(`${API_URL}/api/cases/${encodeURIComponent(caseId)}`, { timeoutMs: 10000 }, 1, 0);
            const data = await response.json();
            activeCasePayload = data;
            const workflowRun = data?.analysis?.workflow_run || {};
            const workflowState = String(workflowRun.status || data.status || '').trim().toLowerCase();
            if (['completed', 'stopped_prevalidacion', 'failed'].includes(workflowState)) {
                clearInterval(workflowStatusPollTimer);
                workflowStatusPollTimer = null;
                await loadActiveCase(caseId);
                if (workflowState === 'completed') {
                    addMessage(`La corrida de ${data.label || caseId} terminó correctamente.`, 'nova');
                }
            }
        } catch (error) {
            console.warn('No pude sondear el estado del workflow:', error?.message || error);
        }
    }, 2500);
}

async function downloadCase926(caseId, filename = 'archivo_926.txt', trigger = null) {
    if (!caseId) return;
    const original = trigger?.textContent;
    if (trigger) {
        trigger.disabled = true;
        trigger.textContent = 'Descargando...';
    }
    try {
        const response = await fetch(buildCase926Url(caseId));
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const text = await response.text();
        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
        if (trigger) {
            trigger.textContent = 'Descargado';
            setTimeout(() => {
                trigger.textContent = original || 'Descargar 926';
            }, 1400);
        }
    } catch (error) {
        console.error('No pude descargar el 926:', error);
        if (trigger) {
            trigger.textContent = 'Error';
            setTimeout(() => {
                trigger.textContent = original || 'Descargar 926';
            }, 1400);
        }
    } finally {
        if (trigger) {
            trigger.disabled = false;
        }
    }
}

async function openCase926Viewer(caseId, filename = 'archivo_926.txt', trigger = null) {
    if (!caseId) return;
    logTesterActivity('open_926', { case_id: caseId, filename });
    persistChatContext({
        last_document_title: filename || 'archivo_926.txt',
        last_document_intent: '926',
        last_case_id: caseId,
        active_case_id: caseId,
    });
    const original = trigger?.textContent;
    if (trigger) {
        trigger.disabled = true;
        trigger.textContent = 'Abriendo...';
    }
    documentModalTitle.textContent = `Archivo CORE · ${filename}`;
    documentModalBody.innerHTML = '<div class="source-item">Cargando 926...</div>';
    documentModal.classList.remove('hidden');
    try {
        const [response, caseResponse] = await Promise.all([
            fetch(buildCase926Url(caseId)),
            fetch(`${API_URL}/api/cases/${encodeURIComponent(caseId)}`),
        ]);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const text = await response.text();
        let docItemsHtml = '<div class="source-item">No encontré documentos para este contrato.</div>';
        if (caseResponse.ok) {
            const caseData = await caseResponse.json();
            const documents = Array.isArray(caseData?.analysis?.documents) ? caseData.analysis.documents : [];
            const files = Array.isArray(caseData?.files) ? caseData.files : [];
            const xlsxFiles = files.filter((item) => /\.(xlsx|xls|xlsm)$/i.test(String(item?.filename || '')));
            const items = [];
            xlsxFiles.forEach((item) => {
                const fileName = String(item?.filename || '').trim();
                if (!fileName) return;
                items.push({
                    type: 'xlsx',
                    label: 'xlsx',
                    fileName,
                    displayName: fileName,
                });
            });
            documents.forEach((doc) => {
                const fileName = String(doc?.filename || '').trim();
                if (!fileName) return;
                items.push({
                    type: String(doc?.document_type || 'documento').trim() || 'documento',
                    label: String(doc?.document_type || 'documento').trim() || 'documento',
                    fileName,
                    displayName: String(doc?.display_filename || doc?.download_filename || fileName).trim() || fileName,
                });
            });
            if (items.length) {
                docItemsHtml = items.map((item) => `
                    <button class="combined-doc-item" type="button" data-case="${escapeHtml(caseId)}" data-file="${escapeHtml(item.fileName)}" data-display="${escapeHtml(item.displayName)}">
                        <span class="combined-doc-type">${escapeHtml(item.label)}</span>
                        <span class="combined-doc-name">${escapeHtml(item.displayName)}</span>
                    </button>
                `).join('');
            }
        }
        documentModalBody.innerHTML = `
            <div class="combined-viewer">
                <section class="combined-viewer-main">
                    <div class="panel-label">Archivo para el CORE</div>
                    <pre class="document-text">${escapeHtml(text)}</pre>
                </section>
                <aside class="combined-viewer-side">
                    <div class="panel-label">Documentos del contrato</div>
                    <div class="combined-doc-list">${docItemsHtml}</div>
                </aside>
            </div>
        `;
    } catch (error) {
        console.error('No pude abrir el 926 en el visor:', error);
        documentModalBody.innerHTML = '<div class="source-item">No pude abrir el 926 dentro del visor.</div>';
    } finally {
        if (trigger) {
            trigger.disabled = false;
            trigger.textContent = original || 'Abrir 926';
        }
    }
}

async function openDocumentUrlViewer(url, filename = 'archivo') {
    if (!url) return;
    logTesterActivity('open_documents', { filename, url: String(url).slice(0, 240) });
    const absoluteUrl = url.startsWith('http') ? url : `${API_URL}${url}`;
    const requestUrl = new URL(absoluteUrl, window.location.origin);
    if (requestUrl.pathname.includes('/api/cases/') && requestUrl.pathname.includes('/files/')) {
        requestUrl.searchParams.set('inline', '1');
    }
    const lower = filename.toLowerCase();
    persistChatContext({
        last_document_title: filename,
        last_document_intent: inferSourceIntent({ titulo: filename }),
        last_source_index: 0,
    });
    documentModalTitle.textContent = filename;
    documentModalBody.innerHTML = '<div class="source-item">Cargando archivo...</div>';
    documentModal.classList.remove('hidden');
    try {
        const response = await fetch(requestUrl.toString());
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const blob = await response.blob();
        if (activeDocumentUrl) {
            URL.revokeObjectURL(activeDocumentUrl);
        }
        activeDocumentUrl = URL.createObjectURL(blob);
        if (lower.endsWith('.pdf')) {
            documentModalBody.innerHTML = `<object class="document-frame" data="${activeDocumentUrl}" type="application/pdf"><div class="source-item">No pude mostrar el PDF dentro del visor.</div></object>`;
        } else if (/\.(png|jpg|jpeg|webp|bmp|tif|tiff)$/i.test(lower)) {
            documentModalBody.innerHTML = `<img class="document-image" src="${activeDocumentUrl}" alt="${filename}">`;
        } else {
            const text = await blob.text();
            documentModalBody.innerHTML = `<pre class="document-text">${text.replace(/[&<>]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</pre>`;
        }
    } catch (error) {
        console.error('No pude abrir el archivo en el visor interno:', error);
        documentModalBody.innerHTML = '<div class="source-item">No pude abrir este archivo dentro del visor.</div>';
    }
}

async function openDocumentViewer(caseId, filename, displayName = '') {
    if (!caseId || !filename) return;
    const resolvedName = displayName || filename;
    logTesterActivity('open_documents', { case_id: caseId, filename: resolvedName });
    persistChatContext({
        last_document_title: resolvedName,
        last_document_intent: inferSourceIntent({ titulo: resolvedName }),
        last_case_id: caseId,
        active_case_id: caseId,
    });
    const url = buildCaseFileRequestUrl(caseId, filename, resolvedName, true);
    const lower = filename.toLowerCase();
    documentModalTitle.textContent = `${caseId} · ${resolvedName}`;
    documentModalBody.innerHTML = '<div class="source-item">Cargando archivo...</div>';
    documentModal.classList.remove('hidden');
    try {
        const response = await fetch(url);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const blob = await response.blob();
        if (activeDocumentUrl) {
            URL.revokeObjectURL(activeDocumentUrl);
        }
        activeDocumentUrl = URL.createObjectURL(blob);
        activeDocumentDownloadName = resolvedName;
        if (lower.endsWith('.pdf')) {
            documentModalBody.innerHTML = `<object class="document-frame" data="${activeDocumentUrl}" type="application/pdf"><div class="source-item">No pude mostrar el PDF dentro del visor.</div></object>`;
        } else if (/\.(png|jpg|jpeg|webp|bmp|tif|tiff)$/i.test(lower)) {
            documentModalBody.innerHTML = `<img class="document-image" src="${activeDocumentUrl}" alt="${resolvedName}">`;
        } else {
            documentModalBody.innerHTML = `<div class="source-item">No hay visor embebido para este archivo. <a class="source-link" href="${activeDocumentUrl}" download="${resolvedName}">Descargar archivo</a></div>`;
        }
    } catch (error) {
        console.error('No pude abrir el archivo en el visor:', error);
        documentModalBody.innerHTML = '<div class="source-item">No pude abrir este archivo dentro del visor.</div>';
    }
}

function closeDocumentViewer() {
    documentModal.classList.add('hidden');
    documentModalBody.innerHTML = '';
    if (activeDocumentUrl) {
        URL.revokeObjectURL(activeDocumentUrl);
        activeDocumentUrl = null;
    }
    activeDocumentDownloadName = null;
}

function switchView(viewId) {
    const normalizedViewId = uiMode === 'operator' && viewId === 'adminView' ? 'processView' : viewId;
    workspaceViews.forEach((section) => {
        section.classList.toggle('active', section.id === normalizedViewId);
    });
    viewSwitcher?.querySelectorAll('[data-view]').forEach((button) => {
        button.classList.toggle('active', button.dataset.view === normalizedViewId);
    });
    if (workspaceTitle) {
        workspaceTitle.textContent = viewMeta[normalizedViewId] || 'Imagine';
    }
    if (normalizedViewId === 'processView' && !activeCaseId) {
        renderWorkflowDecision(null);
        if (!getSelectedPackageFiles().length) {
            resetProcessPanels();
            caseStatusLine.classList.remove('processing', 'error');
            caseStatusLine.textContent = defaultProcessStatusText();
            renderProcessChecklist([]);
        }
    }
    if (normalizedViewId === 'processView') {
        loadWorkflowQueueStatus();
    }
    if (normalizedViewId === 'productionView') {
        loadProductionCases();
    }
    if (normalizedViewId === 'searchView' && searchInput) {
        queueMicrotask(() => {
            searchInput.focus();
            searchInput.select();
        });
    }
    if (normalizedViewId === 'reportView') {
        loadFeedbackNotes();
        syncFeedbackNameFromTester();
        queueMicrotask(() => feedbackNoteInput?.focus());
    }
    if (normalizedViewId === 'adminView') {
        loadTesterSummary();
    }
    if (normalizedViewId === 'reviewView') {
        const stats = updateReviewWorkspaceState(activeCasePayload);
        if (stats.hasChecklist && checklistSection && !checklistSection.classList.contains('hidden')) {
            queueMicrotask(() => scrollToElement(checklistSection));
        }
    }
    if (normalizedViewId === 'classificationView') {
        renderClassificationWorkspace(activeCasePayload, activeClassificationFile);
    }
}

function scrollToElement(target) {
    target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function focusVisibleSection(section, fallbackView = 'processView') {
    switchView(fallbackView);
    if (section && !section.classList.contains('hidden')) {
        scrollToElement(section);
        return true;
    }
    return false;
}

function setReviewGuideNote(message = '') {
    if (!reviewGuideNote) return;
    reviewGuideNote.textContent = message;
    reviewGuideNote.classList.toggle('hidden', !message);
}

function focusPackageUpload(openPicker = false) {
    switchView('processView');
    if (!packageFilesInput) return;
    if (openPicker) {
        packageFilesInput.click();
        return;
    }
    scrollToElement(document.querySelector('.case-uploader'));
    packageFilesInput.focus();
}

function showPrecheckFlow() {
    switchView('processView');
    const target = !precheckSection?.classList.contains('hidden')
        ? precheckSection
        : !workflowSection?.classList.contains('hidden')
            ? workflowSection
            : caseDossierSection;
    if (target && !target.classList.contains('hidden')) {
        scrollToElement(target);
        return;
    }
    runWorkflowButton?.focus();
}

function openRecover926Flow() {
    switchView('processView');
    setRecover926Expanded(true);
    scrollToElement(recover926Section);
}

async function openExecutiveReportFlow(caseId) {
    if (!caseId) return;
    logTesterActivity('open_executive_report', { case_id: caseId });
    activeCaseId = caseId;
    await loadActiveCase(caseId);
    switchView('processView');
    const target = !executiveSection?.classList.contains('hidden')
        ? executiveSection
        : !precheckSection?.classList.contains('hidden')
            ? precheckSection
            : !workflowRunSection?.classList.contains('hidden')
                ? workflowRunSection
                : caseDossierSection;
    scrollToElement(target);
}

async function openPrecheckSummaryFlow(caseId) {
    if (!caseId) return;
    logTesterActivity('open_precheck_report', { case_id: caseId });
    activeCaseId = caseId;
    await loadActiveCase(caseId);
    switchView('processView');
    const target = !precheckSection?.classList.contains('hidden')
        ? precheckSection
        : !workflowRunSection?.classList.contains('hidden')
            ? workflowRunSection
            : caseDossierSection;
    scrollToElement(target);
}

async function recoverCaseFlow(caseId, company = '', nit = '') {
    if (!caseId) return;
    logTesterActivity('recover_case', { case_id: caseId, company, nit });
    activeCaseId = caseId;
    const contractLabel = `Contrato ${nit && nit !== 'n/d' ? nit : caseId.replace(/^case-/, '')}`;
    const companyLabel = company || caseId;
    const shouldReprocess = window.confirm(`¿Quieres reprocesar este contrato?\n\n${contractLabel}\n${companyLabel}\n\nSi aceptas, Imagine volverá a ejecutar toda la validación y te mostrará el avance completo.`);
    if (caseProgressTimer) {
        clearInterval(caseProgressTimer);
        caseProgressTimer = null;
    }
    if (caseStatusLine) {
        caseStatusLine.classList.remove('processing', 'error');
        caseStatusLine.textContent = shouldReprocess
            ? `Preparando reproceso de ${contractLabel} · ${companyLabel}...`
            : `Cargando ${contractLabel} · ${companyLabel}...`;
    }
    await loadActiveCase(caseId);
    switchView('processView');
    if (shouldReprocess) {
        const display = resolveContractDisplayName(activeCasePayload);
        startCaseProgress(buildWorkflowProgressMessages(activeCaseId, activeCasePayload?.files || [], display.fullLabel));
        await runWorkflow();
    }
}

function openReviewChecklistFlow() {
    const stats = collectReviewStats(activeCasePayload);
    if (activeCasePayload && stats.hasChecklist) {
        setReviewGuideNote('');
        switchView('classificationView');
        renderClassificationWorkspace(activeCasePayload, activeClassificationFile);
        scrollToElement(classificationContent);
        return;
    }
    switchView('reviewView');
    if (stats.hasChecklist) {
        setReviewGuideNote('No hay documentos pendientes por revisar en este momento.');
    } else {
        setReviewGuideNote('No hay documentos para revisar todavía. Ve a Operación, carga o recupera un lote y luego vuelve a Revisión.');
    }
    scrollToElement(reviewGuideSection);
}

function openReviewCorrectionFlow() {
    if (activeCasePayload && collectReviewStats(activeCasePayload).hasChecklist) {
        setReviewGuideNote('');
        switchView('classificationView');
        renderClassificationWorkspace(activeCasePayload, activeClassificationFile);
        scrollToElement(classificationContent);
        return;
    }
    switchView('reviewView');
    setReviewGuideNote('No hay un contrato activo para corregir. Ve a Operación, carga o recupera un contrato y luego vuelve a Revisión.');
    scrollToElement(reviewGuideSection);
}

function focusSearchFlow() {
    switchView('searchView');
    queueMicrotask(() => {
        searchInput?.focus();
        searchInput?.select();
    });
}

async function openCaseDossierAction(action) {
    if (activeCaseId) {
        try {
            await loadActiveCase(activeCaseId);
        } catch (error) {
            console.warn('No pude refrescar el contrato antes de abrir la sección:', error);
        }
    }
    switch (action) {
        case 'documents':
            openCaseDocumentsFlow(activeCaseId);
            break;
        case 'classification':
            openCaseDocumentsFlow(activeCaseId);
            break;
        case 'precheck':
            if (!focusVisibleSection(precheckSection, 'processView')) {
                showPrecheckFlow();
            }
            break;
        case 'executive':
            if (!focusVisibleSection(executiveSection, 'processView')) {
                showPrecheckFlow();
            }
            break;
        case 'workflow':
            if (!focusVisibleSection(workflowRunSection, 'processView')) {
                showPrecheckFlow();
            }
            break;
        case 'open926': {
            const output926 = activeCasePayload?.analysis?.workflow_run?.output_926 || activeCasePayload?.analysis?.output_926 || {};
            const legacy926 = output926.legacy || {};
            const draft926 = output926.draft || null;
            const filename = legacy926.filename || draft926?.filename || 'archivo_926.txt';
            if (activeCaseId) {
                openCase926Viewer(activeCaseId, filename);
            }
            break;
        }
        default:
            break;
    }
}

function openTechnicalCard(target) {
    applyUiMode('technical');
    switchView('adminView');
    scrollToElement(target);
}

function openCoreCompareFlow() {
    switchView('processView');
    compareCoreSection?.classList.remove('hidden');
    compare926Content?.classList.remove('hidden');
    scrollToElement(compareCoreSection);
}

async function openCaseDocumentsFlow(caseId) {
    if (!caseId) return;
    logTesterActivity('open_classification', { case_id: caseId });
    activeCaseId = caseId;
    await loadActiveCase(caseId);
    switchView('classificationView');
    queueMicrotask(() => scrollToElement(classificationContent));
}

async function handleFlowAction(action) {
    switch (action) {
        case 'focus-package-upload':
            focusPackageUpload(true);
            break;
        case 'show-precheck':
            showPrecheckFlow();
            break;
        case 'open-recover-926':
            openRecover926Flow();
            break;
        case 'open-review-checklist':
            openReviewChecklistFlow();
            break;
        case 'open-review-correction':
            openReviewCorrectionFlow();
            break;
        case 'focus-search':
            focusSearchFlow();
            break;
        case 'refresh-status':
            openTechnicalCard(adminStatusCard);
            await loadSystemStatus();
            break;
        case 'show-services-status':
            openTechnicalCard(adminServicesCard);
            break;
        case 'show-evaluation-card':
            openTechnicalCard(adminEvalCard);
            break;
        case 'open-compare-926':
            openCoreCompareFlow();
            break;
        default:
            break;
    }
}

async function loadFeedbackNotes() {
    if (!feedbackNotesContent) return;
    feedbackNotesContent.innerHTML = '<div class="source-item">Cargando comentarios...</div>';
    try {
        const response = await fetch(`${API_URL}/api/feedback-notes`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items.slice().reverse() : [];
        if (!items.length) {
            feedbackNotesContent.innerHTML = '<div class="source-item">Aún no hay comentarios registrados.</div>';
            return;
        }
        feedbackNotesContent.innerHTML = items.map((item) => `
            <article class="report-detail-row feedback-note-card">
                <strong class="feedback-note-name">${escapeHtml(String(item.name || 'Sin nombre'))}</strong>
                <div class="feedback-note-meta">Fecha y hora: ${escapeHtml(formatUiDateTime(item.created_at))}</div>
                <div class="feedback-note-text">${escapeHtml(normalizeReviewLabel(item.text || item.comment || ''))}</div>
            </article>
        `).join('');
    } catch (error) {
        console.error('No pude cargar los comentarios:', error);
        feedbackNotesContent.innerHTML = '<div class="source-item">No pude cargar los comentarios.</div>';
    }
}

async function saveFeedbackNote() {
    const tester = ensureTesterSelected('comentario');
    if (!tester) return;
    const name = tester.name || String(feedbackNameInput?.value || '').trim();
    const text = String(feedbackNoteInput?.value || '').trim();
    if (!name || !text) return;
    if (feedbackNoteButton) feedbackNoteButton.disabled = true;
    if (feedbackSaveStatus) {
        feedbackSaveStatus.classList.add('hidden');
        feedbackSaveStatus.textContent = '';
    }
    try {
        const response = await fetch(`${API_URL}/api/feedback-notes`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, text }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        const createdAt = formatUiDateTime(payload?.item?.created_at || '');
        const textPreview = summarizeFeedbackText(payload?.item?.text || text);
        if (feedbackNameInput) feedbackNameInput.value = '';
        if (feedbackNoteInput) feedbackNoteInput.value = '';
        syncFeedbackNameFromTester();
        logTesterActivity('feedback_saved', { text_preview: text.slice(0, 160) });
        await loadFeedbackNotes();
        if (feedbackSaveStatus) {
            feedbackSaveStatus.textContent = `Comentario registrado por ${name}${createdAt && createdAt !== 'n/d' ? ` · ${createdAt}` : ''}.${textPreview ? ` ${textPreview}` : ''}`;
            feedbackSaveStatus.classList.remove('hidden');
        }
        stopCaseProgress(`Comentario registrado por ${name}${createdAt && createdAt !== 'n/d' ? ` · ${createdAt}` : ''}.${textPreview ? ` ${textPreview}` : ''}`);
        setTimeout(() => {
            switchView('processView');
        }, 1200);
    } catch (error) {
        console.error('No pude guardar el comentario:', error);
        if (feedbackSaveStatus) {
            feedbackSaveStatus.textContent = 'No pude guardar el comentario.';
            feedbackSaveStatus.classList.remove('hidden');
        }
        addMessage('No pude guardar el comentario de mejora.', 'nova');
    } finally {
        if (feedbackNoteButton) feedbackNoteButton.disabled = false;
    }
}

async function submitFeedbackNote(event) {
    event?.preventDefault?.();
    await saveFeedbackNote();
}

async function handleFeedbackTextareaKeydown(event) {
    if (event.key !== 'Enter' || event.shiftKey) return;
    event.preventDefault();
    await saveFeedbackNote();
}

function bindFlowActions(root = document) {
    root.querySelectorAll('[data-flow-action]').forEach((element) => {
        if (element.dataset.flowBound === 'true') return;
        const invoke = async (event) => {
            if (event.type === 'keydown' && !['Enter', ' '].includes(event.key)) {
                return;
            }
            if (event.type === 'keydown') {
                event.preventDefault();
            }
            event.stopPropagation();
            const action = element.dataset.flowAction || '';
            if (action === 'focus-package-upload') {
                focusPackageUpload(true);
                return;
            }
            await handleFlowAction(action);
        };
        element.addEventListener('click', invoke);
        element.addEventListener('keydown', invoke);
        element.dataset.flowBound = 'true';
    });
}

function applyUiMode(mode) {
    uiMode = mode === 'technical' ? 'technical' : 'operator';
    viewSwitcher?.querySelectorAll('[data-view="adminView"]').forEach((button) => {
        button.classList.toggle('hidden', uiMode !== 'technical');
    });
    modeSwitcher?.querySelectorAll('[data-mode]').forEach((button) => {
        button.classList.toggle('active', button.dataset.mode === uiMode);
    });
    try {
        window.localStorage.setItem(UI_MODE_KEY, uiMode);
    } catch (error) {
        console.error('No pude persistir el modo UI:', error);
    }
    if (uiMode !== 'technical') {
        const adminView = document.getElementById('adminView');
        if (adminView?.classList.contains('active')) {
            switchView('processView');
        }
    }
}

function loadUiMode() {
    applyUiMode('technical');
}

function resetSearchWorkspace() {
    chatContainer.innerHTML = '';
    renderSources([]);
    renderWorkflowDecision(null);
    renderCaseSearch([]);
}

function setSearchActivityState(isSearching, message = 'Consultando contrato y documentos...') {
    if (searchActivity) {
        if (searchActivityLabel) {
            searchActivityLabel.textContent = message;
        }
        searchActivity.classList.toggle('hidden', !isSearching);
    }
    if (sendButton) {
        sendButton.disabled = isSearching;
        sendButton.textContent = isSearching ? 'Buscando...' : 'Enviar';
    }
    if (searchInput) {
        searchInput.disabled = isSearching;
    }
}

async function copyText(text, trigger) {
    if (!text) return;
    const original = trigger?.textContent;
    try {
        await navigator.clipboard.writeText(text);
        if (trigger) {
            trigger.textContent = 'Copiado';
            setTimeout(() => {
                trigger.textContent = original;
            }, 1600);
        }
    } catch (error) {
        console.error('No pude copiar el texto:', error);
    }
}

async function searchCaseContracts(query) {
    if (!query || query.trim().length < 2) {
        renderCaseSearch([]);
        return;
    }
    try {
    const response = await fetch(`${API_URL}/api/cases/search?q=${encodeURIComponent(query.trim())}&limit=8`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        renderCaseSearch(data.results || []);
    } catch (error) {
        console.error('Error buscando empresas o independientes:', error);
        renderCaseSearch([]);
    }
}

function getSelectedPackageFiles() {
    return Array.from(packageFilesInput?.files || []);
}

function describeSelectedPackage(files) {
    const counts = {
        xlsx: 0,
        pdf: 0,
        zip: 0,
        image: 0,
        other: 0
    };
    for (const file of files) {
        const name = file.name.toLowerCase();
        if (name.endsWith('.xlsx') || name.endsWith('.xls') || name.endsWith('.xlsm')) {
            counts.xlsx += 1;
        } else if (name.endsWith('.pdf')) {
            counts.pdf += 1;
        } else if (name.endsWith('.zip')) {
            counts.zip += 1;
        } else if (/\.(png|jpg|jpeg|tif|tiff|bmp|webp)$/.test(name)) {
            counts.image += 1;
        } else {
            counts.other += 1;
        }
    }
    return counts;
}

function deriveCaseLabel(files) {
    const xlsx = files.find((file) => /\.(xlsx|xls|xlsm)$/i.test(file.name));
    if (xlsx) {
        return xlsx.name.replace(/\.[^.]+$/, '');
    }
    const zip = files.find((file) => /\.zip$/i.test(file.name));
    if (zip) {
        return zip.name.replace(/\.[^.]+$/, '');
    }
    const first = files[0];
    if (first) {
        return first.name.replace(/\.[^.]+$/, '');
    }
    return `afiliacion-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}`;
}

function normalizeCaseLabel(value = '') {
    return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\.[^.]+$/, '')
        .replace(/\s+/g, ' ')
        .trim();
}

async function tryRecoverRecentlyCreatedCase(label = '') {
    const normalizedLabel = normalizeCaseLabel(label);
    if (!normalizedLabel) return null;
    try {
        const response = await fetchWithRetry(`${API_URL}/api/cases?limit=10`);
        const data = await response.json();
        const cases = Array.isArray(data?.cases) ? data.cases : [];
        const now = Date.now();
        const match = cases.find((item) => {
            const itemLabel = normalizeCaseLabel(item?.label || '');
            if (itemLabel !== normalizedLabel) return false;
            const createdAt = Date.parse(String(item?.created_at || item?.updated_at || ''));
            if (!Number.isFinite(createdAt)) return true;
            return Math.abs(now - createdAt) <= 10 * 60 * 1000;
        });
        return match || null;
    } catch (error) {
        console.error('No pude recuperar el contrato recién creado:', error);
        return null;
    }
}

async function loadSystemStatus() {
    try {
        const response = await fetch(`${API_URL}/api/system/status`);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const data = await response.json();
        renderSystemStatus(data);
    } catch (error) {
        console.error('Error cargando estado del sistema:', error);
        overallStatusText.textContent = 'No se pudo cargar el estado del sistema';
        overallStatusBadge.textContent = 'ERROR';
        overallStatusBadge.className = 'status-badge degraded';
        modelsText.textContent = `Backend esperado en ${API_URL}`;
        servicesGrid.innerHTML = '';
        actionsList.innerHTML = '<div class="action-card"><strong>Revisar backend</strong><p>El panel de control no pudo obtener el estado centralizado de Imagine.</p></div>';
    }
}

async function reindexKnowledge() {
    reindexButton.disabled = true;
    reindexButton.textContent = 'Reindexando...';
    try {
        const response = await fetch(`${API_URL}/api/system/reindex`, { method: 'POST' });
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        addMessage(`Corpus reindexado: ${data.documents} documentos y ${data.chunks} chunks.`, 'nova');
        await loadSystemStatus();
    } catch (error) {
        console.error('Error reindexando conocimiento:', error);
        addMessage('No pude reindexar el corpus desde el panel de control.', 'nova');
    } finally {
        reindexButton.disabled = false;
        reindexButton.textContent = 'Reindexar conocimiento';
    }
}

async function exportManualReviewsDataset() {
    if (!exportReviewsButton) return;
    const original = exportReviewsButton.textContent;
    exportReviewsButton.disabled = true;
    exportReviewsButton.textContent = 'Exportando...';
    try {
        const response = await fetch(`${API_URL}/api/evals/document-reviews/export`);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const blob = await response.blob();
        const filename = 'document_reviews.jsonl';
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
        exportReviewsButton.textContent = 'Exportado';
        setTimeout(() => {
            exportReviewsButton.textContent = original;
        }, 1200);
    } catch (error) {
        console.error('No pude exportar las revisiones:', error);
        exportReviewsButton.textContent = original;
    } finally {
        exportReviewsButton.disabled = false;
    }
}

async function sendMessage() {
    const message = searchInput.value.trim();
    if (!message) return;
    if (!ensureTesterSelected('búsqueda')) return;
    const detectedIntent = detectClientIntent(message);
    const effectiveMessage = expandClientFollowupQuery(message);
    const liveChatContext = readChatContext();
    const liveProcessState = readProcessState();
    const liveProfile = (activeCasePayload?.analysis?.xlsx_profile || {}).profile || {};
    const requestContext = {
        ...buildSearchRequestContext(message),
        active_case_id: activeCaseId || liveProcessState.activeCaseId || liveChatContext.active_case_id || liveChatContext.last_case_id || '',
        active_company: liveProfile.empresa || liveChatContext.active_company || '',
        active_nit: liveProfile.nit || liveProfile.documento_empleador || liveChatContext.active_nit || '',
        active_document: liveProfile.documento || liveChatContext.active_document || '',
        last_case_id: liveChatContext.last_case_id || activeCaseId || liveProcessState.activeCaseId || '',
        last_query: liveChatContext.last_query || '',
        last_intent: liveChatContext.last_intent || detectedIntent,
        last_document_title: liveChatContext.last_document_title || '',
        last_document_intent: liveChatContext.last_document_intent || '',
        last_sources: Array.isArray(liveChatContext.last_sources) ? liveChatContext.last_sources.slice(0, 8) : [],
        last_source_index: Number.isFinite(Number(liveChatContext.last_source_index)) ? Number(liveChatContext.last_source_index) : 0,
    };

    resetSearchWorkspace();
    addMessage(message, 'user');
    searchInput.value = '';
    setSearchActivityState(true);
    const busquedaMsg = addMessage('Buscando en contratos, documentos y reglas operativas...', 'nova');
    persistChatContext({ last_query: message, last_intent: detectedIntent });
    logTesterActivity('search_sent', {
        query: message.slice(0, 180),
        active_case_id: requestContext.active_case_id || '',
    });

    try {
        const payload = { consulta: effectiveMessage, contexto: requestContext };
        window.__novaDebugRequestContext = requestContext;
        window.__novaDebugPayload = payload;
        const [response, workflowResponse] = await Promise.all([
            fetch(`${API_URL}/api/afiliacion/consultar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }),
            fetch(`${API_URL}/api/afiliacion/operar`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
        ]);
        if (!response.ok || !workflowResponse.ok) {
            throw new Error(`HTTP ${response.status}/${workflowResponse.status}`);
        }

        const [data, workflow] = await Promise.all([response.json(), workflowResponse.json()]);
        const sourceCaseId = extractCaseIdFromSources(data.fuentes || []);
        const normalizedSources = normalizeSourceMemory(data.fuentes || []);
        persistChatContext({
            last_query: message,
            last_intent: detectedIntent,
            last_case_id: sourceCaseId || activeCaseId || readChatContext().last_case_id || '',
            last_document_title: (data.fuentes || [])[0]?.titulo || readChatContext().last_document_title || '',
            last_document_intent: normalizedSources[0]?.intent || readChatContext().last_document_intent || '',
            last_sources: normalizedSources,
            last_source_index: 0,
        });
        if (busquedaMsg && busquedaMsg.parentNode) busquedaMsg.remove();
        addMessage(data.respuesta, 'nova', data.fuentes || []);
        if ((data.respuesta || '').includes('Coincidencias encontradas:')) {
            await searchCaseContracts(message);
        } else {
            renderCaseSearch([]);
        }
        renderSources(data.fuentes || []);
        renderWorkflowDecision(workflow);
    } catch (error) {
        console.error('Error consultando Imagine:', error);
        addMessage(`Error de conexión con Imagine (${API_LABEL})`, 'nova');
        renderSources([]);
        renderWorkflowDecision(null);
    } finally {
        setSearchActivityState(false);
    }
}

async function createCase() {
    if (!ensureTesterSelected('cargar contrato')) return null;
    const files = getSelectedPackageFiles();
    if (!files.length) {
        stopCaseProgress('Debes cargar el paquete completo.', true);
        return null;
    }
    const xlsxCount = files.filter((file) => /\.(xlsx|xlsm|xls)$/i.test(file.name)).length;
    const pdfCount = files.filter((file) => /\.pdf$/i.test(file.name)).length;
    if (files.length < 2 || xlsxCount < 1 || pdfCount < 1) {
        stopCaseProgress('Debes cargar mínimo 2 archivos: un Excel en formato XLSX y al menos un PDF.', true);
        return null;
    }
    const label = deriveCaseLabel(files);
    closeDocumentViewer();
    resetProcessPanels();
    activeCaseId = null;
    activeCasePayload = null;
    clearProcessState();

    if (createCaseButton) createCaseButton.disabled = true;
        if (runWorkflowButton) runWorkflowButton.disabled = true;
        if (runWorkflowInlineButton) runWorkflowInlineButton.disabled = true;
    startCaseProgress(buildUploadProgressMessages(files));
    try {
        const form = new FormData();
        form.append('label', label);
        for (const file of files) {
            form.append('files', file);
        }
        const response = await fetchWithRetry(`${API_URL}/api/cases`, { method: 'POST', body: form }, 2, 500);
        const data = await response.json();
        activeCasePayload = data;
        activeCaseId = data.id;
        persistProcessState({ activeCaseId: data.id });
        updateChatContextFromCasePayload(data);
        logTesterActivity('case_created', {
            case_id: data.id,
            label: data.label || '',
            files: Array.isArray(data.files) ? data.files.length : 0,
        });
        const rejectedFiles = Array.isArray(data?.upload_summary?.rejected_files) ? data.upload_summary.rejected_files : [];
        const uploadSuffix = rejectedFiles.length
            ? ` Se omitieron ${rejectedFiles.length} archivo(s): ${rejectedFiles.map((item) => `${item.filename} (${item.reason})`).join('; ')}.`
            : '';
        stopCaseProgress(`${formatCaseHandle(data.id, data.label)} cargado con ${data.files.length} archivo(s) listos para ejecutar.${uploadSuffix}`);
        addMessage(`Paquete cargado: ${data.label} (${data.files.length} archivo(s) procesables).`, 'nova');
        renderCaseDossier(data);
        renderCaseChecklist(null);
        renderWorkflowDecision(null);
        renderPrecheckReport(null);
        renderExecutiveReport(null);
        renderWorkflowRun(null);
        return data;
    } catch (error) {
        console.error('Error creando registro:', error);
        const detail = String(error?.message || '').trim();
        const recovered = await tryRecoverRecentlyCreatedCase(label);
        if (recovered?.id) {
            const recoveredPayload = await loadActiveCase(recovered.id);
            if (recoveredPayload?.id) {
                stopCaseProgress(`${formatCaseHandle(recoveredPayload.id, recoveredPayload.label)} quedó cargado aunque hubo un corte momentáneo de conexión.`);
                addMessage(`Recuperé el contrato ${recoveredPayload.label} después del corte de conexión.`, 'nova');
                return recoveredPayload;
            }
        }
        const friendlyDetail = getFriendlyRequestError(detail, 'upload');
        stopCaseProgress(
            friendlyDetail || 'No se pudo crear el contrato con los archivos enviados.',
            true
        );
        return null;
    } finally {
        if (createCaseButton) createCaseButton.disabled = false;
        if (runWorkflowButton) runWorkflowButton.disabled = false;
        if (runWorkflowInlineButton) runWorkflowInlineButton.disabled = false;
    }
}

async function runWorkflow() {
    if (!ensureTesterSelected('ejecutar proceso')) return;
    if (workflowLaunchInFlight) {
        addMessage('Ya hay una solicitud de ejecución en curso para este contrato. Espera un momento antes de volver a intentarlo.', 'nova');
        return;
    }
    let files = getSelectedPackageFiles();
    const previousUpdatedAt = String(activeCasePayload?.updated_at || '').trim();
    if (!activeCaseId) {
        const created = await createCase();
        if (!created?.id) {
            return;
        }
    }

    workflowLaunchInFlight = true;
    if (runWorkflowButton) runWorkflowButton.disabled = true;
    if (runWorkflowInlineButton) runWorkflowInlineButton.disabled = true;
    if (createCaseButton) createCaseButton.disabled = true;
    if (!files.length && Array.isArray(activeCasePayload?.files)) {
        files = activeCasePayload.files;
    }
    const display = resolveContractDisplayName(activeCasePayload);
    startCaseProgress(buildWorkflowProgressMessages(activeCaseId, files, display.fullLabel));
    logTesterActivity('workflow_started', {
        case_id: activeCaseId || '',
        label: activeCasePayload?.label || '',
        files: Array.isArray(files) ? files.length : 0,
    });
    try {
        const response = await fetchWithRetry(`${API_URL}/api/cases/${activeCaseId}/run-workflow`, {
            method: 'POST',
            timeoutMs: 30000,
        }, 1, 0);
        const data = await response.json();
        activeCasePayload = data;
        updateChatContextFromCasePayload(data);
        const queueStatus = data.analysis?.queue_status || {};
        if (queueStatus.state === 'queued') {
            try { renderCaseDossier(data); } catch(e) { console.warn('renderCaseDossier:', e.message); }
            loadWorkflowQueueStatus();
            const active = queueStatus.active || {};
            const activeCompany = active.empresa || active.label || active.case_id || 'otro contrato';
            stopCaseProgress(`Tu contrato quedó en cola. Hay un contrato en ejecución: ${activeCompany}. Se procesará cuando termine el actual.`);
            startWorkflowStatusPolling(activeCaseId);
            workflowLaunchInFlight = false;
            return;
        }
        if (queueStatus.state === 'processing' || String((data.analysis?.workflow_run || {}).status || '').trim().toLowerCase() === 'processing') {
            try { renderCaseDossier(data); } catch(e) { console.warn('renderCaseDossier:', e.message); }
            try { renderCaseChecklist(null); } catch(e) { console.warn('renderCaseChecklist:', e.message); }
            try { renderWorkflowDecision(null); } catch(e) { console.warn('renderWorkflowDecision:', e.message); }
            try { renderPrecheckReport(null); } catch(e) { console.warn('renderPrecheckReport:', e.message); }
            try { renderExecutiveReport(null); } catch(e) { console.warn('renderExecutiveReport:', e.message); }
            try { renderWorkflowRun(data.analysis?.workflow_run || null); } catch(e) { console.warn('renderWorkflowRun:', e.message); }
            loadWorkflowQueueStatus();
            startWorkflowStatusPolling(activeCaseId);
            addMessage(`La nueva corrida de ${data.label || activeCaseId} quedó en ejecución.`, 'nova');
            workflowLaunchInFlight = false;
            return;
        }
        const analysis = data.analysis || {};
        const workflowRun = analysis.workflow_run || null;
        try { renderCaseDossier(data); } catch(e) { console.warn('renderCaseDossier:', e.message); }
        try { renderCaseChecklist(analysis.checklist || null, analysis.validacion_resumen || null, data); } catch(e) { console.warn('renderCaseChecklist:', e.message); }
        try { renderCaseDecision(analysis.decision || null, analysis.xlsx_profile || {}); } catch(e) { console.warn('renderCaseDecision:', e.message); }
        try { renderPrecheckReport(workflowRun?.executive_report_precheck || analysis.reporte_ejecutivo || null); } catch(e) { console.warn('renderPrecheckReport:', e.message); }
        try { renderExecutiveReport(workflowRun?.executive_report_final || null, workflowRun?.output_926 || analysis.output_926 || null); } catch(e) { console.warn('renderExecutiveReport:', e.message); }
        try { renderWorkflowRun(workflowRun); } catch(e) { console.warn('renderWorkflowRun:', e.message); }
        try { renderClassificationWorkspace(data, activeClassificationFile); } catch(e) { console.warn('renderClassificationWorkspace:', e.message); }
        loadRecoverable926Cases();
        loadWorkflowQueueStatus();
        const _label = data.label || activeCaseId;
        const finalSummary = workflowRun?.executive_report_final?.resumen_ejecutivo || {};
        const finalState = finalSummary.estado || finalSummary.estado_final || workflowRun?.status || data.status || 'proceso completado';
        const coreFile = ((workflowRun?.output_926 || analysis.output_926 || {}).legacy || {}).filename || '';
        const progressMessage = coreFile
            ? `${_label} · ${finalState} · CORE listo (${coreFile})`
            : `${_label} · ${finalState}`;
        stopCaseProgress(progressMessage);
        addMessage(`Proceso automático ${workflowRun?.status || 'ejecutado'} para ${data.label}.`, 'nova');
    } catch (error) {
        console.error('Error ejecutando flujo del contrato:', error);
        const detail = String(error?.message || '').trim();
        if (activeCaseId) {
            try {
                await loadActiveCase(activeCaseId);
                const connectionLoss = isConnectionErrorMessage(detail);
                const recoveredWorkflow = activeCasePayload?.analysis?.workflow_run || {};
                const recoveredStopReason = String(recoveredWorkflow.stop_reason || '').trim();
                const recoveredFailed = String(recoveredWorkflow.status || '').trim().toLowerCase() === 'failed';
                const recoveredStatus = String(recoveredWorkflow.status || activeCasePayload?.status || '').trim();
                const recoveredUpdatedAt = String(activeCasePayload?.updated_at || '').trim();
                const recoveredCompany = String(
                    activeCasePayload?.analysis?.xlsx_profile?.profile?.empresa
                    || activeCasePayload?.label
                    || activeCaseId
                    || 'Contrato'
                ).trim();
                const recoveredTerminal = ['completed', 'stopped_prevalidacion', 'failed'].includes(recoveredStatus.toLowerCase());
                const reusedPreviousResult = Boolean(previousUpdatedAt && recoveredUpdatedAt && previousUpdatedAt === recoveredUpdatedAt);
                if (recoveredTerminal && reusedPreviousResult) {
                    clearCaseProgressDisplay(`${recoveredCompany} · ${recoveredStatus || 'finalizado'} · no hubo nueva ejecución`);
                    addMessage('No se generó una nueva corrida del contrato. La pantalla volvió al último resultado guardado.', 'nova');
                    return;
                }
                stopCaseProgress(
                    recoveredFailed && recoveredStopReason
                        ? `El flujo falló: ${recoveredStopReason}`
                        : connectionLoss
                        ? 'Se perdió la conexión con la plataforma durante la prevalidación. Recuperé el estado real del contrato.'
                        : recoveredTerminal
                        ? `${recoveredCompany} · ${recoveredStatus || 'finalizado'} · estado real recuperado`
                        : 'Recargué el estado real del contrato.',
                    recoveredFailed ? true : connectionLoss ? false : true,
                );
                if (recoveredFailed && recoveredStopReason) {
                    addMessage(`El flujo del contrato falló: ${recoveredStopReason}`, 'nova');
                } else if (connectionLoss) {
                    addMessage('Se perdió la conexión durante la validación, pero ya recuperé el estado real del contrato.', 'nova');
                }
                return;
            } catch (reloadError) {
                console.error('No pude recargar el contrato después del error:', reloadError);
            }
        }
        const friendlyDetail = getFriendlyRequestError(detail, 'workflow');
        stopCaseProgress(
            friendlyDetail && !friendlyDetail.startsWith('HTTP ')
                ? `No pude ejecutar el flujo automático. ${friendlyDetail}`
                : 'No pude ejecutar el flujo automático.',
            true,
        );
    } finally {
        workflowLaunchInFlight = false;
        if (runWorkflowButton) runWorkflowButton.disabled = false;
        if (runWorkflowInlineButton) runWorkflowInlineButton.disabled = false;
        if (createCaseButton) createCaseButton.disabled = false;
    }
}

async function loadActiveCase(caseId) {
    if (!caseId) return;
    try {
        clearCaseProgressDisplay('');
        syncProcessDashboardPanels(true);
        const response = await fetch(`${API_URL}/api/cases/${encodeURIComponent(caseId)}`);
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        activeCasePayload = data;
        updateChatContextFromCasePayload(data);
        const analysis = data.analysis || {};
        const workflowRun = analysis.workflow_run || null;
        try { renderCaseDossier(data); } catch(e) { console.warn('renderCaseDossier:', e.message); }
        try { renderCaseChecklist(analysis.checklist || null, analysis.validacion_resumen || null, data); } catch(e) { console.warn('renderCaseChecklist:', e.message); }
        try { renderCaseDecision(analysis.decision || null, analysis.xlsx_profile || {}); } catch(e) { console.warn('renderCaseDecision:', e.message); }
        try { renderPrecheckReport(workflowRun?.executive_report_precheck || analysis.reporte_ejecutivo || null); } catch(e) { console.warn('renderPrecheckReport:', e.message); }
        try { renderExecutiveReport(workflowRun?.executive_report_final || null, workflowRun?.output_926 || analysis.output_926 || null); } catch(e) { console.warn('renderExecutiveReport:', e.message); }
        try { renderWorkflowRun(workflowRun); } catch(e) { console.warn('renderWorkflowRun:', e.message); }
        try { renderColmenaWorkbench(data, activeColmenaWorkbenchFile); } catch(e) { console.warn('renderColmenaWorkbench:', e.message); }
        const _empresa = (data.analysis?.xlsx_profile?.profile?.empresa) || data.label || caseId;
        const statusText = `${_empresa} · ${workflowRun?.status || data.status || 'cargado'}`;
        const terminalWorkflowStates = new Set(['completed', 'stopped_prevalidacion', 'failed']);
        const workflowState = String(workflowRun?.status || data.status || '').trim().toLowerCase();
        if (terminalWorkflowStates.has(workflowState)) {
            workflowLaunchInFlight = false;
            clearCaseProgressDisplay(statusText);
            persistProcessState({ activeCaseId: null, processing: false, error: false, statusText });
            if (runWorkflowButton) runWorkflowButton.disabled = false;
            if (runWorkflowInlineButton) runWorkflowInlineButton.disabled = false;
            if (createCaseButton) createCaseButton.disabled = false;
        } else {
            loadWorkflowQueueStatus();
            if (caseStatusLine) {
                caseStatusLine.classList.remove('processing', 'error');
                caseStatusLine.textContent = statusText;
            }
            persistProcessState({ activeCaseId: caseId, processing: false, error: false, statusText });
        }
    } catch (error) {
        console.error('No pude cargar el detalle del contrato activo:', error);
        const detail = String(error?.message || '').trim();
        if (detail === 'HTTP 404') {
            activeCaseId = null;
            activeCasePayload = null;
            clearProcessState();
            syncProcessDashboardPanels(false);
            if (caseStatusLine) {
                caseStatusLine.classList.remove('processing', 'error');
                caseStatusLine.textContent = defaultProcessStatusText();
            }
            renderCaseDossier(null);
            renderCaseChecklist(null);
            renderWorkflowDecision(null);
            renderPrecheckReport(null);
            renderExecutiveReport(null);
            renderWorkflowRun(null);
            renderClassificationWorkspace(null);
            renderColmenaWorkbench(null);
            return;
        }
        syncProcessDashboardPanels(false);
        if (caseStatusLine) {
            caseStatusLine.classList.remove('processing');
            caseStatusLine.classList.add('error');
            caseStatusLine.textContent = 'Error cargando: ' + (error.message || 'desconocido');
        }
    }
}

function renderStructuredText(text) {
    const wrap = document.createElement('div');
    wrap.className = 'nova-response';
    const lines = text.split('\n');
    let html = '';
    let inList = false;
    for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) { if (inList) { html += '</ul>'; inList = false; } continue; }
        if (line.endsWith(':') && !line.startsWith('-') && line.length < 70) {
            if (inList) { html += '</ul>'; inList = false; }
            const title = line.replace(/:$/, '');
            const icons = {
                'Empresa o independiente identificado':'🏢','Estado operativo':'📋',
                'Adjuntos clasificados':'📁','Documentos disponibles para abrir':'📄',
                'Siguiente paso':'➡️','Respuesta ejecutiva':'✦','Hallazgos':'⚠️',
                'Reporte ejecutivo de prevalidacion':'📊','Reporte ejecutivo del caso contrato':'📊',
                'Observaciones':'🔍','Acciones recomendadas':'✅','Coincidencias encontradas':'🔎',
                'Coincidencias documentales':'📎','Motivo del rechazo':'❌',
            };
            const icon = Object.entries(icons).find(([k]) => title.includes(k))?.[1] || '•';
            html += `<div class="nova-section-title"><span class="nova-section-icon">${icon}</span><span>${title}</span></div>`;
            continue;
        }
        if (line.startsWith('- ')) {
            if (!inList) { html += '<ul class="nova-list">'; inList = true; }
            const content = line.substring(2);
            const colonIdx = content.indexOf(':');
            if (colonIdx > 0 && colonIdx < 35) {
                const key = content.substring(0, colonIdx).trim();
                const val = content.substring(colonIdx + 1).trim();
                if (val) {
                    let valHtml = val;
                    if (val === 'APROBADA') valHtml = `<span class="nova-badge nova-badge-ok">APROBADA</span>`;
                    if (val === 'NO APROBADA' || val === 'RECHAZADA') valHtml = `<span class="nova-badge nova-badge-error">${val}</span>`;
                    html += `<li><span class="nova-item-key">${key}</span><span class="nova-item-val">${valHtml}</span></li>`;
                } else { html += `<li>${content}</li>`; }
            } else { html += `<li>${content}</li>`; }
            continue;
        }
        if (inList) { html += '</ul>'; inList = false; }
        html += `<p class="nova-text-line">${line}</p>`;
    }
    if (inList) html += '</ul>';
    wrap.innerHTML = html;
    return wrap;
}

function addMessage(text, sender, sources = []) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender}`;

    const content = document.createElement('div');
    content.className = 'message-content';
    if (sender === 'nova') {
        content.appendChild(renderStructuredText(text));
    } else {
        content.textContent = text;
    }

    messageDiv.appendChild(content);
    if (sender === 'nova' && Array.isArray(sources) && sources.length) {
        const docsBlock = document.createElement('div');
        docsBlock.className = 'message-doc-actions';
        const title = document.createElement('div');
        title.className = 'panel-label';
        title.textContent = 'Documentos';
        docsBlock.appendChild(title);
        const quickGroups = buildQuickSourceGroups(sources);
        if (quickGroups.length) {
            const quickRow = document.createElement('div');
            quickRow.className = 'message-doc-inline-actions';
            for (const item of quickGroups) {
                const quickButton = document.createElement('button');
                quickButton.type = 'button';
                quickButton.className = 'search-button compact-button';
                quickButton.textContent = item.label;
                quickButton.addEventListener('click', () => {
                    openDocumentUrlViewer(item.source.source_url, item.source.titulo || 'archivo');
                });
                quickRow.appendChild(quickButton);
            }
            docsBlock.appendChild(quickRow);
        }
        for (const [index, source] of sources.slice(0, 8).entries()) {
            if (!source.source_url) continue;
            const actionRow = document.createElement('div');
            actionRow.className = 'message-doc-inline-actions';
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'search-button secondary compact-button';
            const typeLabel = source.document_type || 'documento';
            button.textContent = `${source.titulo} · ${typeLabel}`;
            button.addEventListener('click', () => {
                persistChatContext({
                    last_document_title: source.titulo || 'archivo',
                    last_document_intent: inferSourceIntent(source),
                    last_source_index: index,
                });
                openDocumentUrlViewer(source.source_url, source.titulo || 'archivo');
            });
            actionRow.appendChild(button);
            const caseId = extractCaseIdFromSourceUrl(source.source_url);
            if (caseId) {
                const caseButton = document.createElement('button');
                caseButton.type = 'button';
                caseButton.className = 'search-button compact-button';
                caseButton.textContent = 'Ver contrato';
                caseButton.addEventListener('click', async () => {
                    await openCaseFromSourceUrl(source.source_url);
                });
                actionRow.appendChild(caseButton);
            }
            docsBlock.appendChild(actionRow);
        }
        if (docsBlock.children.length > 1) {
            messageDiv.appendChild(docsBlock);
        }
    }
    chatContainer.appendChild(messageDiv);
    chatContainer.scrollTop = chatContainer.scrollHeight;
    return messageDiv;
}

function toggleSources() {
    if (!sourcesSection || !toggleIcon) return;
    sourcesSection.classList.toggle('expanded');
    toggleIcon.textContent = sourcesSection.classList.contains('expanded') ? '▲' : '▼';
}

function renderSources(sources) {
    if (!sourcesContent) return;
    sourcesContent.innerHTML = '';

    if (!sources.length) {
        sourcesContent.innerHTML = '<div class="source-item">No hay fuentes para esta respuesta.</div>';
        return;
    }

    const quickGroups = buildQuickSourceGroups(sources);
    if (quickGroups.length) {
        const quickCard = document.createElement('div');
        quickCard.className = 'source-item';
        quickCard.innerHTML = `
            <strong>Accesos rápidos</strong>
            <div class="service-role">Abre directamente los soportes clave detectados en la respuesta.</div>
            <div class="source-action-row">
                ${quickGroups.map((item) => `<button class="search-button compact-button" type="button" data-quick-source-url="${encodeURIComponent(item.source.source_url || '')}" data-quick-source-title="${encodeURIComponent(item.source.titulo || 'archivo')}">${item.label}</button>`).join('')}
            </div>
        `;
        sourcesContent.appendChild(quickCard);
    }

    for (const [index, source] of sources.entries()) {
        const sourceItem = document.createElement('div');
        sourceItem.className = 'source-item';
        const relevancia = source.relevancia ? ` (${Math.round(source.relevancia * 100)}%)` : '';
        const meta = `
            <div class="source-meta">
                <span class="source-chip">${source.topic || 'sin-topic'}</span>
                <span class="source-chip">${source.document_type || 'sin-tipo'}</span>
            </div>
        `;
        const sourceLink = source.source_url
            ? `
                <div class="source-action-row">
                    <button class="search-button secondary compact-button" type="button" data-source-url="${encodeURIComponent(source.source_url)}" data-source-title="${encodeURIComponent(source.titulo || 'archivo')}">Ver</button>
                    ${extractCaseIdFromSourceUrl(source.source_url) ? `<button class="search-button compact-button" type="button" data-source-case="${extractCaseIdFromSourceUrl(source.source_url)}">Ver contrato</button>` : ''}
                </div>
            `
            : '';
        sourceItem.innerHTML = `
            <strong>${source.titulo}${relevancia}</strong>
            ${meta}
            <div>${source.contenido}</div>
            ${sourceLink}
        `;
        sourcesContent.appendChild(sourceItem);
    }
    sourcesContent.querySelectorAll('[data-source-url]').forEach((button, index) => {
        button.addEventListener('click', () => {
            const source = sources[index] || {};
            persistChatContext({
                last_document_title: decodeURIComponent(button.dataset.sourceTitle || 'archivo'),
                last_document_intent: inferSourceIntent(source),
                last_source_index: index,
            });
            openDocumentUrlViewer(
                decodeURIComponent(button.dataset.sourceUrl || ''),
                decodeURIComponent(button.dataset.sourceTitle || 'archivo')
            );
        });
    });
    sourcesContent.querySelectorAll('[data-quick-source-url]').forEach((button) => {
        button.addEventListener('click', () => {
            openDocumentUrlViewer(
                decodeURIComponent(button.dataset.quickSourceUrl || ''),
                decodeURIComponent(button.dataset.quickSourceTitle || 'archivo')
            );
        });
    });
    sourcesContent.querySelectorAll('[data-source-case]').forEach((button) => {
        button.addEventListener('click', async () => {
            const caseId = button.dataset.sourceCase || '';
            if (!caseId) return;
            activeCaseId = caseId;
            persistProcessState({ activeCaseId: caseId, processing: false, error: false, statusText: `${formatCaseHandle(caseId)} recuperado desde búsqueda` });
            await loadActiveCase(caseId);
            switchView('processView');
        });
    });
}

function renderWorkflowDecision(decision) {
    workflowContent.innerHTML = '';
    toggleSection(workflowSection, Boolean(decision));

    if (!decision) {
        return;
    }

    const card = document.createElement('article');
    card.className = 'workflow-card';
    const renderList = (items, emptyLabel) => {
        if (!items?.length) {
            return `<div class="service-role">${emptyLabel}</div>`;
        }
        const rows = items.map((item) => {
            const text = String(item || '').trim();
            if (!text.includes(' | ') && !text.includes(';') && !text.includes('Detalle por hoja:')) {
                return `<li>${text}</li>`;
            }
            let segments = text
                .split(/\s*;\s*/)
                .map((segment) => segment.trim())
                .filter(Boolean);
            if (text.includes('Detalle por hoja:')) {
                const [head, detail] = text.split('Detalle por hoja:');
                const detailSegments = String(detail || '')
                    .split(/\s*,\s*/)
                    .map((segment) => segment.trim())
                    .filter(Boolean);
                segments = [String(head || '').trim(), ...detailSegments];
            }
            const detailList = segments.length
                ? `<ul class="workflow-detail-bullets">${segments.map((segment) => `<li>${segment}</li>`).join('')}</ul>`
                : '';
            return `<li>${detailList || text}</li>`;
        }).join('');
        return `<ul class="workflow-bullets">${rows}</ul>`;
    };

    card.innerHTML = `
        <div class="workflow-topline">
            <div>
                <div class="panel-label">Estado</div>
                <strong>${decision.recommended_status || 'n/d'}</strong>
            </div>
        </div>
        <p class="workflow-summary">${decision.summary}</p>
        <div class="workflow-grid">
            <div class="workflow-block">
                <div class="panel-label">Bloqueantes</div>
                ${renderList(decision.blockers, 'Sin bloqueantes inmediatos detectados.')}
            </div>
            <div class="workflow-block">
                <div class="panel-label">Siguiente paso</div>
                <p class="workflow-summary">${decision.next_step}</p>
                <div class="service-role">Canal: ${decision.recommended_channel}</div>
            </div>
        </div>
    `;

    workflowContent.appendChild(card);
}

function renderCaseDecision(decision, xlsxProfile) {
    if (!decision) {
        renderWorkflowDecision(null);
        return;
    }

    renderWorkflowDecision({
        flow: decision.flow,
        recommended_status: decision.recommended_status,
        summary: decision.summary,
        blockers: decision.blockers || [],
        next_step: decision.next_step,
        recommended_channel: 'contrato_local',
    });
}

function renderCaseDossier(casePayload) {
    if (!caseDossierContent) return;
    caseDossierContent.innerHTML = '';
    if (!casePayload) {
        toggleSection(caseDossierSection, false);
        return;
    }

    const analysis = casePayload.analysis || {};
    const profile = analysis.xlsx_profile?.profile || {};
    const decision = analysis.decision || {};
    const workflowRun = analysis.workflow_run || {};
    const report = workflowRun.executive_report_final || workflowRun.executive_report_precheck || analysis.reporte_ejecutivo || {};
    const resumen = report.resumen_ejecutivo || {};
    const empresa = resumen.empresa || profile.empresa || casePayload.label || 'n/d';
    const nit = resumen.nit || profile.nit || 'n/d';
    const documento = resumen.documento || profile.documento || 'n/d';
    const trabajadores = resumen.numero_trabajadores ?? profile.numero_trabajadores ?? 'n/d';
    const sedes = resumen.numero_sedes ?? profile.numero_sedes ?? 'n/d';
    const nomina = formatCurrencyCop(resumen.nomina_total ?? profile.nomina_total ?? 'n/d');
    const summary = decision.summary || 'Contrato cargado y listo para revisión.';
    const nextStep = decision.next_step || 'Continúa con la revisión del contrato.';
    const output926 = workflowRun.output_926 || analysis.output_926 || {};
    const has926 = Boolean(output926?.legacy?.ok || output926?.draft);
    const hasPrecheck = Boolean(workflowRun.executive_report_precheck || analysis.reporte_ejecutivo);
    const hasExecutive = Boolean(workflowRun.executive_report_final);
    const hasWorkflowRun = Boolean(workflowRun.status);
    const hasClassifiableDocuments = Boolean((analysis.checklist?.received_summary || []).length || collectXlsxFiles(casePayload).length);
    const hasResolvedProfile = [nit, documento, trabajadores, sedes].some((value) => String(value ?? '').trim() && String(value ?? '').trim().toLowerCase() !== 'n/d')
        || String(nomina || '').trim() !== 'n/d'
        || empresa !== 'n/d';
    const hasMeaningfulDecision = Boolean(decision.summary || decision.next_step || decision.blockers?.length);
    const shouldShowDossier = hasResolvedProfile || hasPrecheck || hasExecutive || hasWorkflowRun || has926 || hasMeaningfulDecision;

    toggleSection(caseDossierSection, shouldShowDossier);
    if (!shouldShowDossier) {
        return;
    }

    const metaItems = [
        ['NIT', nit],
        ['Documento', documento],
        ['Trabajadores', trabajadores],
        ['Sedes', sedes],
        ['Nómina', nomina],
    ].filter(([, value]) => {
        const text = String(value ?? '').trim().toLowerCase();
        return text && text !== 'n/d' && text !== '$ n/d';
    });

    const compactSummary = metaItems
        .map(([label, value]) => `<span class="source-chip dossier-chip"><strong>${label}:</strong> ${value}</span>`);
    const precheckBlocked = String(workflowRun.status || '').toLowerCase() === 'stopped_prevalidacion';
    const visibleActions = [
        hasClassifiableDocuments ? '<button class="search-button secondary compact-button" type="button" data-dossier-action="classification">Clasificación</button>' : '',
        hasPrecheck ? `<button class="search-button secondary compact-button" type="button" data-dossier-action="precheck">${precheckBlocked ? 'Ver causa de rechazo' : 'Prevalidación'}</button>` : '',
        hasExecutive ? '<button class="search-button secondary compact-button" type="button" data-dossier-action="executive">Reporte final</button>' : '',
        hasWorkflowRun ? '<button class="search-button secondary compact-button" type="button" data-dossier-action="workflow">Flujo</button>' : '',
        has926 ? '<button class="search-button compact-button" type="button" data-dossier-action="open926">Abrir 926</button>' : '',
    ].filter(Boolean).join('');

    const finalSummary = workflowRun.executive_report_final?.resumen_ejecutivo || {};
    const finalState = finalSummary.estado || finalSummary.estado_final || workflowRun.status || decision.recommended_status || casePayload.status || 'n/d';
    const normalizedFinalState = precheckBlocked
        ? 'NO PASÓ LA PREVALIDACIÓN'
        : localizeStatusLabel(finalState);
    const summaryText = precheckBlocked
        ? 'El contrato no pasó la prevalidación.'
        : summary && summary !== 'Contrato cargado y listo para revisión.'
            ? summary
            : (workflowRun.status === 'completed'
                ? `Proceso completado. Estado final: ${normalizedFinalState}.`
                : 'Contrato cargado y listo para revisión.');
    const precheckReasons = Array.isArray(decision.blockers) ? decision.blockers.filter(Boolean) : [];
    const nextText = precheckBlocked
        ? (precheckReasons[0] || nextStep || 'Abre la prevalidación para ver la causa del rechazo.')
        : nextStep && nextStep !== 'Continúa con la revisión del contrato.'
            ? nextStep
            : (has926 ? 'Archivo de carga al CORE disponible para abrir o descargar.' : '');

    const card = document.createElement('article');
    card.className = 'workflow-card dossier-card';
    card.innerHTML = `
        <div class="dossier-head">
            <div class="dossier-copy">
                <div class="panel-label">${formatCaseHandle(casePayload.id, casePayload.label)}</div>
                <h2 class="dossier-title">${empresa}</h2>
                ${compactSummary.length ? `<div class="dossier-chip-row">${compactSummary.join('')}</div>` : ''}
            </div>
            <div class="dossier-status">
                <span class="status-badge ${String(normalizedFinalState).toLowerCase().includes('aprob') || String(normalizedFinalState).toLowerCase().includes('complet') ? 'ok' : 'degraded'}">${normalizedFinalState}</span>
            </div>
        </div>
        <p class="workflow-summary dossier-summary">${summaryText}</p>
        ${nextText ? `<p class="workflow-summary dossier-next-inline">${nextText}</p>` : ''}
        ${visibleActions ? `<div class="dossier-actions">${visibleActions}</div>` : ''}
    `;
    caseDossierContent.appendChild(card);
    card.querySelectorAll('[data-dossier-action]').forEach((button) => {
        button.addEventListener('click', () => openCaseDossierAction(button.dataset.dossierAction || ''));
    });
}

function formatMatchStatus(ok) {
    return ok ? 'Coincide' : 'No coincide';
}

function matchStatusClass(ok) {
    return ok ? 'is-ok' : 'is-bad';
}

function buildValidationChecks(validationSummary = {}, checklist = {}, casePayload = null) {
    const matches = validationSummary?.matches || {};
    const analysis = casePayload?.analysis || {};
    const xlsxProfile = analysis.xlsx_profile || {};
    const profile = xlsxProfile.profile || {};
    const formFields = (validationSummary?.precheck || {}).xlsx_primary_validation?.form_fields || xlsxProfile.form_fields || {};
    const secondary = (validationSummary?.precheck || {}).xlsx_secondary_validation || {};
    const records = Array.isArray(xlsxProfile.records) ? xlsxProfile.records : [];
    const workerSheetCounts = xlsxProfile.worker_sheet_counts || {};
    const rows = [];
    const sourceLine = (label, filename) => filename ? `Fuente real: ${label} · ${filename}` : '';
    const parseCountValue = (value) => {
        if (value === null || value === undefined) return null;
        if (typeof value === 'number' && Number.isFinite(value)) return value;
        const digits = String(value).replace(/[^\d-]/g, '');
        if (!digits) return null;
        const parsed = Number(digits);
        return Number.isFinite(parsed) ? parsed : null;
    };
    if (matches.cedula_principal?.expected) {
        const principalSuffix = matches.cedula_principal.inferred
            ? ' · coincidencia inferida por el contrato'
            : '';
        rows.push({
            title: 'Documento principal',
            detail: `Comparado: XLSX "${matches.cedula_principal.expected}" vs cédula "${matches.cedula_principal.matched || 'n/d'}"${principalSuffix}`,
            source: sourceLine('Cédula', matches.cedula_principal.filename),
            ok: Boolean(matches.cedula_principal.ok),
        });
    }
    if (matches.rut_nit?.expected) {
        rows.push({
            title: 'NIT del empleador',
            detail: `Comparado: solicitud/XLSX "${matches.rut_nit.expected}" vs RUT "${matches.rut_nit.matched || 'n/d'}"`,
            source: sourceLine('RUT', matches.rut_nit.filename),
            ok: Boolean(matches.rut_nit.ok),
        });
    }
    if (matches.representante_documento?.expected || matches.representante_documento?.matched) {
        const representativeSuffix = matches.representante_documento.inferred
            ? ' · coincidencia inferida por el contrato'
            : '';
        rows.push({
            title: 'Documento del representante',
            detail: `Comparado: formulario "${matches.representante_documento.expected || 'n/d'}" vs cédula "${matches.representante_documento.matched || 'n/d'}"${representativeSuffix}`,
            source: sourceLine('Cédula del representante', matches.representante_documento.cedula),
            ok: Boolean(matches.representante_documento.ok),
        });
    }
    if (matches.empresa_nombre?.camara || matches.empresa_nombre?.formulario) {
        const sourceParts = [];
        if (matches.empresa_nombre.camara_file) sourceParts.push(`Cámara de comercio · ${matches.empresa_nombre.camara_file}`);
        if (matches.empresa_nombre.formulario_file) sourceParts.push(`Formulario/XLSX · ${matches.empresa_nombre.formulario_file}`);
        rows.push({
            title: 'Nombre de empresa',
            detail: `Comparado: cámara de comercio "${matches.empresa_nombre.camara || 'n/d'}" vs formulario/XLSX "${matches.empresa_nombre.formulario || 'n/d'}"`,
            source: sourceParts.length ? `Fuente real: ${sourceParts.join(' · ')}` : '',
            ok: Boolean(matches.empresa_nombre.ok),
        });
    }
    if (matches.camara_vigencia?.issued_at_human) {
        rows.push({
            title: 'Vigencia de cámara',
            detail: `Leído en la cámara de comercio: fecha de expedición "${matches.camara_vigencia.issued_at_human}" · antigüedad "${matches.camara_vigencia.age_business_days ?? matches.camara_vigencia.age_days ?? 'n/d'}" día(s) hábil(es)`,
            source: sourceLine('Cámara de comercio', matches.camara_vigencia.filename),
            ok: Boolean(matches.camara_vigencia.ok),
        });
    }
    if (matches.tipoempresa_core?.expected_from_pdf) {
        rows.push({
            title: 'Tipo de empresa',
            detail: `Leído del documento COMPROBANTE ENTREGA DE DOCUMENTOS: campo "TIPO DE NEGOCIO" = "${matches.tipoempresa_core.tipo_negocio_detectado || 'n/d'}" -> código "${matches.tipoempresa_core.expected_from_pdf || 'n/d'}"${matches.tipoempresa_core.core_current_from_naturaleza ? ` · comparado contra CORE actual "${matches.tipoempresa_core.core_current_from_naturaleza}"` : ''}`,
            source: sourceLine('Comprobante entrega de documentos', matches.tipoempresa_core.source_document),
            ok: Boolean(matches.tipoempresa_core.ok),
        });
    }
    const fechaRadicacion = formFields.fecha_radicacion || '';
    const fechaInicioCobertura = formFields.fecha_inicio_cobertura || '';
    const tipoTramite = String(formFields.tipo_tramite || profile.tipo_afiliado || '').trim();
    const tipoTramiteNorm = normalizeClientText(tipoTramite);
    if ((fechaRadicacion || fechaInicioCobertura) && tipoTramiteNorm.includes('afili')) {
        const parsedRadicacion = Date.parse(String(fechaRadicacion));
        const parsedCobertura = Date.parse(String(fechaInicioCobertura));
        const sameTimeline = Number.isFinite(parsedRadicacion) && Number.isFinite(parsedCobertura);
        const diffDays = sameTimeline ? Math.round((parsedCobertura - parsedRadicacion) / 86400000) : null;
        rows.push({
            title: 'Inicio de cobertura',
            detail: `Comparado: fecha de radicación "${fechaRadicacion || 'n/d'}" vs fecha inicio de cobertura "${fechaInicioCobertura || 'n/d'}"${diffDays !== null ? ` · diferencia "${diffDays}" día(s)` : ''}`,
            source: xlsxProfile.source_filename ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}` : '',
            ok: diffDays === null ? true : diffDays === 1,
        });
    }
    const representativeName = formFields.rep_legal_nombre_completo || '';
    const representativeDoc = formFields.rep_legal_numero_documento || matches.representante_documento?.expected || '';
    const representativeCedula = matches.representante_documento?.matched || '';
    if (representativeName || representativeDoc || representativeCedula) {
        rows.push({
            title: 'Representante legal',
            detail: `Leído del formulario/XLSX: nombre "${representativeName || 'n/d'}" · documento "${representativeDoc || 'n/d'}"${representativeCedula ? ` · comparado contra cédula adjunta "${representativeCedula}"` : ''}`,
            source: xlsxProfile.source_filename ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}${matches.representante_documento?.cedula ? ` · Cédula del representante · ${matches.representante_documento.cedula}` : ''}` : (matches.representante_documento?.cedula ? `Fuente real: Cédula del representante · ${matches.representante_documento.cedula}` : ''),
            ok: !representativeCedula || !representativeDoc ? true : String(representativeCedula).replace(/\D+/g, '').includes(String(representativeDoc).replace(/\D+/g, '')) || String(representativeDoc).replace(/\D+/g, '').includes(String(representativeCedula).replace(/\D+/g, '')),
        });
    }
    const actividadEconomica = formFields.b_codigo_actividad_economica_principal || formFields.a_codigo_actividad_economica_principal || '';
    if (actividadEconomica) {
        rows.push({
            title: 'Actividad económica',
            detail: `Leído del formulario/XLSX: código de actividad económica "${actividadEconomica}"`,
            source: xlsxProfile.source_filename ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}` : '',
            ok: true,
        });
    }
    const claseRiesgo = formFields.b_clase_riesgo || formFields.a_clase_riesgo || '';
    if (claseRiesgo) {
        rows.push({
            title: 'Clase de riesgo',
            detail: `Leído del formulario/XLSX: clase de riesgo "${claseRiesgo}"`,
            source: xlsxProfile.source_filename ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}` : '',
            ok: true,
        });
    }
    const reportSummary = casePayload?.report?.resumen_ejecutivo || casePayload?.resumen_ejecutivo || {};
    const expectedWorkersRaw = profile.numero_trabajadores
        || formFields.a_numero_inicial_trabajadores_estudiantes
        || formFields.b_numero_total_trabajadores_estudiantes
        || reportSummary.numero_trabajadores
        || reportSummary.empleados
        || reportSummary.empleados_total
        || reportSummary.desglose_sedes_totales?.empleados_total
        || '';
    const expectedWorkers = parseCountValue(expectedWorkersRaw) || 0;
    const sheetWorkerTotal = Object.values(workerSheetCounts).reduce((sum, value) => sum + Number(value || 0), 0);
    const executiveSummary = (analysis.reporte_ejecutivo || {}).resumen_ejecutivo || {};
    const executiveWorkers = parseCountValue(
        executiveSummary.numero_trabajadores
        ?? executiveSummary.empleados
        ?? executiveSummary.empleados_total
        ?? executiveSummary.desglose_sedes_totales?.empleados_total
    );
    const caseProfileWorkers = parseCountValue(
        casePayload?.profile?.numero_trabajadores
        ?? casePayload?.profile?.empleados_total
    );
    const reportWorkers = parseCountValue(
        reportSummary.numero_trabajadores
        ?? reportSummary.empleados
        ?? reportSummary.empleados_total
        ?? reportSummary.desglose_sedes_totales?.empleados_total
    );
    const profileWorkers = parseCountValue(profile.numero_trabajadores);
    const actualWorkers = sheetWorkerTotal > 0
        ? sheetWorkerTotal
        : records.length > 0
            ? records.length
            : executiveWorkers !== null && executiveWorkers > 0
                ? executiveWorkers
                : reportWorkers !== null && reportWorkers > 0
                    ? reportWorkers
                : caseProfileWorkers !== null && caseProfileWorkers > 0
                    ? caseProfileWorkers
                    : profileWorkers > 0
                        ? profileWorkers
                        : null;
    if (expectedWorkers > 0 || actualWorkers !== null) {
        const workerSourceDetail = sheetWorkerTotal > 0
            ? ' · hojas de trabajadores del XLSX'
            : records.length > 0
                ? ' · registros leídos del contrato'
                : executiveWorkers !== null && executiveWorkers > 0
                    ? ' · resumen ejecutivo del contrato'
                    : reportWorkers !== null && reportWorkers > 0
                        ? ' · reporte final del caso'
                        : caseProfileWorkers !== null && caseProfileWorkers > 0
                            ? ' · perfil consolidado del caso'
                            : ' · perfil del XLSX';
        rows.push({
            title: 'Trabajadores',
            detail: `Comparado: formulario/XLSX "${expectedWorkers || 'n/d'}" vs trabajadores leídos "${actualWorkers ?? 'n/d'}"`,
            source: xlsxProfile.source_filename
                ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}${workerSourceDetail}`
                : '',
            ok: expectedWorkers > 0 && actualWorkers !== null ? expectedWorkers === actualWorkers : false,
        });
    }
    const expectedSedesField = formFields.a_numero_sedes ? 'a_numero_sedes' : (formFields.b_numero_sedes ? 'b_numero_sedes' : 'numero_sedes');
    const expectedSedes = Number(profile.numero_sedes || formFields.a_numero_sedes || formFields.b_numero_sedes || 0);
    const actualSedes = Array.isArray((casePayload?.analysis?.reporte_ejecutivo || {}).resumen_ejecutivo?.desglose_sedes)
        ? (casePayload.analysis.reporte_ejecutivo.resumen_ejecutivo.desglose_sedes || []).length
        : expectedSedes;
    if (expectedSedes > 0 || actualSedes > 0) {
        rows.push({
            title: 'Sedes',
            detail: `Comparado: campo "${expectedSedesField}" del formulario/XLSX = "${expectedSedes || 'n/d'}" vs sedes válidas detectadas en el contrato = "${actualSedes || 'n/d'}"`,
            source: xlsxProfile.source_filename
                ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename}${Array.isArray((casePayload?.analysis?.reporte_ejecutivo || {}).resumen_ejecutivo?.desglose_sedes) ? ' · Resumen del contrato · desglose_sedes' : ''}`
                : '',
            ok: !expectedSedes || !actualSedes ? true : expectedSedes === actualSedes,
        });
    }
    if (secondary.expected_nomina || secondary.actual_nomina) {
        const expectedNominaField = formFields.a_valor_total_nomina ? 'a_valor_total_nomina' : (formFields.b_monto_total_cotizacion ? 'b_monto_total_cotizacion' : 'nomina_total');
        const nominaActualLabel = secondary.actual_nomina_from_controls
            ? 'nómina leída del control de la hoja de trabajadores'
            : 'nómina calculada/leída del contrato';
        rows.push({
            title: 'Nómina total',
            detail: `Comparado: campo "${expectedNominaField}" del formulario/XLSX = "${formatCurrencyCop(secondary.expected_nomina || 'n/d')}" vs ${nominaActualLabel} = "${formatCurrencyCop(secondary.actual_nomina || 'n/d')}"`,
            source: xlsxProfile.source_filename
                ? `Fuente real: Formulario/XLSX · ${xlsxProfile.source_filename} · Validación secundaria del XLSX${secondary.actual_nomina_from_controls ? ' · fila de control "Total salarios"' : ''}`
                : `Fuente real: Validación secundaria del XLSX${secondary.actual_nomina_from_controls ? ' · fila de control "Total salarios"' : ''}`,
            ok: Number(secondary.expected_nomina || 0) === Number(secondary.actual_nomina || 0),
        });
    }
    if (!rows.length && Array.isArray(checklist.matched_documents) && checklist.matched_documents.length) {
        rows.push({
            title: 'Coincidencias de documento principal',
            detail: `Se encontraron estas coincidencias directas contra el documento principal del XLSX: ${checklist.matched_documents.join(', ')}`,
            source: '',
            ok: true,
        });
    }
    return rows;
}

function humanizeOutputMode(mode) {
    if (mode === 'legacy') return 'integrado';
    if (mode === 'pending') return 'pendiente';
    return mode || 'n/d';
}

function formatCurrencyCop(value) {
    if (value === null || value === undefined || value === '' || value === 'n/d') {
        return 'n/d';
    }
    const digits = String(value).replace(/[^\d-]/g, '');
    if (!digits) {
        return String(value);
    }
    const amount = Number(digits);
    if (!Number.isFinite(amount)) {
        return String(value);
    }
    return new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        maximumFractionDigits: 0,
    }).format(amount);
}

function isInteractiveKeyboardTarget(target) {
    if (!(target instanceof HTMLElement)) return false;
    const tag = String(target.tagName || '').toLowerCase();
    return target.isContentEditable || ['input', 'textarea', 'select', 'option', 'button'].includes(tag);
}

function getClassificationSelectionInfo(items = activeClassificationItems, currentFile = activeClassificationFile) {
    const normalizedItems = Array.isArray(items) ? items : [];
    const index = normalizedItems.findIndex((item) => item?.file === currentFile);
    return {
        items: normalizedItems,
        index,
        total: normalizedItems.length,
        selected: index >= 0 ? normalizedItems[index] : null,
    };
}

function navigateClassificationByOffset(offset = 0) {
    if (!activeCasePayload || !activeClassificationCaseId || !offset) return;
    const { items, index } = getClassificationSelectionInfo();
    if (index < 0) return;
    const nextIndex = index + Number(offset || 0);
    if (nextIndex < 0 || nextIndex >= items.length) return;
    const nextItem = items[nextIndex];
    if (!nextItem?.file) return;
    persistChatContext({
        last_document_title: nextItem.file,
        last_document_intent: inferSourceIntent({ titulo: nextItem.file }),
        last_case_id: activeCasePayload.id,
        active_case_id: activeCasePayload.id,
    });
    renderClassificationWorkspace(activeCasePayload, nextItem.file);
}

function ensureClassificationKeyboardNavigation() {
    if (window.__classificationKeyboardNavBound) return;
    window.addEventListener('keydown', (event) => {
        const activeView = document.getElementById('classificationView');
        if (!activeView?.classList.contains('active')) return;
        if (!activeClassificationCaseId || !activeClassificationItems.length) return;
        if (isInteractiveKeyboardTarget(event.target)) return;
        if (event.key === 'ArrowLeft') {
            event.preventDefault();
            navigateClassificationByOffset(-1);
        } else if (event.key === 'ArrowRight') {
            event.preventDefault();
            navigateClassificationByOffset(1);
        }
    });
    window.__classificationKeyboardNavBound = true;
}

function describeSedeValue(sede) {
    const code = String(sede?.sede || '').trim();
    const name = String(sede?.nombre_sede || '').trim();
    if (name.toUpperCase() === 'PRINCIPAL') {
        return 'Principal';
    }
    if (!code) {
        return 'n/d';
    }
    return code;
}

function humanizeWorkflowStep(step) {
    const mapping = {
        prevalidacion_documental: {
            title: 'Prevalidación documental',
            detail: step.status === 'blocked'
                ? 'Se detectaron inconsistencias documentales antes de continuar.'
                : 'Se revisaron documentos, cruces y consistencia del contrato.',
        },
        generacion_manifiesto: {
            title: 'Preparación del archivo base',
            detail: 'Se preparó el archivo base del trámite para continuar el proceso.',
        },
        carga_lote_legacy: {
            title: 'Registro del trámite',
            detail: 'Se registró el trámite y se asignó el número interno de proceso.',
        },
        limpieza_preparacion: {
            title: 'Limpieza y preparación',
            detail: 'Se organizaron y limpiaron los datos del contrato para validarlos.',
        },
        importacion_proc: {
            title: 'Carga de empresa, sedes y trabajadores',
            detail: step.detail?.replace('Se importó empleador', 'Se cargó el empleador').replace(' para idtrámite', ' para el trámite') || 'Se cargaron empresa, sedes y trabajadores.',
        },
        sync_engine: {
            title: 'Sincronización de datos',
            detail: 'La información quedó lista para validaciones y generación del 926.',
        },
        prebuild_validaciones: {
            title: 'Validación previa',
            detail: step.status === 'blocked'
                ? 'La validación previa detectó diferencias que deben corregirse.'
                : 'Se validaron estructura, conteos y consistencia del trámite.',
        },
        reporte_previo: {
            title: 'Reporte previo al 926',
            detail: 'Se generó el resumen ejecutivo previo a la salida 926.',
        },
        generacion_926: {
            title: 'Generación del 926',
            detail: step.detail?.replace('Archivo 926 generado para lote', 'Se generó el archivo 926 para el trámite') || 'Se generó el archivo 926.',
        },
        reporte_final: {
            title: 'Reporte final',
            detail: 'Se consolidó el resultado final del proceso.',
        },
        cierre_flujo: {
            title: 'Cierre del proceso',
            detail: 'El proceso terminó correctamente.',
        },
    };
    const preset = mapping[step.name] || {};
    return {
        title: preset.title || step.title || step.name || 'Paso',
        detail: (preset.detail || step.detail || 'Sin detalle disponible.')
            .replaceAll('legacy', 'integración')
            .replaceAll('clone', 'motor interno'),
    };
}

function renderDocumentGallery(receivedSummary, caseId = activeCaseId, options = {}) {
    const manualReview = options.manualReview || {};
    const enableReview = Boolean(options.enableReview && caseId);
    const compactCorrection = Boolean(options.compactCorrection);
    const xlsxFiles = Array.isArray(options.xlsxFiles) ? options.xlsxFiles : [];
    const documentMeta = options.documentMeta || {};
    const xlsxMetaFactory = options.xlsxMetaFactory || (() => null);
    const groups = [];
    if (enableReview && xlsxFiles.length) {
        groups.push({
            label: 'XLSX',
            meta: `${xlsxFiles.length} archivo(s) · archivo de origen`,
            kind: 'xlsx',
            files: xlsxFiles,
        });
    }
    for (const item of receivedSummary || []) {
        groups.push({
            label: item.label,
            meta: `${item.count} archivo(s) · códigos ${item.legacy_codes.join(', ') || 'n/d'}`,
            kind: 'document',
            legacyCodes: item.legacy_codes || [],
            files: Array.isArray(item.files) ? item.files : [],
        });
    }
    if (!groups.length) {
        return '<div class="service-role">Sin resumen documental todavía.</div>';
    }
    if (options.flat) {
        const rows = [];
        for (const item of groups) {
            const files = Array.isArray(item.files) ? item.files : [];
            const orderedFiles = enableReview
                ? files.slice().sort((left, right) => String(left).localeCompare(String(right)))
                : files;
            for (const file of orderedFiles) {
                const meta = item.kind === 'xlsx' ? xlsxMetaFactory(file) : documentMeta[file];
                const detail = item.kind === 'xlsx'
                    ? 'Archivo de origen'
                    : item.label;
                rows.push(buildDocumentReviewRow({
                    caseId,
                    file,
                    label: detail,
                    detail,
                    kind: item.kind,
                    manualReview,
                    meta,
                    compactCorrection,
                }));
            }
        }
        return `<div class="document-gallery document-gallery-flat">${rows.join('')}</div>`;
    }
    return `<div class="document-gallery">${groups.map((item) => `
        <article class="document-group">
            <div class="document-group-head">
                <strong>${item.label}</strong>
                <span class="service-role">${item.meta}</span>
            </div>
            <div class="document-list">
                ${(() => {
                    const files = Array.isArray(item.files) ? item.files : [];
                    const orderedFiles = enableReview
                        ? files.slice().sort((left, right) => {
                            const leftVerdict = getManualReviewEntry(manualReview, item.kind, left)?.verdict ? 1 : 0;
                            const rightVerdict = getManualReviewEntry(manualReview, item.kind, right)?.verdict ? 1 : 0;
                            if (leftVerdict !== rightVerdict) {
                                return leftVerdict - rightVerdict;
                            }
                            return String(left).localeCompare(String(right));
                        })
                        : files;
                    return orderedFiles.map((file) => {
                    if (enableReview) {
                        const detail = item.kind === 'xlsx'
                            ? `${item.label} · archivo de origen`
                            : `${item.label} · código ${item.legacyCodes.join(', ') || 'n/d'}`;
                        return buildDocumentReviewRow({
                            caseId,
                            file,
                            label: item.label,
                            detail,
                            kind: item.kind,
                            manualReview,
                            meta: item.kind === 'xlsx' ? xlsxMetaFactory(file) : documentMeta[file],
                            compactCorrection,
                        });
                    }
                    const detail = item.kind === 'xlsx'
                        ? `${item.label} · archivo de origen`
                        : `${item.label} · código ${item.legacyCodes.join(', ') || 'n/d'}`;
                    const meta = item.kind === 'xlsx' ? xlsxMetaFactory(file) : documentMeta[file];
                    const displayName = getDisplayFilename(file, meta);
                    return `
                        <div class="document-row">
                            <div class="document-row-copy">
                                <div class="document-row-name">${displayName}</div>
                                ${displayName !== file ? `<div class="service-role">origen: ${file}</div>` : ''}
                                <div class="service-role">${detail}</div>
                            </div>
                            <button class="search-button secondary compact-button" type="button" data-case="${caseId}" data-file="${file}" data-display-name="${displayName}">Ver</button>
                        </div>
                    `;
                    }).join('');
                })()}
            </div>
        </article>
    `).join('')}</div>`;
}

function renderCaseChecklist(checklist, validationSummary = null, casePayload = activeCasePayload) {
    caseChecklistContent.innerHTML = '';
    updateReviewWorkspaceState(casePayload);
    if (!checklist) {
        return;
    }

    const card = document.createElement('article');
    card.className = 'workflow-card';
    const renderList = (items, emptyLabel) => items?.length
        ? `<ul class="workflow-bullets">${items.map((item) => `<li>${item}</li>`).join('')}</ul>`
        : `<div class="service-role">${emptyLabel}</div>`;
    const receivedSummary = Array.isArray(checklist.received_summary) ? checklist.received_summary : [];
    const validationChecks = buildValidationChecks(validationSummary, checklist, activeCasePayload);
    const manualReview = casePayload?.analysis?.manual_review || {};
    const xlsxFiles = collectXlsxFiles(casePayload);
    const documentMeta = buildDocumentMetaMap(casePayload);
    const xlsxMetaFactory = (filename) => buildXlsxMeta(casePayload, filename);
    const reviewStats = collectReviewStats(casePayload);
    card.innerHTML = `
        <div class="workflow-block review-queue-block">
            <div class="panel-label">Bandeja de revisión</div>
            <div class="review-queue-metrics">
                <span class="source-chip">Pendientes: ${reviewStats.pending.length}</span>
                <span class="source-chip">Revisados: ${reviewStats.reviewed.length}</span>
                <span class="source-chip">Total: ${reviewStats.total}</span>
            </div>
            <p class="workflow-summary">${reviewStats.pending.length
                ? 'Empieza por los documentos que aún no tienen decisión. Los pendientes ya aparecen primero en cada grupo.'
                : 'Ya no hay documentos pendientes. Si quieres, puedes ajustar o corregir revisiones existentes.'}</p>
        </div>
        <div class="workflow-grid">
            <div class="workflow-block">
                <div class="panel-label">Requeridos</div>
                ${renderList(checklist.required, 'Sin checklist requerido.')}
            </div>
            <div class="workflow-block">
                <div class="panel-label">Recibidos</div>
                ${renderList(checklist.received, 'Sin documentos reconocidos.')}
            </div>
            <div class="workflow-block">
                <div class="panel-label">Faltantes</div>
                ${renderList(checklist.missing, 'No se detectan faltantes.')}
            </div>
            <div class="workflow-block">
                <div class="panel-label">Cruce XLSX</div>
                ${renderList(checklist.matched_documents, 'Ningun documento OCR coincide todavia con el XLSX.')}
            </div>
        </div>
        <div class="workflow-block">
            <div class="panel-label">Verificaciones realizadas</div>
            ${validationChecks.length
                ? `<div class="report-detail-list">${validationChecks.map((item) => `
                    <div class="report-detail-row ${matchStatusClass(item.ok)}">
                        <strong>${item.title}</strong>
                        <div class="service-role">${item.detail}</div>
                        <div class="report-detail-status ${matchStatusClass(item.ok)}">${formatMatchStatus(item.ok)}</div>
                    </div>
                `).join('')}</div>`
                : '<div class="service-role">Aún no hay verificaciones detalladas para mostrar.</div>'}
        </div>
        <div class="workflow-block">
            <div class="panel-label">Resumen documental</div>
            ${renderDocumentGallery(receivedSummary, activeCaseId, { enableReview: true, manualReview, xlsxFiles, documentMeta, xlsxMetaFactory })}
        </div>
    `;
    caseChecklistContent.appendChild(card);
    card.querySelectorAll('[data-case][data-file]').forEach((button) => {
        button.addEventListener('click', () => openDocumentViewer(button.dataset.case, button.dataset.file, button.dataset.displayName || ''));
    });
    card.querySelectorAll('[data-review-expected]').forEach((select) => {
        select.addEventListener('change', () => {
            const row = select.closest('.document-row');
            const correctionButton = row?.querySelector('[data-review-verdict="no"]');
            if (select.dataset.reviewAutosave === 'true') {
                if (!select.value) return;
                const viewButton = row?.querySelector('[data-case][data-file]');
                const caseId = viewButton?.dataset.case || activeCaseId || '';
                const filename = viewButton?.dataset.file || '';
                if (caseId && filename) {
                    saveManualReview(caseId, 'document', filename, 'no');
                }
                return;
            }
            if (!correctionButton) return;
            correctionButton.disabled = !select.value;
        });
    });
    card.querySelectorAll('[data-review-case][data-review-file][data-review-verdict]').forEach((button) => {
        button.addEventListener('click', () => saveManualReview(
            button.dataset.reviewCase,
            button.dataset.reviewKind || 'document',
            button.dataset.reviewFile,
            button.dataset.reviewVerdict,
            button,
        ));
    });
}

function renderReportCard(container, report, emptyLabel, output926 = null) {
    container.innerHTML = '';
    if (!report) {
        return;
    }

    const card = document.createElement('article');
    card.className = 'workflow-card';
    const resumen = report.resumen_ejecutivo || {};
    const estadoFinal = resumen.estado || resumen.estado_final || report.estado_final || 'n/d';
    const empresa = resumen.empresa || report.empresa || 'n/d';
    const nit = resumen.nit || report.nit || 'n/d';
    const fechaProceso = resumen.fecha_proceso_human || report.fecha_proceso_human || resumen.fecha_proceso || report.fecha_proceso || 'n/d';
    const fechaHoraCorrida = formatUiDateTime(activeCasePayload?.updated_at || report.updated_at || '');
    const nominaTotal = formatCurrencyCop(resumen.nomina_total ?? report.nomina_total ?? 'n/d');
    const trabajadores = resumen.numero_trabajadores ?? resumen.empleados ?? resumen.empleados_total ?? resumen.desglose_sedes_totales?.empleados_total ?? 'n/d';
    const sedes = resumen.numero_sedes ?? resumen.sedes ?? resumen.sedes_excel ?? resumen.desglose_sedes?.length ?? 'n/d';
    const draft926 = output926?.draft || null;
    const legacy926 = output926?.legacy || null;
    const outputMode = output926?.mode || 'pending';
    const outputReason = output926?.reason || legacy926?.error || '';
    const file926Url = activeCaseId ? buildCase926Url(activeCaseId) : '';
    const desgloseSedes = Array.isArray(resumen.desglose_sedes) ? resumen.desglose_sedes : [];
    const reportText = report.texto || buildExecutiveReportText(estadoFinal, empresa, nit, trabajadores, sedes);
    const compactHighlights = [
        estadoFinal && estadoFinal !== 'n/d' ? `Estado: ${estadoFinal}` : '',
        empresa && empresa !== 'n/d' ? `Afiliado: ${empresa}` : '',
        nit && nit !== 'n/d' ? `NIT: ${nit}` : '',
        trabajadores !== 'n/d' ? `Trabajadores: ${trabajadores}` : '',
        sedes !== 'n/d' ? `Sedes: ${sedes}` : '',
        nominaTotal && nominaTotal !== 'n/d' ? `Nómina: ${nominaTotal}` : '',
    ].filter(Boolean);
    const compactFindings = Array.isArray(report.hallazgos) && report.hallazgos.length
        ? report.hallazgos.slice(0, 2)
        : Array.isArray(report.observaciones) && report.observaciones.length
            ? report.observaciones.slice(0, 2)
            : [];
    const receivedSummary = Array.isArray(activeCasePayload?.analysis?.checklist?.received_summary) ? activeCasePayload.analysis.checklist.received_summary : [];
    const checklist = activeCasePayload?.analysis?.checklist || {};
    const validationSummary = activeCasePayload?.analysis?.validacion_resumen || {};
    const validationChecks = buildValidationChecks(validationSummary, checklist);
    const manualReview = activeCasePayload?.analysis?.manual_review || {};
    const documentMeta = buildDocumentMetaMap(activeCasePayload);
    const xlsxMetaFactory = (filename) => buildXlsxMeta(activeCasePayload, filename);
    const hasDocumentPicker = Boolean(activeCaseId && receivedSummary.length);
    const outputBadge = output926
        ? legacy926?.ok
            ? '<span class="source-chip">926 listo</span>'
            : draft926
                ? '<span class="source-chip">926 borrador listo</span>'
                : '<span class="source-chip">926 pendiente</span>'
        : '';
    card.innerHTML = `
        <div class="workflow-topline">
            <div>
                <div class="panel-label">Estado final</div>
                <strong>${estadoFinal}</strong>
            </div>
            <div class="workflow-badges">
                ${outputBadge}
                <button class="search-button secondary compact-button" type="button" data-copy-report>Copiar reporte</button>
            </div>
        </div>
        <div class="workflow-grid">
            <div class="workflow-block">
                <div class="panel-label">Afiliado</div>
                <p class="workflow-summary">${empresa}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">NIT</div>
                <p class="workflow-summary">${nit}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Fecha del proceso</div>
                <p class="workflow-summary">${fechaProceso}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Hora de la corrida</div>
                <p class="workflow-summary">${fechaHoraCorrida}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Nómina total</div>
                <p class="workflow-summary">${nominaTotal}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Trabajadores</div>
                <p class="workflow-summary">${trabajadores}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Sedes</div>
                <p class="workflow-summary">${sedes}</p>
            </div>
        </div>
            <div class="workflow-block compact-report-block">
                <div class="panel-label">Resumen ejecutivo</div>
                <div class="compact-report-summary">
                    ${compactHighlights.slice(0, 4).map((line) => `<span class="source-chip">${line}</span>`).join('')}
                </div>
            ${compactFindings.length ? `
                <ul class="workflow-bullets compact-report-list">
                    ${compactFindings.map((line) => `<li>${line}</li>`).join('')}
                </ul>
                ` : ''}
            </div>
        ${validationChecks.length ? `
            <div class="workflow-block">
                <div class="panel-label">Verificaciones realizadas</div>
                <div class="report-detail-list">
                    ${validationChecks.map((item) => `
                        <div class="report-detail-row ${matchStatusClass(item.ok)}">
                            <strong class="report-detail-title">${item.title}</strong>
                            <div class="report-detail-text">${item.detail}</div>
                            ${item.source ? `<div class="report-detail-source">${item.source}</div>` : ''}
                            <div class="report-detail-status ${matchStatusClass(item.ok)}">${formatMatchStatus(item.ok)}</div>
                        </div>
                    `).join('')}
                </div>
            </div>
        ` : ''}
        ${output926 ? `
            <div class="workflow-block">
                <div class="panel-label">Archivo 926</div>
                <p class="workflow-summary">${legacy926?.ok ? (legacy926.filename || 'legacy_926.txt') : draft926 ? draft926.filename : 'No disponible'}</p>
                <div class="service-role">Modo: ${humanizeOutputMode(outputMode)}</div>
                <div class="service-role">${legacy926?.ok ? 'Generado por la integración automática.' : draft926?.note || outputReason || 'Sin salida 926 todavía.'}</div>
                ${file926Url ? `
                    <div class="case-head-actions report-actions">
                        <button class="search-button secondary compact-button" type="button" data-open-926="${legacy926?.filename || draft926?.filename || 'archivo_926.txt'}">Abrir 926</button>
                        <button class="search-button compact-button" type="button" data-download-926="${legacy926?.filename || draft926?.filename || 'archivo_926.txt'}">Descargar 926</button>
                    </div>
                ` : ''}
            </div>
        ` : ''}
        ${hasDocumentPicker ? `
            <div class="workflow-block" data-report-documents>
                <div class="panel-label">Documentos del contrato</div>
                <p class="workflow-summary">Abre la mesa de clasificación para ver el documento en grande, corregir el tipo y ajustar el orden operativo del contrato.</p>
                <div class="compact-report-summary">
                    <span class="source-chip">${receivedSummary.reduce((acc, item) => acc + Number(item.count || 0), 0) + collectXlsxFiles(activeCasePayload).length} archivo(s)</span>
                    <span class="source-chip">${collectXlsxFiles(activeCasePayload).length} XLSX</span>
                    <span class="source-chip">${receivedSummary.length} tipo(s) documentales</span>
                </div>
                <div class="case-head-actions report-actions">
                    <button class="search-button compact-button" type="button" data-open-case-docs="${activeCaseId}">Abrir clasificación</button>
                </div>
            </div>
        ` : ''}
        ${desgloseSedes.length ? `
            <div class="workflow-block">
                <div class="panel-label">Sedes y trabajadores</div>
                <div class="report-detail-list">
                    ${desgloseSedes.map((sede) => `
                        <div class="report-detail-row">
                            <strong>${sede.nombre_sede || `Sede ${sede.sede || 'n/d'}`}</strong>
                            <div class="service-role">Sede: ${describeSedeValue(sede)} · Trabajadores: ${sede.empleados_total ?? 'n/d'} · Centros: ${sede.centros_costo ?? 'n/d'}</div>
                            <div class="service-role">${sede.direccion || 'Sin dirección'} · Ciudad: ${describeCity(sede.ciudad)}</div>
                        </div>
                    `).join('')}
                </div>
            </div>
        ` : ''}
    `;
    container.appendChild(card);
    const copyButton = card.querySelector('[data-copy-report]');
    copyButton?.addEventListener('click', () => copyText(report.texto || '', copyButton));
    const open926Button = card.querySelector('[data-open-926]');
    open926Button?.addEventListener('click', () => openCase926Viewer(activeCaseId, open926Button.dataset.open926 || 'archivo_926.txt', open926Button));
    const download926Button = card.querySelector('[data-download-926]');
    download926Button?.addEventListener('click', () => downloadCase926(activeCaseId, download926Button.dataset.download926 || 'archivo_926.txt', download926Button));
    card.querySelectorAll('[data-open-case-docs]').forEach((button) => {
        button.addEventListener('click', async () => {
            await openCaseDocumentsFlow(button.getAttribute('data-open-case-docs') || '');
        });
    });
    card.querySelectorAll('[data-case][data-file]').forEach((button) => {
        button.addEventListener('click', () => openDocumentViewer(button.dataset.case, button.dataset.file, button.dataset.displayName || ''));
    });
    card.querySelectorAll('[data-review-expected]').forEach((select) => {
        select.addEventListener('change', () => {
            const row = select.closest('.document-row');
            const correctionButton = row?.querySelector('[data-review-verdict="no"]');
            if (!correctionButton) return;
            correctionButton.disabled = !select.value;
        });
    });
    card.querySelectorAll('[data-review-case][data-review-file][data-review-verdict]').forEach((button) => {
        button.addEventListener('click', () => saveManualReview(
            button.dataset.reviewCase,
            button.dataset.reviewKind || 'document',
            button.dataset.reviewFile,
            button.dataset.reviewVerdict,
            button,
        ));
    });
}

function renderPrecheckReport(report) {
    let displayReport = report;
    if (report) {
        const status = resolvePrecheckDisplayStatus(activeCasePayload, report);
        displayReport = {
            ...report,
            estado_final: status,
            resumen_ejecutivo: {
                ...(report.resumen_ejecutivo || {}),
                estado: status,
                estado_final: status,
            },
        };
    }
    toggleSection(precheckSection, Boolean(report));
    renderReportCard(
        precheckReportContent,
        displayReport,
        'Aún no hay reporte de prevalidación.'
    );
}

function renderExecutiveReport(report, output926 = null) {
    toggleSection(executiveSection, Boolean(report));
    renderReportCard(
        executiveReportContent,
        report,
        'Aún no hay reporte final del proceso.',
        output926
    );
}

function renderWorkflowRun(workflowRun) {
    workflowRunContent.innerHTML = '';
    toggleSection(workflowRunSection, Boolean(workflowRun));
    if (!workflowRun) {
        return;
    }

    const card = document.createElement('article');
    card.className = 'workflow-card';
    const steps = Array.isArray(workflowRun.steps) ? workflowRun.steps : [];
    const precheckSummary = workflowRun.executive_report_precheck?.resumen_ejecutivo || {};
    const resolvedPrecheckStatus = resolvePrecheckDisplayStatus(activeCasePayload, workflowRun.executive_report_precheck || null);
    const finalSummary = workflowRun.executive_report_final?.resumen_ejecutivo || {};
    const precheckWorkers = precheckSummary.numero_trabajadores ?? 'n/d';
    const precheckSedes = precheckSummary.numero_sedes ?? 'n/d';
    const precheckFecha = precheckSummary.fecha_proceso_human || precheckSummary.fecha_proceso || workflowRun.executive_report_precheck?.fecha_proceso_human || workflowRun.executive_report_precheck?.fecha_proceso || 'n/d';
    const finalEstado = finalSummary.estado || finalSummary.estado_final || workflowRun.executive_report_final?.estado_final || 'n/d';
    const finalEmpresa = finalSummary.empresa || workflowRun.executive_report_final?.empresa || 'n/d';
    const finalNit = finalSummary.nit || workflowRun.executive_report_final?.nit || 'n/d';
    const finalWorkers = finalSummary.numero_trabajadores ?? finalSummary.empleados ?? finalSummary.desglose_sedes_totales?.empleados_total ?? 'n/d';
    const finalSedes = finalSummary.numero_sedes ?? finalSummary.sedes ?? finalSummary.desglose_sedes?.length ?? 'n/d';
    const finalFecha = finalSummary.fecha_proceso_human || finalSummary.fecha_proceso || workflowRun.executive_report_final?.fecha_proceso_human || workflowRun.executive_report_final?.fecha_proceso || 'n/d';
    const prebuildStep = steps.find((step) => step.name === 'prebuild_validaciones') || null;
    const salaryCheck = prebuildStep?.payload?.prebuild?.xlsx_sede_salary_check || null;
    const prebuildWarnings = prebuildStep?.payload?.prebuild?.prebuild?.warnings || [];
    const salaryErrors = Array.isArray(salaryCheck?.errors) ? salaryCheck.errors : [];
    const currentStep = humanizeWorkflowStep({ name: workflowRun.current_step, title: workflowRun.current_step, detail: workflowRun.stop_reason || '' });
    const workflowTimings = workflowRun.timings || {};
    const totalDuration = formatDurationMs(workflowTimings.total_duration_ms);
    const analysisDuration = formatDurationMs(workflowTimings.analysis_duration_ms);
    card.innerHTML = `
        <div class="workflow-topline">
            <div>
                <div class="panel-label">Estado del flujo</div>
                <strong>${localizeStatusLabel(workflowRun.status || 'n/d')}</strong>
            </div>
            <div class="workflow-badges">
                <span class="source-chip">${currentStep.title}</span>
            </div>
        </div>
        <p class="workflow-summary">${(workflowRun.stop_reason || 'Flujo completado sin bloqueos.').replaceAll('legacy', 'integración').replaceAll('clone', 'motor interno')}</p>
        <div class="workflow-grid">
            <div class="workflow-block">
                <div class="panel-label">Tiempo total</div>
                <p class="workflow-summary">${totalDuration}</p>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Tiempo de prevalidación</div>
                <p class="workflow-summary">${analysisDuration}</p>
            </div>
        </div>
        ${(workflowRun.executive_report_precheck || workflowRun.executive_report_final)
            ? `<div class="workflow-grid">
                <div class="workflow-block">
                    <div class="panel-label">Reporte de prevalidación</div>
                    <p class="workflow-summary">Estado: ${resolvedPrecheckStatus} · Fecha: ${precheckFecha} · Afiliado: ${precheckSummary.empresa || 'n/d'} · NIT: ${precheckSummary.nit || 'n/d'} · Trabajadores: ${precheckWorkers} · Sedes: ${precheckSedes}</p>
                </div>
                <div class="workflow-block">
                    <div class="panel-label">Reporte final</div>
                    <p class="workflow-summary">${workflowRun.executive_report_final ? `Estado: ${finalEstado} · Fecha: ${finalFecha} · Afiliado: ${finalEmpresa} · NIT: ${finalNit} · Trabajadores: ${finalWorkers} · Sedes: ${finalSedes}` : 'Pendiente o no disponible.'}</p>
                </div>
            </div>`
            : ''}
        ${(salaryErrors.length || prebuildWarnings.length) ? `
            <div class="workflow-block">
                <div class="panel-label">Detalle de validación</div>
                <div class="report-detail-list">
                    ${salaryErrors.map((item) => `
                        <div class="report-detail-row">
                            <strong>Salarios sede ${item.sede || 'n/d'}</strong>
                            <div class="service-role">Excel: ${item.total_excel ?? 'n/d'} · Importado: ${item.total_importado ?? 'n/d'} · Diferencia: ${item.diferencia ?? 'n/d'}</div>
                        </div>
                    `).join('')}
                    ${!salaryErrors.length && prebuildWarnings.length ? `
                        <div class="report-detail-row">
                            <strong>Observaciones técnicas</strong>
                            <div class="service-role">${prebuildWarnings.slice(0, 5).map((item) => item.detail || item.code || 'warning').join(' · ')}</div>
                        </div>
                    ` : ''}
                </div>
            </div>
        ` : ''}
        <div class="workflow-block">
            <div class="panel-label">Resumen del proceso</div>
            ${steps.length
                ? `<ul class="workflow-bullets">${steps.map((step) => {
                    const view = humanizeWorkflowStep(step);
                    const durationLabel = step.duration_ms != null ? ` · ${formatDurationMs(step.duration_ms)}` : '';
                    return `<li><strong>${view.title}</strong> · ${localizeStatusLabel(step.status)}${durationLabel} · ${view.detail}</li>`;
                }).join('')}</ul>`
                : '<div class="service-role">Sin pasos ejecutados.</div>'}
        </div>
    `;
    workflowRunContent.appendChild(card);
}

function renderCaseSearch(results) {
    caseSearchContent.innerHTML = '';
    caseSearchSection?.classList.toggle('hidden', !results?.length);
    if (!results?.length) {
        return;
    }
    for (const result of results) {
        const card = document.createElement('article');
        card.className = 'workflow-card';
        const receivedSummary = Array.isArray(result.received_summary) ? result.received_summary : [];
        const precheck = result.precheck || {};
        const executiveReport = result.executive_report || {};
        const resumen = executiveReport.resumen_ejecutivo || {};
        const empresa = resumen.empresa || result.profile?.empresa || result.label || 'n/d';
        const nit = resumen.nit || result.profile?.nit || 'n/d';
        const documento = resumen.documento || result.profile?.documento || 'n/d';
        const trabajadores = resumen.numero_trabajadores ?? result.profile?.numero_trabajadores ?? 'n/d';
        const sedes = resumen.numero_sedes ?? result.profile?.numero_sedes ?? 'n/d';
        const fechaProceso = resumen.fecha_proceso_human || resumen.fecha_proceso || result.updated_at?.slice(0, 10) || 'n/d';
        const errores = Array.isArray(resumen.errores) ? resumen.errores : [];
        const observaciones = Array.isArray(resumen.observaciones) ? resumen.observaciones : [];
        card.innerHTML = `
            <div class="workflow-topline">
                <div>
                    <div class="panel-label">${result.case_id}</div>
                    <strong>${empresa}</strong>
                </div>
                <div class="workflow-badges">
                    <span class="source-chip">${precheck.approved ? 'Prevalidación aprobada' : 'Prevalidación no aprobada'}</span>
                </div>
            </div>
            <div class="workflow-block">
                <div class="panel-label">Reporte ejecutivo</div>
                <div class="workflow-grid">
                    <div class="workflow-block">
                        <div class="panel-label">Afiliado</div>
                        <p class="workflow-summary">${empresa}</p>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">NIT</div>
                        <p class="workflow-summary">${nit}</p>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Documento</div>
                        <p class="workflow-summary">${documento}</p>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Fecha del proceso</div>
                        <p class="workflow-summary">${fechaProceso}</p>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Trabajadores</div>
                        <p class="workflow-summary">${trabajadores}</p>
                    </div>
                    <div class="workflow-block">
                        <div class="panel-label">Sedes</div>
                        <p class="workflow-summary">${sedes}</p>
                    </div>
                </div>
                ${(errores.length || observaciones.length) ? `
                    <div class="report-detail-list">
                        ${errores.length ? `
                            <div class="report-detail-row">
                                <strong>Hallazgos</strong>
                                <ul class="workflow-bullets">${errores.map((item) => `<li>${item}</li>`).join('')}</ul>
                            </div>
                        ` : ''}
                        ${observaciones.length ? `
                            <div class="report-detail-row">
                                <strong>Observaciones</strong>
                                <ul class="workflow-bullets">${observaciones.map((item) => `<li>${item}</li>`).join('')}</ul>
                            </div>
                        ` : ''}
                    </div>
                ` : `<p class="workflow-summary">${precheck.approved ? 'Sin hallazgos bloqueantes.' : (executiveReport?.texto || 'Sin reporte ejecutivo disponible.')}</p>`}
            </div>
            <div class="workflow-block">
                <div class="panel-label">Adjuntos clasificados</div>
                ${renderDocumentGallery(receivedSummary, result.case_id)}
            </div>
            <div class="case-head-actions">
                <button class="search-button secondary compact-button" type="button" data-copy-report="${encodeURIComponent(executiveReport?.texto || '')}">Copiar reporte</button>
            </div>
        `;
        caseSearchContent.appendChild(card);
    }
    caseSearchContent.querySelectorAll('[data-case][data-file]').forEach((button) => {
        button.addEventListener('click', () => openDocumentViewer(button.dataset.case, button.dataset.file, button.dataset.displayName || ''));
    });
    caseSearchContent.querySelectorAll('[data-copy-report]').forEach((button) => {
        button.addEventListener('click', () => copyText(decodeURIComponent(button.dataset.copyReport || ''), button));
    });
}

async function compare926() {
    const leftContent = ((compareLeftFile?.dataset?.loadedContent || '').trim());
    const rightContent = ((compareRightFile?.dataset?.loadedContent || '').trim());
    if (!leftContent || !rightContent) {
        compare926Content.innerHTML = '<div class="source-item">Carga el 926 del sistema nuevo y el 926 del sistema antiguo para compararlos.</div>';
        return;
    }
    compare926Button.disabled = true;
    compare926Content.innerHTML = '<div class="source-item">Comparando archivos 926...</div>';
    try {
        const response = await fetch(`${API_URL}/api/926/compare`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ left_content: leftContent, right_content: rightContent })
        });
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        const data = await response.json();
        compare926Content.innerHTML = `
            <article class="workflow-card">
                <div class="workflow-topline">
                    <div>
                        <div class="panel-label">Resultado</div>
                        <strong>${data.match ? 'Coinciden' : 'Difieren'}</strong>
                    </div>
                    <div class="workflow-badges">
                        <span class="source-chip">Similitud ${Math.round((data.similarity || 0) * 100)}%</span>
                        <span class="source-chip">Diferencias ${data.different_lines || 0}</span>
                    </div>
                </div>
                <p class="workflow-summary">Clone: ${data.left_lines} líneas · Antiguo: ${data.right_lines} líneas</p>
                <div class="workflow-block">
                    <div class="panel-label">Primeras diferencias</div>
                    ${Array.isArray(data.diffs) && data.diffs.length
                        ? `<div class="diff-list">${data.diffs.slice(0, 20).map((item) => `
                            <div class="diff-card">
                                <div class="panel-label">Línea ${item.line}</div>
                                <div class="diff-line diff-left">Clone: ${item.left || '∅'}</div>
                                <div class="diff-line diff-right">Antiguo: ${item.right || '∅'}</div>
                            </div>
                        `).join('')}</div>`
                        : '<div class="service-role">Sin diferencias detectadas.</div>'}
                </div>
            </article>
        `;
    } catch (error) {
        console.error('Error comparando 926:', error);
        compare926Content.innerHTML = '<div class="source-item">No pude comparar los archivos 926.</div>';
    } finally {
        compare926Button.disabled = false;
    }
}

function renderSystemStatus(data) {
    overallStatusText.textContent = data.overall_status === 'ok'
        ? 'Imagine está operando como plano de control'
        : 'Imagine detectó componentes degradados';
    overallStatusBadge.textContent = data.overall_status === 'ok' ? 'OK' : 'DEGRADADO';
    overallStatusBadge.className = `status-badge ${data.overall_status === 'ok' ? 'ok' : 'degraded'}`;
    modelsText.textContent = `Chat: ${data.models.chat} · Embeddings: ${data.models.embeddings} · Reranker: ${data.models.reranker}`;
    knowledgeDocsChip.textContent = `Corpus: ${data.knowledge_base.documents} documentos`;
    knowledgeChunksChip.textContent = `Indice: ${data.knowledge_base.indexed_chunks} fragmentos`;
    renderFeedStatus(data.feeding || {});
    renderEvalStatus(data.evaluation || {});
    renderCompare926Status(data.compare_926 || {});
    renderTopicFilters(data.knowledge_base.available_topics || []);

    servicesGrid.innerHTML = '';
    for (const service of data.services) {
        const card = document.createElement('article');
        card.className = 'service-card';
        const badgeClass = service.status === 'ok' ? 'status-badge ok' : 'status-badge degraded';
        card.innerHTML = `
            <header>
                <div class="service-name">${service.name}</div>
                <div class="${badgeClass}">${localizeStatusLabel(service.status)}</div>
            </header>
            <div class="service-role">${service.role}</div>
            <div class="service-target">${service.target}</div>
        `;
        servicesGrid.appendChild(card);
    }

    actionsList.innerHTML = '';
    for (const action of data.recommended_actions) {
        const card = document.createElement('article');
        card.className = 'action-card';
        card.innerHTML = `<strong>${action.title}</strong><p>${action.description}</p>`;
        actionsList.appendChild(card);
    }
}

function renderCompare926Status(summary) {
    compareTotalChip.textContent = `Comparaciones: ${summary.total ?? 0}`;
    compareExactChip.textContent = `Exactas: ${summary.exact_matches ?? 0}`;
    compareSimilarityChip.textContent = `Similitud: ${Math.round((summary.average_similarity ?? 0) * 100)}%`;
    compareLatest.innerHTML = '';
    const latest = Array.isArray(summary.latest) ? summary.latest : [];
    if (!latest.length) {
        compareLatest.innerHTML = '<div class="service-role">Aún no hay comparaciones de 926 registradas.</div>';
        return;
    }
    for (const item of latest) {
        const entityLabel = normalizeReviewLabel(item.empresa || '') || item.left_case_id || 'Comparación manual';
        const comparedAt = formatUiDateTime(item.generated_at || item.created_at || '');
        const card = document.createElement('div');
        card.className = 'feed-error-card';
        card.innerHTML = `<strong>${entityLabel}</strong><p>${item.nit ? `NIT ${item.nit} · ` : ''}${item.match ? 'Exacta' : 'Con diferencias'} · ${Math.round((item.similarity || 0) * 100)}% · ${item.different_lines || 0} línea(s)</p><div class="service-role">Comparación registrada: ${comparedAt}</div>`;
        compareLatest.appendChild(card);
    }
}

function renderEvalStatus(evaluation) {
    evalCasesChip.textContent = `Registros: ${evaluation.cases_total ?? 0}`;
    evalAverageChip.textContent = `Promedio: ${Math.round((evaluation.average_score ?? 0) * 100)}%`;
    evalPassChip.textContent = `Tasa OK: ${Math.round((evaluation.pass_rate ?? 0) * 100)}%`;
    evalWeakChip.textContent = `Débiles: ${(evaluation.weak ?? 0) + (evaluation.failed ?? 0)}`;

    const topics = Object.entries(evaluation.topic_performance || {});
    evalTopics.innerHTML = topics.length
        ? topics.map(([topic, score]) => `<span class="source-chip">${topic}: ${Math.round(score * 100)}%</span>`).join('')
        : '<span class="service-role">Sin reporte de evaluacion todavia.</span>';

    const lowest = evaluation.lowest_cases || [];
    evalLowest.innerHTML = '';
    if (!lowest.length) {
        evalLowest.innerHTML = '<div class="service-role">Aun no hay registros débiles detectados.</div>';
        return;
    }

    for (const item of lowest) {
        const card = document.createElement('div');
        card.className = 'feed-error-card';
        card.innerHTML = `<strong>${item.id}</strong><p>Score ${Math.round((item.score || 0) * 100)}% · ${item.grade || 'unknown'}</p>`;
        evalLowest.appendChild(card);
    }
}

function renderFeedStatus(feeding) {
    feedProcessedChip.textContent = `Procesadas: ${feeding.processed ?? 0}`;
    feedSkippedChip.textContent = `Saltadas: ${feeding.skipped ?? 0}`;
    feedFailedChip.textContent = `Fallidas: ${feeding.failed ?? 0}`;
    feedOcrChip.textContent = `OCR: ${feeding.used_ocr ?? 0}`;

    const typeEntries = Object.entries(feeding.source_types || {});
    feedTypes.innerHTML = typeEntries.length
        ? typeEntries.map(([type, count]) => `<span class="source-chip">${type}: ${count}</span>`).join('')
        : '<span class="service-role">Sin detalle de tipos todavia.</span>';

    const strategyEntries = Object.entries(feeding.ocr_strategies || {});
    ocrStrategies.innerHTML = strategyEntries.length
        ? strategyEntries.map(([strategy, count]) => `<span class="source-chip">OCR ${strategy}: ${count}</span>`).join('')
        : '<span class="service-role">Sin estrategias OCR activas en la ultima corrida.</span>';

    const errors = feeding.last_errors || [];
    feedErrors.innerHTML = '';
    if (!errors.length) {
        feedErrors.innerHTML = '<div class="service-role">Sin errores recientes en la ultima alimentacion.</div>';
        return;
    }

    for (const item of errors) {
        const card = document.createElement('div');
        card.className = 'feed-error-card';
        card.innerHTML = `<strong>${item.slug}</strong><p>${item.error || 'Sin detalle disponible'}</p>`;
        feedErrors.appendChild(card);
    }
}

function renderTopicFilters(topics) {
    if (!topicFilters) return;
    const allTopics = ['all', ...topics];
    topicFilters.innerHTML = '';

    for (const topic of allTopics) {
        const button = document.createElement('button');
        button.type = 'button';
        const isAll = topic === 'all';
        const isActive = isAll ? selectedTopics.size === 0 : selectedTopics.has(topic);
        button.className = `topic-filter ${isActive ? 'active' : ''}`;
        button.textContent = topic === 'all' ? 'Todos' : topic;
        button.addEventListener('click', () => {
            if (isAll) {
                selectedTopics.clear();
            } else if (selectedTopics.has(topic)) {
                selectedTopics.delete(topic);
            } else {
                selectedTopics.add(topic);
            }
            renderTopicFilters(topics);
        });
        topicFilters.appendChild(button);
    }
}

searchInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
});
sendButton.addEventListener('click', sendMessage);
createCaseButton?.addEventListener('click', createCase);
runWorkflowButton?.addEventListener('click', runWorkflow);
runWorkflowInlineButton?.addEventListener('click', runWorkflow);
reindexButton.addEventListener('click', reindexKnowledge);
exportReviewsButton?.addEventListener('click', exportManualReviewsDataset);
compare926Button?.addEventListener('click', compare926);
feedbackNoteForm?.addEventListener('submit', submitFeedbackNote);
feedbackNoteInput?.addEventListener('keydown', handleFeedbackTextareaKeydown);
feedbackNoteInput?.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {
        saveFeedbackNote();
    }
});
toggleRecover926Button?.addEventListener('click', () => setRecover926Expanded(!recover926Expanded));
toggleFailedPrecheckButton?.addEventListener('click', () => setFailedPrecheckExpanded(!failedPrecheckExpanded));
recover926Content?.addEventListener('click', async (event) => {
    const target = event.target.closest('button');
    if (!target) return;
    if (target.dataset.recoverCase) {
        const caseId = target.dataset.recoverCase || '';
        if (!caseId) return;
        activeCaseId = caseId;
        if (caseProgressTimer) {
            clearInterval(caseProgressTimer);
            caseProgressTimer = null;
        }
        const empresaLabel = target.closest('article')?.querySelector('strong')?.textContent || caseId;
        if (caseStatusLine) {
            caseStatusLine.classList.remove('processing', 'error');
            caseStatusLine.textContent = 'Cargando ' + empresaLabel + '...';
        }
        await loadActiveCase(caseId);
        switchView('processView');
        return;
    }
    if (target.hasAttribute('data-open-926-case')) {
        openCase926Viewer(
            target.getAttribute('data-open-926-case') || '',
            target.getAttribute('data-open-926-file') || 'archivo_926.txt',
            target
        );
        return;
    }
    if (target.hasAttribute('data-open-case-docs')) {
        await openCaseDocumentsFlow(target.getAttribute('data-open-case-docs') || '');
        return;
    }
    if (target.hasAttribute('data-open-executive-case')) {
        await openExecutiveReportFlow(target.getAttribute('data-open-executive-case') || '');
        return;
    }
    if (target.hasAttribute('data-download-926-case')) {
        downloadCase926(
            target.getAttribute('data-download-926-case') || '',
            target.getAttribute('data-download-926-file') || 'archivo_926.txt',
            target
        );
        return;
    }
    if (target.hasAttribute('data-download-case-package')) {
        downloadCasePackage(
            target.getAttribute('data-download-case-package') || '',
            target
        );
    }
});
productionCasesContent?.addEventListener('click', async (event) => {
    const target = event.target.closest('button');
    if (!target) return;
    if (target.hasAttribute('data-open-colmena-workbench')) {
        const caseId = target.getAttribute('data-open-colmena-workbench') || '';
        if (!caseId) return;
        activeColmenaWorkbenchCaseId = caseId;
        activeCaseId = caseId;
        await loadActiveCase(caseId);
        queueMicrotask(() => scrollToElement(colmenaWorkbenchSection));
        return;
    }
    if (target.hasAttribute('data-recover-case')) {
        await recoverCaseFlow(
            target.getAttribute('data-recover-case') || '',
            target.getAttribute('data-recover-company') || '',
            target.getAttribute('data-recover-nit') || '',
        );
        return;
    }
    if (target.hasAttribute('data-open-case-docs')) {
        await openCaseDocumentsFlow(target.getAttribute('data-open-case-docs') || '');
        return;
    }
    if (target.hasAttribute('data-open-executive-case')) {
        await openExecutiveReportFlow(target.getAttribute('data-open-executive-case') || '');
        return;
    }
    if (target.hasAttribute('data-open-926-case')) {
        openCase926Viewer(
            target.getAttribute('data-open-926-case') || '',
            target.getAttribute('data-open-926-file') || 'archivo_926.txt',
            target
        );
        return;
    }
    if (target.hasAttribute('data-download-926-case')) {
        downloadCase926(
            target.getAttribute('data-download-926-case') || '',
            target.getAttribute('data-download-926-file') || 'archivo_926.txt',
            target
        );
        return;
    }
    if (target.hasAttribute('data-download-case-package')) {
        downloadCasePackage(
            target.getAttribute('data-download-case-package') || '',
            target
        );
    }
});
colmenaWorkbenchContent?.addEventListener('click', async (event) => {
    const target = event.target.closest('button');
    if (!target) return;
    if (target.hasAttribute('data-open-executive-case')) {
        await openExecutiveReportFlow(target.getAttribute('data-open-executive-case') || '');
        return;
    }
    if (target.hasAttribute('data-open-926-case')) {
        openCase926Viewer(
            target.getAttribute('data-open-926-case') || '',
            target.getAttribute('data-open-926-file') || 'archivo_926.txt',
            target
        );
        return;
    }
    if (target.hasAttribute('data-download-926-case')) {
        downloadCase926(
            target.getAttribute('data-download-926-case') || '',
            target.getAttribute('data-download-926-file') || 'archivo_926.txt',
            target
        );
    }
});
refreshProductionButton?.addEventListener('click', loadProductionCases);
failedPrecheckContent?.addEventListener('click', async (event) => {
    const target = event.target.closest('button');
    if (!target) return;
    if (target.hasAttribute('data-open-precheck-case')) {
        await openPrecheckSummaryFlow(target.getAttribute('data-open-precheck-case') || '');
        return;
    }
    if (target.hasAttribute('data-open-case-docs')) {
        await openCaseDocumentsFlow(target.getAttribute('data-open-case-docs') || '');
        return;
    }
    if (target.hasAttribute('data-recover-case')) {
        await recoverCaseFlow(
            target.getAttribute('data-recover-case') || '',
            target.getAttribute('data-recover-company') || '',
            target.getAttribute('data-recover-nit') || '',
        );
    }
});
compareRightFile?.addEventListener('change', async () => {
    const file = compareRightFile.files?.[0];
    if (!file) return;
    compareRightFile.dataset.loadedContent = await file.text();
    compare926Content.innerHTML = `<div class="source-item">Archivo ${file.name} cargado. Ya puedes comparar el 926.</div>`;
});
compareLeftFile?.addEventListener('change', async () => {
    const file = compareLeftFile.files?.[0];
    if (!file) return;
    compareLeftFile.dataset.loadedContent = await file.text();
    compare926Content.innerHTML = `<div class="source-item">Archivo del sistema nuevo ${file.name} cargado. Ya puedes comparar los dos 926 sin contrato.</div>`;
});
sourcesSection?.addEventListener('click', toggleSources);
packageFilesInput?.addEventListener('change', () => {
    if (!ensureTesterSelected('cargar contrato')) {
        packageFilesInput.value = '';
        updatePackageFilesLabel([]);
        return;
    }
    const files = getSelectedPackageFiles();
    logTesterActivity('files_selected', {
        files: files.length,
        names: files.slice(0, 5).map((file) => file.name),
    });
    updatePackageFilesLabel(files);
    closeDocumentViewer();
    resetProcessPanels();
    activeCaseId = null;
    if (caseProgressTimer) {
        clearInterval(caseProgressTimer);
        caseProgressTimer = null;
    }
    clearProcessState();
    caseStatusLine.classList.remove('processing', 'error');
    renderProcessChecklist([]);
    caseProgressSteps = [];
    caseProgressIndex = -1;
    const counts = describeSelectedPackage(files);
    const parts = [];
    if (counts.xlsx) parts.push(`${counts.xlsx} XLSX`);
    if (counts.pdf) parts.push(`${counts.pdf} PDF`);
    if (counts.zip) parts.push(`${counts.zip} ZIP`);
    if (counts.image) parts.push(`${counts.image} imagen(es)`);
    if (counts.other) parts.push(`${counts.other} otro(s)`);
    caseStatusLine.textContent = files.length
        ? `Paquete listo: ${parts.join(' · ')}. Pulsa "Ejecutar proceso".`
        : defaultProcessStatusText();
    if (files.length) {
        persistProcessState({ activeCaseId: null, processing: false, error: false, statusText: caseStatusLine.textContent });
    } else {
        persistProcessState({ activeCaseId: null, processing: false, error: false, statusText: caseStatusLine.textContent });
    }
});
documentModalClose?.addEventListener('click', closeDocumentViewer);
documentModalBackdrop?.addEventListener('click', closeDocumentViewer);
documentModalBody?.addEventListener('click', async (event) => {
    const target = event.target.closest('[data-case][data-file]');
    if (!target) return;
    await openDocumentViewer(
        target.getAttribute('data-case') || '',
        target.getAttribute('data-file') || '',
        target.getAttribute('data-display') || ''
    );
});
viewSwitcher?.querySelectorAll('[data-view]').forEach((button) => {
    button.addEventListener('click', () => switchView(button.dataset.view));
});
modeSwitcher?.querySelectorAll('[data-mode]').forEach((button) => {
    button.addEventListener('click', () => applyUiMode(button.dataset.mode));
});
bindFlowActions();
testerSelect?.addEventListener('change', () => {
    const selected = testerRoster.find((item) => item.email === testerSelect.value) || { email: '', name: '' };
    persistTesterIdentity(selected);
    updateTesterStatus();
    if (selected.email) {
        logTesterActivity('tester_selected', { tester_email: selected.email });
    }
});
changeTesterButton?.addEventListener('click', () => {
    activeCaseId = null;
    activeCasePayload = null;
    clearProcessState();
    updateTesterStatus();
    openTesterLogin();
});
testerRoleGrid?.addEventListener('click', (event) => {
    const target = event.target.closest('[data-profile]');
    if (!target) return;
    activeCaseId = null;
    activeCasePayload = null;
    clearProcessState();
    persistActiveProfile(target.getAttribute('data-profile') || '');
    updateTesterStatus();
});
testerLoginGrid?.addEventListener('click', (event) => {
    const target = event.target.closest('[data-tester-email]');
    if (!target) return;
    if (!readActiveProfile()) {
        if (testerLoginNote) {
            testerLoginNote.textContent = 'Antes de elegir usuario, selecciona uno de los perfiles: Imagine o Colmena.';
        }
        return;
    }
    const selected = testerRoster.find((item) => item.email === target.getAttribute('data-tester-email')) || { email: '', name: '' };
    persistTesterIdentity(selected);
    updateTesterStatus();
    if (selected.email) {
        logTesterActivity('tester_selected', { tester_email: selected.email });
    }
    if (hasCompleteSession()) {
        closeTesterLogin();
        syncSessionLandingView();
    }
});
testerKeepSessionButton?.addEventListener('click', () => {
    if (!hasCompleteSession()) {
        openTesterLogin();
        return;
    }
    closeTesterLogin();
    syncSessionLandingView();
});
testerResetButton?.addEventListener('click', () => {
    activeCaseId = null;
    activeCasePayload = null;
    selectedColmenaCaseIds = new Set();
    clearProcessState();
    persistTesterIdentity({ email: '', name: '' });
    persistActiveProfile('');
    updateTesterStatus();
    openTesterLogin();
});
logoutButton?.addEventListener('click', () => {
    clearSessionIdentity();
});
clearColmenaSelectionButton?.addEventListener('click', () => {
    selectedColmenaCaseIds = new Set();
    loadProductionCases();
});
downloadColmenaBatchButton?.addEventListener('click', downloadColmenaBatch);
refreshTesterSummaryButton?.addEventListener('click', loadTesterSummary);
sendTesterSummaryButton?.addEventListener('click', sendTesterSummary);

fetch(`${API_URL}/health`)
    .then((res) => res.json())
    .then((data) => console.log('✅ Conectado:', data))
    .catch((err) => console.error('❌ Error:', err));

renderSources([]);
renderWorkflowDecision(null);
renderPrecheckReport(null);
renderExecutiveReport(null);
renderCaseSearch([]);
closeDocumentViewer();
caseStatusLine.classList.remove('processing', 'error');
hasBootstrappedProductionView = true;
setRecover926Expanded(false);
setFailedPrecheckExpanded(false);
loadTesterRoster();
loadSystemStatus();
updateTesterStatus();
loadUiMode();
switchView(getPreferredHomeView());

const bootProcessState = readProcessState();
activeCaseId = null;
activeCasePayload = null;
clearProcessState();
caseStatusLine.textContent = defaultProcessStatusText();
syncSessionLandingView();
updatePackageFilesLabel(getSelectedPackageFiles());
